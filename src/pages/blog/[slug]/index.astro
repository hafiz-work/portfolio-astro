---
import { Image } from "astro:assets";
export const prerender = false;
import PublicLayout from "../../../layouts/PublicLayout.astro";
import JsonLd from "../../../components/seo/JsonLd.astro";
import { getPublicPostBySlug } from "../../../lib/public-content";
import { sanitizeRichHtml } from "../../../lib/sanitize";
import type { BlogSection, BlogChecklist } from "../../../types/blog";

const slug = Astro.params.slug ?? "";
// Cache-friendly public loader: returns null on 404 or an unreachable API.
const post = slug ? await getPublicPostBySlug(slug) : null;
if (!post) {
  return Astro.redirect("/404");
}

const publishedISO = post.publishedDate ?? post.createdAt;
const dateLabel = new Date(publishedISO).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const metaDescription =
  post.excerpt ||
  "Insights on building reliable products, clean architecture, and shipping fast.";
// Per-post social card; undefined falls back to the CoreLayout default OG image.
const ogImage = post.coverImageUrl ?? undefined;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(`/blog/${post.slug}`, siteOrigin).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: metaDescription,
  datePublished: publishedISO,
  dateModified: post.updatedAt ?? publishedISO,
  author: { "@type": "Person", name: "Hafiz Bahtiar" },
  publisher: { "@type": "Person", name: "Hafiz Bahtiar" },
  mainEntityOfPage: canonical,
  keywords: (post.tags ?? []).join(", "),
};

const sections: BlogSection[] = post.sections ?? [];
const checklist: BlogChecklist[] = post.checklist ?? [];
const bodyHtml =
  sections.length === 0 && post.bodyContent
    ? sanitizeRichHtml(post.bodyContent)
    : "";
---

<!--
  Mirrors tailwindcss.com/blog/[post]: [22rem sidebar | 2.5rem divider | article].
  Row 1: date + title (right). Row 2: author (left), article (right).
-->
<PublicLayout
  title={`${post.title} - Hafiz Bahtiar`}
  description={metaDescription}
  image={ogImage}
  type="article"
  publishedTime={publishedISO ?? undefined}
>
  <JsonLd schema={articleSchema} />

  <div
    class="grid grid-cols-1 xl:grid-cols-[22rem_2.5rem_auto] xl:grid-rows-[1fr_auto]"
  >
    <div
      class="col-start-2 row-span-2 row-start-1 border-x border-gray-950/5 max-xl:hidden dark:border-white/10"
    >
    </div>

    <div
      class="max-xl:mx-auto max-xl:w-full max-xl:max-w-(--breakpoint-md) xl:col-start-3 xl:row-start-1"
    >
      <div
        class="mt-16 px-4 font-mono text-sm/7 font-medium tracking-widest text-gray-500 uppercase lg:px-2"
      >
        <time datetime={publishedISO}>{dateLabel}</time>
      </div>
      <div class="line-y mb-6 px-4 lg:px-2 xl:mb-16">
        <h1
          class="inline-block max-w-(--breakpoint-md) text-[2.5rem]/10 tracking-tight text-pretty text-gray-950 max-lg:font-medium lg:text-6xl dark:text-gray-200"
        >
          {post.title}
        </h1>
      </div>
    </div>

    <div
      class="max-xl:mx-auto max-xl:w-full max-xl:max-w-(--breakpoint-md) xl:col-start-1 xl:row-start-2"
    >
      <div class="flex flex-col gap-4">
        <!-- At xl the hairlines run leftward only, so they stop at the divider. -->
        <div
          class="relative flex items-center px-4 py-2 font-medium whitespace-nowrap before:absolute before:top-0 before:right-0 before:h-px before:w-[200vw] before:bg-gray-950/5 after:absolute after:right-0 after:bottom-0 after:h-px after:w-[200vw] after:bg-gray-950/5 max-xl:before:left-[-100vw]! max-xl:after:left-[-100vw]! xl:px-2 xl:before:hidden dark:before:bg-white/10 dark:after:bg-white/10"
        >
          <div class="flex gap-4">
            <span
              class="flex size-12 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-sky-400 to-sky-600 text-base font-semibold text-white"
              aria-hidden="true">HB</span
            >
            <div
              class="flex flex-col justify-center gap-1 text-sm font-semibold"
            >
              <div class="text-gray-950 dark:text-white">Hafiz Bahtiar</div>
              <div>
                <a
                  href="https://github.com/hafizbahtiar"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sky-500 hover:text-sky-600 dark:text-sky-400"
                  >@hafizbahtiar</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="max-xl:mx-auto max-xl:mt-16 max-xl:w-full max-xl:max-w-(--breakpoint-md) xl:col-start-3 xl:row-start-2"
    >
      <div class="line-y px-4 py-2 lg:px-2">
        <article class="prose-blog max-w-(--breakpoint-md)">
          {
            post.coverImageUrl && (
              <div class="relative overflow-hidden rounded-xl">
                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-gray-950/10 ring-inset dark:ring-white/10" />
                <Image
                  src={post.coverImageUrl}
                  alt={post.title}
                  width={1536}
                  height={864}
                  loading="eager"
                  decoding="async"
                  class="m-0! block aspect-video w-full max-w-full! bg-white object-cover"
                />
              </div>
            )
          }
          {post.heroText && <p>{post.heroText}</p>}
          {bodyHtml && <Fragment set:html={bodyHtml} />}
          {
            sections.map((section, index) => (
              <>
                <h2 id={`section-${index + 1}`}>{section.heading}</h2>
                <p class="whitespace-pre-line">{section.body}</p>
              </>
            ))
          }
          {
            checklist.length > 0 && (
              <>
                <h2 id="checklist">Checklist</h2>
                <ul>
                  {checklist.map((item) => (
                    <li>{item.itemText}</li>
                  ))}
                </ul>
              </>
            )
          }
        </article>
      </div>
    </div>
  </div>
  <!-- Outside the grid, so the divider column ends on the article's hairline. -->
  <div class="h-24 sm:h-46"></div>
</PublicLayout>
