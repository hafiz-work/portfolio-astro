---
export const prerender = false;
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import SectionHeader from "../../components/layout/SectionHeader.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { getPublicPosts } from "../../lib/public-content";

// Cache-friendly public loader: never throws, degrades to the same tasteful
// zero-state as an empty blog.
const posts = await getPublicPosts();

const description = posts.length
  ? `${posts.length} notes on backend systems, Flutter, and what it actually takes to ship production software.`
  : "Notes on backend systems, Flutter, and what it actually takes to ship production software.";
---

<ProjectLayout
  title="Blog | Hafiz Bahtiar"
  description="Notes on backend systems, Flutter, and shipping production software."
>
  <div class="h-16 sm:h-24"></div>
  <SectionHeader
    as="h1"
    eyebrow="Field notes"
    title="Blog"
    description={description}
  />
  <div class="h-12"></div>

  {
    posts.length > 0 ? (
      <div class="line-y grid grid-flow-dense grid-cols-1 gap-2 p-2 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <div
            class:list={["frame", index === 0 && "sm:col-span-2"]}
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 70}ms`}
          >
            <BlogCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <div class="line-y p-2">
        <div class="pattern flex h-72 flex-col items-center justify-center gap-3 text-center">
          <p class="eyebrow">Writing in progress</p>
          <p class="rounded-full bg-canvas px-4 py-1.5 text-base/7 font-medium text-gray-950 ring-1 ring-gray-950/10 dark:bg-pub-dark dark:text-white dark:ring-white/10">
            First posts are on the way
          </p>
          <p class="max-w-md px-4 text-sm/6 text-gray-500">
            I'm writing about backend architecture, Flutter, and Cloudflare
            Workers. Meanwhile, the projects say plenty.
          </p>
          <a href="/projects" class="btn-pill btn-pill-primary mt-2">
            View projects
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    )
  }
</ProjectLayout>
