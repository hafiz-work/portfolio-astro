---
import Disclaimer from "../components/ui/Disclaimer.astro";
import BackLink from "../components/ui/BackLink.astro";
export const prerender = false;
import TechHeading from "../components/layout/TechHeading.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { dayLabel, getDonations } from "../lib/derma-darah";
import { linePath, priceAxis } from "../lib/harga-minyak";

const data = await getDonations();
const CATALOGUE = "https://data.gov.my/data-catalogue/blood_donations";
const PDN_STATES = "https://pdn.gov.my/v2/index.php/hubungi-kami/pusat-kutipan-darah-seluruh-negeri";

const num = (n: number) => n.toLocaleString("ms-MY");
const share = (n: number) => (data?.total ? Math.round((n / data.total) * 100) : 0);

// 30-day trend: server-rendered SVG like /inflasi. priceAxis picks ticks for small
// numbers, so the axis runs in thousands of donations.
const trend = data?.trend ?? [];
const W = 400,
  H = 200,
  L = 44,
  R = 8,
  T = 8,
  B = 24; // viewBox + plot margins
const axis = trend.length ? priceAxis(trend.map((t) => t.donations / 1000)) : null;
const px = (i: number) =>
  L + (trend.length > 1 ? (i * (W - L - R)) / (trend.length - 1) : (W - L - R) / 2);
const py = (v: number) => (axis ? T + ((axis.max - v / 1000) * (H - T - B)) / (axis.max - axis.min) : 0);
const points = trend.map((t, i) => [px(i), py(t.donations)] as [number, number]);
const chartDesc = trend.length
  ? `Jumlah derma darah harian dari ${dayLabel(trend[0].date)} (${num(trend[0].donations)}) ke ${dayLabel(trend.at(-1)!.date)} (${num(trend.at(-1)!.donations)}).`
  : "";
---

<PublicLayout
  title="Derma Darah Malaysia Harian | Hafiz Bahtiar"
  description="Jumlah derma darah di Malaysia setiap hari - mengikut jenis darah A, B, AB dan O, dengan trend 30 hari. Data rasmi KKM / Pusat Darah Negara melalui data.gov.my."
>
  <div class="relative mx-auto mt-8 max-lg:max-w-2xl sm:mt-24">
    <BackLink />
    <div class="line-y">
      <h1 class="mx-2 text-4xl tracking-tighter text-balance sm:text-7xl lg:text-8xl">
        <TechHeading text="Derma Darah" fontSize={96} fontWeight={400} box="-my-12 h-48" />
      </h1>
    </div>
    <div class="line-y mt-10">
      <p class="mx-2 text-lg">
        Bilangan derma darah di seluruh Malaysia sehari, mengikut jenis darah, daripada
        Kementerian Kesihatan Malaysia.
      </p>
    </div>

    {
      data ? (
        <>
          <div class="line-y mt-4">
            <p class="mx-2 font-mono text-sm/6 tracking-widest text-gray-500 uppercase">
              Data bagi {dayLabel(data.date)}
            </p>
          </div>

          <div class="line-y mt-10">
            <dl class="grid grid-cols-2 gap-px bg-gray-950/5 sm:grid-cols-5 dark:bg-white/10">
              <div class="col-span-2 bg-white px-4 py-6 sm:col-span-1 sm:px-6 dark:bg-gray-950">
                <dt class="font-mono text-xs/5 tracking-widest text-gray-500 uppercase">Jumlah</dt>
                <dd class="mt-2 text-4xl font-medium tracking-tighter tabular-nums sm:text-5xl">
                  {num(data.total)}
                </dd>
              </div>
              {data.types.map((t) => (
                <div class="bg-white px-4 py-6 sm:px-6 dark:bg-gray-950">
                  <dt class="font-mono text-xs/5 tracking-widest text-gray-500 uppercase">
                    Jenis {t.label}
                  </dt>
                  <dd class="mt-2 text-3xl font-medium tracking-tighter tabular-nums">
                    {num(t.donations)}
                  </dd>
                  <dd class="mt-3">
                    <div class="h-1.5 rounded-full bg-gray-950/5 dark:bg-white/10" aria-hidden="true">
                      <div
                        class="h-full rounded-full bg-sky-600 dark:bg-sky-400"
                        style={`width: ${share(t.donations)}%`}
                      />
                    </div>
                    <span class="mt-1 block text-xs/5 text-gray-500 tabular-nums dark:text-gray-400">
                      {share(t.donations)}% daripada jumlah
                    </span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>

          {axis && trend.length > 1 && (
            <>
              <div class="line-y mt-10">
                <p class="eyebrow mx-2">Trend {trend.length} hari (jumlah derma)</p>
              </div>
              <div class="line-y mt-4">
                <div class="mx-2">
                  <svg
                    viewBox={`0 0 ${W} ${H}`}
                    class="h-auto w-full max-w-2xl text-gray-500 dark:text-gray-400"
                    role="img"
                    aria-labelledby="darah-chart-title darah-chart-desc"
                  >
                    <title id="darah-chart-title">Jumlah derma darah harian, {trend.length} hari</title>
                    <desc id="darah-chart-desc">{chartDesc}</desc>
                    {axis.ticks.map((t) => (
                      <g>
                        <line
                          x1={L}
                          x2={W - R}
                          y1={py(t * 1000)}
                          y2={py(t * 1000)}
                          class="stroke-gray-950/5 dark:stroke-white/10"
                        />
                        <text
                          x={L - 6}
                          y={py(t * 1000)}
                          dy="0.32em"
                          text-anchor="end"
                          font-size="12"
                          fill="currentColor"
                          class="tabular-nums"
                        >
                          {num(Math.round(t * 1000))}
                        </text>
                      </g>
                    ))}
                    {trend.map((t, i) =>
                      (trend.length - 1 - i) % 7 === 0 ? (
                        <text
                          x={px(i)}
                          y={H - 6}
                          text-anchor={i === 0 ? "start" : i === trend.length - 1 ? "end" : "middle"}
                          font-size="12"
                          fill="currentColor"
                        >
                          {dayLabel(t.date, true)}
                        </text>
                      ) : null,
                    )}
                    <path
                      d={linePath(points)}
                      fill="none"
                      stroke="#0284c7"
                      stroke-width="2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    />
                    {points.map((p, i) => (
                      <circle
                        cx={p[0]}
                        cy={p[1]}
                        r={i === points.length - 1 ? 3.5 : 6}
                        fill={i === points.length - 1 ? "#0284c7" : "transparent"}
                      >
                        <title>{`${dayLabel(trend[i].date)}: ${num(trend[i].donations)}`}</title>
                      </circle>
                    ))}
                  </svg>
                </div>
              </div>
            </>
          )}

          <div class="line-y mt-4">
            <p class="mx-2 text-xs/5 text-gray-500 dark:text-gray-400">
              Data dikemas kini setiap hari oleh Pusat Darah Negara (PDN) dan KKM. Sumber:{" "}
              <a
                href={CATALOGUE}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-sky-600 hover:underline dark:text-sky-400"
              >
                {data.source}
              </a>
              {data.stale && " (data simpanan - sumber tak dapat dicapai sekarang)"}.
            </p>
          </div>
        </>
      ) : (
        <div class="line-y mt-10">
          <p class="mx-2 text-sm/7 text-gray-600 dark:text-gray-400">
            Data derma darah tak dapat diambil dari data.gov.my sekarang. Cuba lagi sebentar, atau
            semak terus di{" "}
            <a
              href={CATALOGUE}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-sky-600 hover:underline dark:text-sky-400"
            >
              data.gov.my
            </a>
            .
          </p>
        </div>
      )
    }

    <div class="line-y mt-10">
      <p class="mx-2 text-sm/7 text-gray-600 dark:text-gray-400">
        Mahu menderma? Senarai tabung darah di setiap negeri ada di laman rasmi{" "}
        <a
          href={PDN_STATES}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-sky-600 hover:underline dark:text-sky-400"
        >
          Pusat Darah Negara
        </a>
        .
      </p>
    </div>

    <div class="line-y mt-6">
      <Disclaimer class="mx-2" sources={[{ name: "KKM / PDN (data.gov.my)", href: CATALOGUE }]}>
        Angka ini statistik, bukan nasihat perubatan. Kelayakan menderma darah ditentukan oleh
        Pusat Darah Negara dan tabung darah hospital.
      </Disclaimer>
    </div>
    <div class="mb-16 sm:mb-46"></div>
  </div>
</PublicLayout>
