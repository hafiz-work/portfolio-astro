---
export const prerender = false;
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublicProfile } from "../../lib/public-content";
import { isPublicUsername } from "../../lib/username";

// A registered user's opt-in public profile (docs/specs/public-user-profile-spec.md §3.2).
// Unknown, private and malformed usernames all render the site 404.
const raw = Astro.params.username ?? "";
const username = raw.toLowerCase();
// Trust boundary: only a valid username reaches the API URL.
if (!isPublicUsername(username)) return Astro.rewrite("/404");
// One URL per profile (canonical is the path).
if (raw !== username) return Astro.redirect(`/u/${username}`, 301);

const profile = await getPublicProfile(username);
if (!profile) return Astro.rewrite("/404");

const { displayName, bio, location, links, memberSince, posts, quotes } = profile;
const initial = displayName.trim().charAt(0).toUpperCase() || username.charAt(0).toUpperCase();
const formatDate = (value: string, opts: Intl.DateTimeFormatOptions) => {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : date.toLocaleDateString("en-US", opts);
};
const since = memberSince ? formatDate(`${memberSince}-01T00:00:00Z`, { month: "long", year: "numeric", timeZone: "UTC" }) : null;
const description = bio ? bio.slice(0, 160) : `${displayName}'s posts and quotes on hafizbahtiar.com.`;
---

<PublicLayout title={`${displayName} (@${username}) | Hafiz Bahtiar`} description={description}>
  <div class="relative mx-auto mt-8 max-lg:max-w-2xl sm:mt-24">
    <div class="line-y">
      <div class="mx-2 flex flex-wrap items-center gap-x-6 gap-y-4 py-2">
        <span
          class="flex size-16 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-sky-400 to-sky-600 text-2xl font-semibold text-white sm:size-20 sm:text-3xl"
          aria-hidden="true"
        >
          {initial}
        </span>
        <div class="min-w-0">
          <h1 class="text-4xl tracking-tighter text-balance wrap-break-word text-gray-950 sm:text-6xl dark:text-white">
            {displayName}
          </h1>
          <p class="mt-1 font-mono text-sm/6 text-gray-500 dark:text-gray-400">@{username}</p>
        </div>
      </div>
    </div>

    {
      (bio || location || since) && (
        <div class="line-y mt-10">
          <div class="mx-2 grid gap-2">
            {bio && <p class="max-w-2xl text-lg whitespace-pre-line text-gray-700 dark:text-gray-300">{bio}</p>}
            {(location || since) && (
              <p class="font-mono text-xs/6 tracking-widest text-gray-500 uppercase dark:text-gray-400">
                {[location, since && `Member since ${since}`].filter(Boolean).join(" · ")}
              </p>
            )}
          </div>
        </div>
      )
    }

    {
      links.length > 0 && (
        <div class="line-y mt-6">
          <ul class="mx-2 flex flex-wrap gap-2 py-1">
            {links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer ugc nofollow" class="btn-pill btn-pill-ghost">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <section class="mt-16" aria-labelledby="posts-heading">
      <div class="line-y">
        <h2 id="posts-heading" class="mx-2 font-mono text-sm/7 font-medium tracking-widest text-gray-500 uppercase">
          Posts
        </h2>
      </div>
      {
        posts.length > 0 ? (
          <ul class="mt-4 divide-y divide-gray-950/5 border-y border-gray-950/5 dark:divide-white/10 dark:border-white/10">
            {posts.map((post) => {
              const date = post.publishedAt && formatDate(post.publishedAt, { month: "long", day: "numeric", year: "numeric" });
              return (
                <li class="px-2 py-6">
                  <div class="max-w-2xl">
                    {date && (
                      <time datetime={post.publishedAt} class="mb-2 block font-mono text-xs/6 tracking-widest text-gray-500 uppercase">
                        {date}
                      </time>
                    )}
                    <a href={`/blog/${encodeURIComponent(post.slug)}`} class="font-semibold text-gray-950 hover:text-sky-600 dark:text-white dark:hover:text-sky-400">
                      {post.title}
                    </a>
                    {post.excerpt && <p class="mt-2 line-clamp-3 text-sm/7 text-gray-600 dark:text-gray-400">{post.excerpt}</p>}
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="line-y mt-4">
            <p class="mx-2 text-sm/7 text-gray-600 dark:text-gray-400">No posts yet.</p>
          </div>
        )
      }
    </section>

    <section class="mt-16 mb-16 sm:mb-46" aria-labelledby="quotes-heading">
      <div class="line-y">
        <h2 id="quotes-heading" class="mx-2 font-mono text-sm/7 font-medium tracking-widest text-gray-500 uppercase">
          Quotes
        </h2>
      </div>
      {
        quotes.length > 0 ? (
          <ul class="mt-4 divide-y divide-gray-950/5 border-y border-gray-950/5 dark:divide-white/10 dark:border-white/10">
            {quotes.map((quote) => (
              <li class="px-2 py-6">
                <figure class="max-w-2xl">
                  <blockquote class="text-base/7 text-pretty text-gray-950 dark:text-white">“{quote.text}”</blockquote>
                  <figcaption class="mt-3 text-sm/6 text-gray-600 dark:text-gray-400">
                    {quote.author && <span class="font-medium">{quote.author}</span>}
                    {quote.source && <cite class="not-italic">{quote.author ? " · " : ""}{quote.source}</cite>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        ) : (
          <div class="line-y mt-4">
            <p class="mx-2 text-sm/7 text-gray-600 dark:text-gray-400">No quotes yet.</p>
          </div>
        )
      }
    </section>
  </div>
</PublicLayout>
