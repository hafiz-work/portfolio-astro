---
export const prerender = false;
import PublicLayout from "../../layouts/PublicLayout.astro";
import Annot from "../../components/layout/Annot.astro";
import { FamilyExplorer } from "../../components/family/FamilyExplorer";
import { COMBINED_FAMILY } from "../../data/family";
import { getPublicFamilyTreeBySlug, getPublicFamilyTrees } from "../../lib/family";
import { mergeFamilyTrees } from "../../lib/family-merge";
import {
  sanitizeFamilyDetailForPublic,
  type PublicFamilyTreeDetail,
} from "../../lib/family-privacy";
import type { FamilyTree, FamilyTreeDetail } from "../../types/family";

let trees: FamilyTree[] = [];
let detail: PublicFamilyTreeDetail | null = null;
let loadError = false;

try {
  trees = await getPublicFamilyTrees();
  const details = (
    await Promise.all(trees.map((tree) => getPublicFamilyTreeBySlug(tree.slug)))
  ).filter((treeDetail): treeDetail is FamilyTreeDetail => treeDetail !== null);
  if (details.length > 0) {
    detail = sanitizeFamilyDetailForPublic(
      mergeFamilyTrees(details, COMBINED_FAMILY),
    );
  }
} catch (error) {
  console.error("Failed to load family data:", error);
  loadError = true;
}
---

<PublicLayout title="Family">
  <section>
    <div class="h-16 sm:h-24"></div>
    <div class="line-y">
      <p class="eyebrow container-main">Family</p>
    </div>
    <div class="line-y mt-2">
      <h1 class="container-main text-4xl/[1.1] font-medium tracking-tighter text-balance text-gray-950 sm:text-6xl/[1.05] dark:text-white">
        {COMBINED_FAMILY.name}
      </h1>
    </div>
    <Annot preset="lead" class="mt-4" />
    <div class="line-y">
      <p class="lead container-main">{COMBINED_FAMILY.description}</p>
    </div>
    {
      trees.length > 0 && (
        <>
          <div class="h-8" />
          <nav aria-label="Individual family trees" class="line-y">
            <div class="container-main flex flex-wrap gap-2">
              {trees.map((tree) => (
                <a href={`/family/${tree.slug}`} class="btn-pill btn-pill-ghost">
                  {tree.name}
                </a>
              ))}
            </div>
          </nav>
        </>
      )
    }

    <div class="h-12 sm:h-16"></div>
    <div class="line-y p-2">
      {
        loadError && (
          <div
            role="alert"
            class="rounded-xl bg-red-500/10 p-4 text-sm/6 text-red-700 ring-1 ring-red-500/20 ring-inset dark:text-red-400"
          >
            Failed to load family data. Please refresh to try again.
          </div>
        )
      }

      {
        !loadError && !detail && (
          <div class="pattern flex h-[420px] items-center justify-center rounded-xl text-sm text-gray-500">
            Family data is not available yet.
          </div>
        )
      }

      {
        detail && (
          <FamilyExplorer
            client:load
            detail={detail}
            ancestryDepth={6}
            progenyDepth={5}
          />
        )
      }
    </div>
  </section>
</PublicLayout>
