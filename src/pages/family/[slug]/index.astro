---
export const prerender = false;
import PublicLayout from "../../../layouts/PublicLayout.astro";
import Annot from "../../../components/layout/Annot.astro";
import { FamilyExplorer } from "../../../components/family/FamilyExplorer";
import { getPublicFamilyTreeBySlug } from "../../../lib/family";
import {
  sanitizeFamilyDetailForPublic,
  type PublicFamilyTreeDetail,
} from "../../../lib/family-privacy";

const slug = Astro.params.slug ?? "";
let detail: PublicFamilyTreeDetail | null = null;
let loadError = false;

try {
  const loadedDetail = await getPublicFamilyTreeBySlug(slug);
  detail = loadedDetail ? sanitizeFamilyDetailForPublic(loadedDetail) : null;
} catch (error) {
  console.error(`Failed to load family tree "${slug}":`, error);
  loadError = true;
}

if (!detail && !loadError) {
  Astro.response.status = 404;
}
---

<PublicLayout title={detail ? detail.tree.name : "Family"}>
  <section>
    <div class="h-10 sm:h-16"></div>
    <div class="line-y">
      <div class="container-main">
        <a
          href="/family"
          class="group inline-flex items-center gap-1.5 font-mono text-xs/6 text-gray-500 transition-colors hover:text-gray-950 dark:hover:text-white"
        >
          <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">&larr;</span>
          All families
        </a>
      </div>
    </div>
    <div class="h-8 sm:h-12"></div>
    <div class="line-y">
      <p class="eyebrow container-main">Family tree</p>
    </div>
    <div class="line-y mt-2">
      <h1 class="container-main text-4xl/[1.1] font-medium tracking-tighter text-balance text-gray-950 sm:text-6xl/[1.05] dark:text-white">
        {detail ? detail.tree.name : "Family tree not found"}
      </h1>
    </div>
    {
      detail?.tree.description && (
        <>
          <Annot preset="lead" class="mt-4" />
          <div class="line-y">
            <p class="lead container-main">{detail.tree.description}</p>
          </div>
        </>
      )
    }

    <div class="h-12 sm:h-16"></div>
    <div class="line-y p-2">
      {
        loadError && (
          <div
            role="alert"
            class="rounded-xl bg-red-500/10 p-4 text-sm/6 text-red-700 ring-1 ring-red-500/20 ring-inset dark:text-red-400"
          >
            Failed to load this family tree. Please refresh to try again.
          </div>
        )
      }

      {
        !loadError && !detail && (
          <div class="pattern flex h-[320px] flex-col items-center justify-center gap-3 rounded-xl text-sm text-gray-500">
            <p>There is no family tree at this address.</p>
            <a href="/family" class="btn-pill btn-pill-ghost">Browse all families</a>
          </div>
        )
      }

      {detail && <FamilyExplorer client:load detail={detail} />}
    </div>
  </section>
</PublicLayout>
