---
export const prerender = false;
import CoreLayout from "../../layouts/CoreLayout.astro";
import {
  formatHijri,
  getPrayerTimes,
  hhmm,
  resolveZone,
} from "../../lib/waktu-solat";
import { todayMY } from "../../lib/date-my";

// Widget for other sites: <iframe src="https://hafizbahtiar.com/waktu-solat/embed?zone=WLY01">.
// The only route the middleware lets other origins frame (EMBEDDABLE). Compact,
// no site chrome; links back to the full page in a new tab.
const q = Astro.url.searchParams;
const zone = resolveZone(q.get("zone"));
const tema = ["gelap", "terang"].includes(q.get("tema") ?? "")
  ? q.get("tema")!
  : "auto";
const times = await getPrayerTimes(zone.code);
const today = todayMY();
const day = times?.today;

const dateLabel = new Intl.DateTimeFormat("ms-MY", {
  timeZone: "Asia/Kuala_Lumpur",
  weekday: "long",
  day: "numeric",
  month: "long",
}).format(new Date());

const rows = day
  ? [
      { label: "Subuh", time: day.fajr, azan: true },
      { label: "Syuruk", time: day.syuruk, azan: false },
      { label: "Zohor", time: day.dhuhr, azan: true },
      { label: "Asar", time: day.asr, azan: true },
      { label: "Maghrib", time: day.maghrib, azan: true },
      { label: "Isyak", time: day.isha, azan: true },
    ]
  : [];
---

<CoreLayout
  title={`Waktu Solat ${zone.code} | hafizbahtiar.com`}
  description={`Waktu solat hari ini untuk ${zone.daerah}, ${zone.negeri}.`}
  noindex
  class="font-inter"
>
  <!-- tema=gelap|terang overrides the visitor's system theme (auto = follow it). -->
  <script is:inline define:vars={{ tema }}>
    if (tema === "gelap") document.documentElement.classList.add("dark");
    if (tema === "terang") document.documentElement.classList.remove("dark");
  </script>
  <main
    id="embed"
    data-today={today}
    data-server-now={Date.now()}
    class="min-h-dvh bg-white p-4 text-gray-950 dark:bg-gray-950 dark:text-white"
  >
    <p
      class="font-mono text-[11px]/5 tracking-widest text-sky-600 uppercase dark:text-sky-400"
    >
      Waktu Solat · {zone.code}
    </p>
    <p class="line-clamp-2 text-sm/6 font-medium" title={zone.daerah}>
      {zone.daerah}
    </p>
    <p class="text-xs/5 text-gray-500 dark:text-gray-400">
      {dateLabel}{day && ` · ${formatHijri(day.hijri)}`}
    </p>

    {
      rows.length ? (
        <dl class="mt-3 divide-y divide-gray-950/5 dark:divide-white/10">
          {rows.map((r) => (
            <div
              data-time={hhmm(r.time)}
              data-azan={r.azan ? "" : undefined}
              class="-mx-2 flex items-center justify-between rounded-md px-2 py-1.5 data-next:bg-sky-500/10"
            >
              <dt
                class:list={[
                  "text-sm/6",
                  !r.azan && "text-gray-500 dark:text-gray-400",
                ]}
              >
                {r.label}
              </dt>
              <dd
                class:list={[
                  "text-sm/6 font-medium tabular-nums",
                  !r.azan && "text-gray-500 dark:text-gray-400",
                ]}
              >
                {hhmm(r.time)}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-3 text-sm/6 text-gray-600 dark:text-gray-400">
          Waktu solat tak dapat diambil sekarang.
        </p>
      )
    }

    <a
      href={`https://hafizbahtiar.com/waktu-solat?zone=${zone.code}`}
      target="_blank"
      rel="noopener"
      class="mt-3 block text-[11px]/5 text-gray-500 hover:text-sky-600 dark:text-gray-400 dark:hover:text-sky-400"
    >
      Sumber: {times?.source ?? "e-solat JAKIM"} · hafizbahtiar.com/waktu-solat ↗
    </a>
    <!-- Widgets travel to other sites: the disclaimer goes with them (/penafian §7). -->
    <p class="text-[11px]/5 text-gray-500 dark:text-gray-400">
      Bukan rasmi; dipaparkan seadanya tanpa jaminan.
      <a
        href="https://hafizbahtiar.com/penafian"
        target="_blank"
        rel="noopener"
        class="underline underline-offset-2 hover:text-sky-600 dark:hover:text-sky-400"
        >Penafian</a
      >
    </p>
  </main>
</CoreLayout>

<script>
  import { todayMY } from "../../lib/date-my";

  // Highlight the next azan (Malaysian time) and reload after Malaysian midnight.
  // Server time, not the visitor's clock: a wrong device date must not reload-loop.
  const box0 = document.getElementById("embed");
  const offset = Number(box0?.dataset.serverNow) - Date.now() || 0;
  const nowServer = () => new Date(Date.now() + offset);
  const fmt = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Kuala_Lumpur",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  });
  const update = () => {
    const box = document.getElementById("embed");
    if (!box) return;
    if (todayMY(nowServer()) !== box.dataset.today) return location.reload();
    const now = fmt.format(nowServer());
    const cells = [...box.querySelectorAll<HTMLElement>("[data-azan]")];
    const next = cells.find((c) => (c.dataset.time ?? "") > now);
    cells.forEach((c) => c.toggleAttribute("data-next", c === next));
  };
  update();
  setInterval(update, 60_000);
</script>
