---
import { Image } from "astro:assets";
// Landing page untuk link email verification MARC (app kelab, backend Go
// berasingan). Server-side (bukan client fetch) - elak kena ubah CSP
// connect-src (yang cuma whitelist api.hafizbahtiar.com sekarang).
//
// MARC_API_URL sengaja BUKAN prefix PUBLIC_ - cuma dibaca frontmatter
// (server-side), tak pernah masuk client bundle.
import CoreLayout from "../layouts/CoreLayout.astro";
import Background from "../components/layout/Background.astro";

const MARC_API_URL =
  import.meta.env.MARC_API_URL || "https://marc-go-staging.up.railway.app";

const token = Astro.url.searchParams.get("token");

let success = false;
let message = "Pautan tidak sah.";

if (token) {
  try {
    const res = await fetch(`${MARC_API_URL}/auth/verify-email/confirm`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token }),
    });

    if (res.ok) {
      success = true;
      message = "Email anda berjaya disahkan. Boleh kembali ke app MARC.";
    } else {
      const data = await res.json().catch(() => ({}) as { error?: string });
      message = data.error || "Token tidak sah atau sudah luput.";
    }
  } catch {
    message = "Gagal hubungi server. Sila cuba lagi sebentar.";
  }
}
---

<CoreLayout
  title={success ? "Email Disahkan | MARC" : "Pengesahan Email | MARC"}
  noindex
>
  <Background />
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm text-center">
      <a href="/" class="inline-flex" aria-label="Hafiz Bahtiar - home">
        <Image
          src="/brand/wordmark.svg"
          alt="hafizbahtiar"
          width={383}
          height={120}
          loading="eager"
          class="h-12 w-auto"
        />
      </a>

      <div class="frame mt-8">
        <div class="frame-inner p-6 sm:p-8">
          {
            success ? (
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-500/10">
                <svg
                  class="h-6 w-6 text-emerald-600 dark:text-emerald-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
            ) : (
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100 dark:bg-red-500/10">
                <svg
                  class="h-6 w-6 text-red-600 dark:text-red-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </div>
            )
          }

          <h1
            class="text-xl font-medium tracking-tight text-gray-950 dark:text-white"
          >
            {success ? "Email disahkan" : "Pengesahan gagal"}
          </h1>
          <p class="mt-2 text-sm/6 text-gray-600 dark:text-gray-400">
            {message}
          </p>

          <a
            href="/"
            class="btn-pill btn-pill-primary mt-6 w-full justify-center"
          >
            Kembali ke laman utama
          </a>
        </div>
      </div>
    </div>
  </div>
</CoreLayout>
