---
export const prerender = false;
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectCard from "../../components/project/ProjectCard.astro";
import SectionHeader from "../../components/layout/SectionHeader.astro";
import { getPublicProjects } from "../../lib/public-content";

const projects = await getPublicProjects();
---

<ProjectLayout
  title="Projects | Hafiz Bahtiar"
  description="Production systems built by Hafiz Bahtiar - marketplaces, government platforms, logistics tooling, and offline-first mobile apps."
>
  <div class="h-16 sm:h-24"></div>
  <SectionHeader
    as="h1"
    eyebrow="Selected work"
    title="Projects"
    description={`${projects.length} production systems - from marketplaces and government platforms to logistics tooling and offline-first mobile apps.`}
  />
  <div class="h-12"></div>

  <div
    class="line-y grid grid-flow-dense grid-cols-1 gap-2 p-2 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      projects.map((project, index) => (
        <div
          class:list={["frame", index === 0 && "sm:col-span-2"]}
          data-reveal
          style={`--reveal-delay: ${(index % 3) * 70}ms`}
        >
          <ProjectCard
            title={project.title}
            description={project.description}
            imageUrl={project.imageUrl}
            imageVariant={project.imageVariant}
            imageLoading={index < 3 ? "eager" : "lazy"}
            imageFetchPriority={index < 3 ? "high" : "auto"}
            tags={
              project.technologies?.length
                ? project.technologies
                : (project.tags ?? [])
            }
            link={`/projects/${project.slug}`}
            year={project.year}
            projectType={project.projectType}
            featured={index === 0 && project.featured}
          />
        </div>
      ))
    }
  </div>
</ProjectLayout>
