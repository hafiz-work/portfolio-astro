---
import AccountLayout from "../layouts/AccountLayout.astro";
import { LoginForm } from "../components/account/LoginForm";
// Public Turnstile site key; fallback keeps production working without build-time env.
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAFD-PSk_u7NHAF-5";
---

<AccountLayout
  title="Sign in"
  description="Sign in to your hafizbahtiar.com account."
  variant="auth"
  switchTo={{ href: "/register", label: "Create account" }}
>
  <LoginForm client:load siteKey={siteKey} />
</AccountLayout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer></script>
