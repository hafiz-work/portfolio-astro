---
import { Image } from "astro:assets";
import CoreLayout from "../layouts/CoreLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";

// Cloudflare Turnstile (invisible until a challenge is needed). This site key is
// public; keep it as a fallback so production login still works when build-time
// env is absent.
const DEFAULT_TURNSTILE_SITE_KEY = "0x4AAAAAAFD-PSk_u7NHAF-5";
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || DEFAULT_TURNSTILE_SITE_KEY;
---

<CoreLayout
  title="Sign in | Hafiz Bahtiar"
  description="Sign in to manage the portfolio - projects, posts, experiences and policies."
>
  <!-- Public shell without PublicLayout's navbar/footer: gutters + full-bleed
       hairlines + Inter, so /login reads as part of the site but stays focused. -->
  <div class="page-shell font-inter text-gray-950 dark:text-white">
    <div class="gutter gutter-left" aria-hidden="true"></div>
    <div class="page-col">
      <main class="flex-grow">
        <div class="line-b">
          <div class="container-main flex h-14 items-center">
            <a
              href="/"
              class="inline-flex items-center"
              aria-label="Hafiz Bahtiar - home"
            >
              <Image
                src="/brand/wordmark.svg"
                alt="hafizbahtiar"
                width={383}
                height={120}
                loading="eager"
                class="h-8 w-auto"
              />
            </a>
          </div>
        </div>

        <div class="section-gap"></div>

        <SectionHeader
          as="h1"
          eyebrow="Account"
          title="Welcome back."
          description="Sign in to manage projects, posts, experiences and policies."
        />

        <div class="h-10"></div>

        <!-- Form row: same full-bleed hairline rhythm as the contact form. -->
        <div class="line-y">
          <form
            class="container-main max-w-md space-y-5 py-10 sm:py-14"
            id="login-form"
            novalidate
            data-turnstile-site-key={turnstileSiteKey || undefined}
          >
      <!-- Status message: error by default, emerald when the script flips it. -->
      <div id="status-display" class="hidden" aria-live="polite">
        <div id="status-panel" role="alert" class="flex items-center gap-3">
          <div id="status-icon" class="shrink-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <span id="status-text">Invalid email or password.</span>
        </div>
      </div>

      <div>
        <label
          for="username"
          class="mb-1.5 block text-sm/6 font-medium text-gray-950 dark:text-white"
          >Email</label
        >
        <input
          type="email"
          id="username"
          name="username"
          autocomplete="username"
          inputmode="email"
          class="field"
          placeholder="you@example.com"
          required
        />
      </div>

      <div>
        <label
          for="password"
          class="mb-1.5 block text-sm/6 font-medium text-gray-950 dark:text-white"
          >Password</label
        >
        <div class="relative">
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            class="field pr-11"
            placeholder="••••••••"
            required
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full p-1.5 text-gray-400 transition-colors hover:text-gray-950 dark:text-gray-500 dark:hover:text-white"
            aria-label="Toggle password visibility"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" id="submit-btn" class="btn-pill btn-pill-primary w-full">
        Sign in
      </button>

      {
        turnstileSiteKey && (
          <div id="turnstile-login" class="flex justify-center"></div>
        )
      }

      {
        turnstileSiteKey && (
          <p class="text-xs/5 text-gray-500 dark:text-gray-400">
            Protected by Cloudflare Turnstile - the Cloudflare{" "}
            <a
              href="https://www.cloudflare.com/privacypolicy/"
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-gray-950 dark:hover:text-white"
            >
              Privacy Policy
            </a>{" "}
            applies.
          </p>
        )
      }
    </form>
  </div>

  <!-- Return row -->
  <div class="line-y">
    <div class="container-main flex flex-wrap items-center gap-x-4 gap-y-3 py-5">
      <a href="/" class="btn-pill btn-pill-ghost">
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to site
      </a>
      <span class="font-mono text-xs/6 text-gray-400 dark:text-gray-500"
        >/login</span
      >
    </div>
  </div>

        <div class="section-gap"></div>
      </main>
    </div>
    <div class="gutter gutter-right" aria-hidden="true"></div>
  </div>
</CoreLayout>

{
  // Turnstile: explicit rendering, so the page keeps the widget id and can
  // reset it between attempts (tokens are single-use).
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}

<script>
  import { authService } from "../lib/auth";

  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const statusDisplay = document.getElementById("status-display");
  const statusText = document.getElementById("status-text");
  const statusPanel = document.getElementById("status-panel");
  const statusIcon = document.getElementById("status-icon");
  const submitBtn = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement | null;
  const turnstileSiteKey = form?.dataset.turnstileSiteKey || "";

  let failedAttempts = 0;
  let lockUntil = 0;
  let submitting = false;

  // The widget renders explicitly because the page stays open after a failed
  // attempt and tokens are single-use - the id is kept so each attempt can
  // execute, then reset. It only becomes visible if Cloudflare asks for
  // interaction.
  let turnstileWidgetId: string | null = null;
  let pendingTurnstile: ((token: string) => void) | null = null;
  // The widget can finish before the visitor submits (interaction-only widgets
  // clear themselves in the background), so the token is kept, not just
  // delivered to a pending submit.
  let turnstileToken = "";

  // A challenge that never calls back must not leave the button spinning.
  const TURNSTILE_TIMEOUT_MS = 15_000;

  const settleTurnstile = (token: string) => {
    const resolve = pendingTurnstile;
    pendingTurnstile = null;
    resolve?.(token);
  };

  const renderTurnstile = () => {
    const container = document.getElementById("turnstile-login");
    const turnstile = (window as any).turnstile;
    if (!container || !turnstileSiteKey || turnstileWidgetId) return;
    if (!turnstile?.render) return;
    try {
      turnstileWidgetId = turnstile.render(container, {
        sitekey: turnstileSiteKey,
        action: "login",
        execution: "execute",
        appearance: "interaction-only",
        callback: (token: string) => {
          turnstileToken = token || "";
          settleTurnstile(turnstileToken);
        },
        "error-callback": () => settleTurnstile(""),
      });
    } catch {
      // A render that throws leaves no widget id, so the next attempt retries.
      turnstileWidgetId = null;
    }
  };

  // The loader is async and can land after this module runs, so poll briefly
  // rather than depend on a global onload callback.
  if (turnstileSiteKey) {
    if ((window as any).turnstile?.render) {
      renderTurnstile();
    } else {
      let tries = 0;
      const timer = setInterval(() => {
        if ((window as any).turnstile?.render) {
          clearInterval(timer);
          renderTurnstile();
        } else if (++tries > 100) {
          clearInterval(timer);
        }
      }, 100);
    }
  }

  // One token per attempt. Resolves to "" when the challenge cannot run, so the
  // caller can show a clean error.
  const executeTurnstile = (): Promise<string> =>
    new Promise((resolve) => {
      const turnstile = (window as any).turnstile;
      if (!turnstileSiteKey || !turnstileWidgetId || !turnstile?.execute) {
        resolve("");
        return;
      }

      // A token that arrived before this submit is still valid and single-use:
      // consume it instead of executing again (an execute on a finished widget
      // never calls back).
      if (turnstileToken) {
        const token = turnstileToken;
        turnstileToken = "";
        resolve(token);
        return;
      }

      const existing = turnstile.getResponse?.(turnstileWidgetId);
      if (existing) {
        resolve(existing);
        return;
      }

      let settled = false;
      const finish = (token: string) => {
        if (settled) return;
        settled = true;
        clearTimeout(timer);
        resolve(token);
      };
      const timer = setTimeout(() => finish(""), TURNSTILE_TIMEOUT_MS);

      pendingTurnstile = finish;
      try {
        turnstile.execute(turnstileWidgetId);
      } catch {
        settleTurnstile("");
      }
    });

  const resetTurnstile = () => {
    pendingTurnstile = null;
    turnstileToken = "";
    const turnstile = (window as any).turnstile;
    if (turnstileWidgetId && turnstile?.reset) {
      turnstile.reset(turnstileWidgetId);
    }
  };

  // Toggle Password Visibility
  const togglePasswordBtn = document.getElementById("toggle-password");
  const passwordInput = document.getElementById("password") as HTMLInputElement;

  togglePasswordBtn?.addEventListener("click", () => {
    if (passwordInput) {
      const type =
        passwordInput.getAttribute("type") === "password" ? "text" : "password";
      passwordInput.setAttribute("type", type);

      const svg = togglePasswordBtn.querySelector("svg");
      if (svg) {
        if (type === "text") {
          svg.innerHTML = `
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
          `;
        } else {
          svg.innerHTML = `
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          `;
        }
      }
    }
  });

  // Redirect only when the API refresh cookie is still valid.
  if (authService.isAuthenticated()) {
    authService.tryRefresh().then((valid) => {
      if (valid) {
        window.location.href = "/admin";
      } else {
        authService.clearAuthState();
      }
    });
  }

  const showStatus = (
    message: string,
    type: "error" | "success",
    iconHtml: string,
  ) => {
    if (!statusDisplay || !statusText || !statusPanel || !statusIcon) return;
    statusText.textContent = message;
    if (type === "success") {
      statusPanel.classList.add("status-success");
    } else {
      statusPanel.classList.remove("status-success");
    }
    statusIcon.innerHTML = iconHtml;
    statusDisplay.classList.remove("hidden");
    void statusDisplay.offsetWidth;
  };

  const errorIcon = `
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
    </svg>`;

  const successIcon = `
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>`;

  const resetUI = () => {
    (form as HTMLFormElement)?.reset();
    submitting = false;
    if (submitBtn) {
      submitBtn.textContent = "Sign in";
      submitBtn.disabled = false;
    }
    if (statusDisplay) statusDisplay.classList.add("hidden");
  };

  resetUI();
  window.addEventListener("pageshow", resetUI);

  // Map backend/API errors to clean user-facing copy. Never surface raw
  // technical messages on the login screen.
  const friendlyError = (error: unknown): string => {
    const message = error instanceof Error ? error.message : "";
    const status = (error as { status?: number })?.status;
    if (message.toLowerCase().includes("captcha")) {
      return "Spam check failed. Please reload the page and try again.";
    }
    if (status === 401 || status === 400) return "Invalid email or password.";
    if (status === 429) return "Too many attempts. Please wait a minute.";
    return "Couldn't sign you in right now. Please try again.";
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (submitting) return;

    const formData = new FormData(e.target as HTMLFormElement);
    const email = (formData.get("username") as string)?.trim();
    const password = ((formData.get("password") as string) || "").trim();

    if (!email || !password) {
      showStatus("Please enter your email and password.", "error", errorIcon);
      return;
    }

    if (Date.now() < lockUntil) {
      const remaining = Math.ceil((lockUntil - Date.now()) / 1000);
      showStatus(
        `Too many attempts. Try again in ${remaining}s.`,
        "error",
        errorIcon,
      );
      return;
    }

    submitting = true;
    if (submitBtn) {
      submitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Signing in...
      `;
      submitBtn.disabled = true;
    }

    if (statusDisplay) statusDisplay.classList.add("hidden");

    try {
      let captchaToken = "";
      if (turnstileSiteKey) {
        captchaToken = await executeTurnstile();
        if (!captchaToken) {
          throw Object.assign(new Error("captcha"), { status: 0 });
        }
      }

      const result = await authService.login(
        email,
        password,
        captchaToken || undefined,
      );

      if (result) {
        failedAttempts = 0;
        if (submitBtn) {
          submitBtn.innerHTML = `
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Signed in
          `;
        }
        showStatus("Redirecting to dashboard...", "success", successIcon);
        setTimeout(() => {
          window.location.href = "/admin";
        }, 1000);
      } else {
        throw new Error("Invalid email or password.");
      }
    } catch (error: unknown) {
      failedAttempts++;
      if (failedAttempts >= 5) {
        lockUntil = Date.now() + 60_000;
        failedAttempts = 0;
      }

      submitting = false;
      if (submitBtn) {
        submitBtn.textContent = "Sign in";
        submitBtn.disabled = false;
      }

      showStatus(friendlyError(error), "error", errorIcon);
    } finally {
      resetTurnstile();
    }
  });
</script>

<style>
  .status-success {
    border-color: rgba(16, 185, 129, 0.3) !important;
    background: rgba(16, 185, 129, 0.08) !important;
    color: rgb(5, 150, 105) !important;
  }
  html.dark .status-success {
    color: rgb(167, 243, 208) !important;
  }
</style>
