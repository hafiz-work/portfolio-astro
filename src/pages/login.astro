---
import AccountLayout from "../layouts/AccountLayout.astro";
import { LoginForm } from "../components/account/LoginForm";
import { TURNSTILE_SITE_KEY as siteKey } from "../lib/constants";
---

<AccountLayout
  title="Sign in"
  description="Sign in to your hafizbahtiar.com account."
  variant="auth"
  switchTo={{ href: "/register", label: "Create account" }}
>
  <LoginForm client:load siteKey={siteKey} />
</AccountLayout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer></script>
