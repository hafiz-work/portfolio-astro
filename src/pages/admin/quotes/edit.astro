---
import { ArrowLeft } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import QuoteForm from "../../../components/admin/quotes/QuoteForm.astro";
import AlertToast from "../../../components/ui/AlertToast.astro";
---

<PrivateLayout title="Edit Quote">
  <div class="space-y-6">
    <AdminPageHeader
      title="Edit Quote"
      description="Edit a quote in the public collection"
    >
      <a
        slot="actions"
        href="/admin/quotes"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>

    <div id="loading-state" class="text-center py-12">
      <div
        class="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-gray-950/15 dark:border-white/15 mb-4"
      >
      </div>
      <p class="text-gray-500 dark:text-gray-400">Loading quote...</p>
    </div>

    <form id="quote-form" class="space-y-8 hidden">
      <QuoteForm submitLabel="Update quote" />
    </form>
  </div>
  <AlertToast id="quote-alert" />
</PrivateLayout>

<script>
  import { showToast, parseJsonArray } from "../../../lib/admin-ui";
  import { normalizeAuthor, normalizeQuote } from "../../../lib/quote-text";
  import { quotesService, categoryLabel } from "../../../lib/quotes";
  import { extractApiError } from "../../../lib/projects-cms";
  import { setupFormGuard } from "../../../lib/form-guard";

  // <ClientRouter> runs a page's bundled script once per session. Init on every visit.
  async function initPage() {
    if (location.pathname.replace(/\/+$/, "") !== "/admin/quotes/edit") return;
    const form = document.getElementById("quote-form") as HTMLFormElement;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;
    if (!form || !submitBtn) return;
    const id = Number(new URLSearchParams(window.location.search).get("id"));

    const showAlert = (options: Omit<Parameters<typeof showToast>[0], "id">) =>
      showToast({ ...options, id: "quote-alert" });

    const fieldLabels: Record<string, string> = {
      text: "Quote text",
      author: "Author",
      source: "Source",
      tagIds: "Tags",
    };

    // updateProjectOptions() technique from experiences: rebuild the MultiDropdown list client-side.
    const updateTagOptions = async () => {
      const list = document.querySelector(
        '.tech-multi-dropdown-container[data-name="tagIds"] ul',
      );
      const tpl = document.getElementById(
        "quote-tag-item",
      ) as HTMLTemplateElement | null;
      if (!list || !tpl) return;
      try {
        const tags = await quotesService.listQuoteTags();
        list.innerHTML = "";
        tags.forEach((tag) => {
          const li = tpl.content.firstElementChild!.cloneNode(
            true,
          ) as HTMLElement;
          li.querySelector("button")!.dataset.value = String(tag.id);
          li.querySelector("span")!.textContent =
            `${tag.name} · ${categoryLabel(tag.category)}`;
          list.appendChild(li);
        });
        document
          .getElementById("quote-tags-empty")
          ?.classList.toggle("hidden", tags.length > 0);
        (window as any).setupMultiDropdowns?.();
      } catch (error) {
        console.error(error);
      }
    };

    const setInputValue = (name: string, value: unknown) => {
      const element = form.elements.namedItem(name) as HTMLInputElement | null;
      if (element) {
        element.value = value == null ? "" : String(value);
        element.dispatchEvent(new Event("change"));
      }
    };

    const failLoad = (title: string, message: string) => {
      showAlert({ type: "error", title, message });
      window.setTimeout(() => {
        window.location.href = "/admin/quotes";
      }, 900);
    };

    let formGuard: ReturnType<typeof setupFormGuard>;
    try {
      if (!id) throw new Error("Invalid quote ID");
      // Tag options first, then the values, then the guard snapshot.
      await updateTagOptions();
      const quote = await quotesService.getAdminQuoteById(id);
      if (!quote) return failLoad("Not found", "Quote was not found.");
      setInputValue("text", quote.text);
      setInputValue("author", quote.author);
      setInputValue("source", quote.source);
      setInputValue(
        "tagIds",
        JSON.stringify((quote.tags ?? []).map((t) => t.id)),
      );
      document.getElementById("loading-state")?.classList.add("hidden");
      form.classList.remove("hidden");
      formGuard = setupFormGuard(form);
    } catch (error) {
      console.error(error);
      return failLoad("Load failed", "Failed to load quote data.");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const originalContent = submitBtn.innerHTML;
      submitBtn.innerHTML = "SAVING...";
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const source = String(formData.get("source") ?? "").trim();
      const data = {
        text: normalizeQuote(String(formData.get("text") ?? "")),
        author: normalizeAuthor(String(formData.get("author") ?? "")),
        source: source === "" ? null : source,
        tagIds: parseJsonArray(formData.get("tagIds") ?? "")
          .map(Number)
          .filter((n) => !Number.isNaN(n)),
      };

      try {
        const result = await quotesService.updateQuote(id, data);
        if (!result) throw new Error("Failed to update quote");
        formGuard.updateInitialState();
        showAlert({
          type: "success",
          title: "Quote updated",
          message: "Quote updated successfully.",
        });
        window.setTimeout(() => {
          window.location.href = "/admin/quotes";
        }, 800);
      } catch (error) {
        console.error(error);
        const { message, field } = extractApiError(error);
        if (field)
          (form.elements.namedItem(field) as HTMLElement | null)?.focus?.();
        showAlert({
          type: "error",
          title: "Save failed",
          message: field
            ? `${message} (Field: ${fieldLabels[field] || field})`
            : message,
        });
      } finally {
        submitBtn.innerHTML = originalContent;
        submitBtn.disabled = false;
      }
    });
  }
  document.addEventListener("astro:page-load", initPage);
</script>
