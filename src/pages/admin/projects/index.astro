---
import { Plus } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import AlertToast from "../../../components/ui/AlertToast.astro";
import { ProjectsCmsTable } from "../../../components/admin/projects/ProjectsCmsTable";
---

<PrivateLayout title="Manage Projects">
  <div class="space-y-6">
    <AdminPageHeader
      title="Projects"
      description="Manage portfolio projects, visibility, ordering, and status."
    >
      <a
        slot="actions"
        href="/admin/projects/new"
        class="admin-btn admin-btn-primary"
      >
        <Plus className="w-4 h-4" />
        New Project
      </a>
    </AdminPageHeader>

    <ProjectsCmsTable client:load />
  </div>
  <AlertToast id="admin-alert" />
</PrivateLayout>
