---
import { Save } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";

const settings = {
  siteName: "Hafiz Bahtiar",
  siteDescription: "Full Stack Developer Portfolio",
  contactEmail: "hafiz@example.com",
};
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
---

<PrivateLayout title="General Settings">
  <div class="space-y-6">
    <AdminPageHeader
      title="General Settings"
      description="General site configuration"
    >
      <div slot="actions">
        <button id="save-settings-btn" class="admin-btn admin-btn-primary">
          <Save className="w-4 h-4" />
          Save Changes
        </button>
      </div>
    </AdminPageHeader>

    <p
      class="max-w-2xl rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300"
    >
      Coming soon - these settings are not saved yet (no backend endpoint).
    </p>

    <div
      class="rounded-xl border border-gray-950/5 dark:border-white/10 bg-white dark:bg-white/[0.03] p-4 md:p-5 max-w-2xl"
    >
      <form id="general-settings-form" class="space-y-6">
        <div class="space-y-2">
          <label
            for="settings-site-name"
            class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
          >
            Site Name
          </label>
          <input
            type="text"
            id="settings-site-name"
            name="siteName"
            value={settings.siteName}
            class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
          />
        </div>
        <div class="space-y-2">
          <label
            for="settings-site-description"
            class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
          >
            Site Description
          </label>
          <textarea
            id="settings-site-description"
            name="siteDescription"
            rows="3"
            class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5 resize-none"
            >{settings.siteDescription}</textarea
          >
        </div>
      </form>
    </div>
  </div>
</PrivateLayout>

<script>
  // <ClientRouter> runs a page's bundled script once per session, so a
  // second visit got a dead page (no data, no handlers). Init on every visit.
  async function initPage() {
    if (location.pathname.replace(/\/+$/, "") !== "/admin/settings/general")
      return;
    const saveBtn = document.getElementById(
      "save-settings-btn",
    ) as HTMLButtonElement | null;

    // Save General Settings (Mock implementation for now as no backend endpoint exists)
    saveBtn?.addEventListener("click", () => {
      if (!saveBtn) return;
      const originalContent = saveBtn.innerHTML;
      saveBtn.innerHTML = "SAVING...";
      saveBtn.disabled = true;

      setTimeout(() => {
        alert("Settings saved locally (No backend endpoint yet)");
        saveBtn.innerHTML = originalContent;
        saveBtn.disabled = false;
      }, 1000);
    });
  }
  document.addEventListener("astro:page-load", initPage);
</script>
