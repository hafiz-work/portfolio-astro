---
import { Lock, Settings } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";

const securityOptions = [
  {
    title: "Change Password",
    description: "Update your account password.",
    href: "/admin/settings/security/password",
    icon: Lock,
  },
  {
    title: "Maintenance Mode",
    description: "Toggle maintenance mode to restrict public access.",
    href: "/admin/settings/security/maintenance",
    icon: Settings,
  },
];
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
---

<PrivateLayout title="Security Settings">
  <div class="space-y-6">
    <AdminPageHeader
      title="Security Settings"
      description="Security settings and access control"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
      {
        securityOptions.map((option) => (
          <a href={option.href} class="block group">
            <div class="rounded-xl border border-gray-950/5 dark:border-white/10 bg-white dark:bg-white/3 p-4 md:p-5 hover:border-gray-950/15 dark:hover:border-white/20 transition-all duration-300 h-full">
              <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-gray-950/3 dark:bg-white/10 rounded-lg text-gray-500 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-200 transition-colors">
                  <option.icon className="w-6 h-6" />
                </div>
                <h3 class="text-xl font-bold text-gray-950 dark:text-white group-hover:text-gray-700 dark:group-hover:text-gray-200 transition-colors">
                  {option.title}
                </h3>
              </div>
              <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
                {option.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</PrivateLayout>
