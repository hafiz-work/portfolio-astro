---
import { Camera, Github, Linkedin, Save } from "lucide-react";
import PrivateLayout from "../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import { Image } from "astro:assets";

const profile: any = {}; // populated client-side after page load
---

<PrivateLayout title="Admin Profile">
  <div class="space-y-6">
    <AdminPageHeader
      title="Profile"
      description="Manage your profile and account details"
    />

    <div class="flex flex-col md:flex-row gap-6 items-start">
      <!-- Profile Card -->
      <div class="w-full md:w-80 flex-shrink-0">
        <div
          class="rounded-xl border border-gray-950/5 dark:border-white/10 bg-white dark:bg-white/[0.03] p-4 md:p-5 flex flex-col items-center gap-6 sticky top-6"
        >
          <div class="relative w-32 h-32 group flex-shrink-0">
            <Image
              id="avatar-preview"
              src={profile?.avatarUrl || "/favicons/icon1.png"}
              alt="Profile"
              width={128}
              height={128}
              class="relative w-full h-full rounded-full border-2 border-gray-950/10 dark:border-white/10 object-cover"
            />
            <label
              for="avatar-upload"
              class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 group-hover:opacity-100 cursor-pointer rounded-full transition-all duration-300"
            >
              <div class="text-center">
                <Camera className="w-6 h-6 text-white mx-auto mb-1" />
                <span class="text-white text-[10px] font-semibold">Change</span>
              </div>
            </label>
            <input
              type="file"
              id="avatar-upload"
              accept="image/*"
              class="hidden"
            />
          </div>
          <div class="text-center w-full">
            <h2 class="text-xl font-bold text-gray-950 dark:text-white">
              {profile?.name || "Admin User"}
            </h2>
            <p class="text-sky-600 dark:text-sky-400 text-sm">
              {profile?.email || "admin@example.com"}
            </p>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">
              Member since {
                new Date(profile?.createdAt || Date.now()).toLocaleDateString()
              }
            </p>
          </div>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="flex-1 w-full">
        <div
          class="rounded-xl border border-gray-950/5 dark:border-white/10 bg-white dark:bg-white/[0.03] p-4 md:p-5"
        >
          <h3
            class="text-lg font-bold text-gray-950 dark:text-white mb-6 border-b border-gray-950/5 dark:border-white/10 pb-4"
          >
            Edit Details
          </h3>
          <form id="profile-form" class="space-y-6">
            <input type="hidden" name="id" value={profile?.id} />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
              <div class="space-y-2">
                <label
                  for="profile-full-name"
                  class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
                >
                  Full Name
                </label>
                <input
                  type="text"
                  id="profile-full-name"
                  name="name"
                  value={profile?.name}
                  class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="profile-email"
                  class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
                >
                  Email
                </label>
                <input
                  type="email"
                  id="profile-email"
                  name="email"
                  value={profile?.email}
                  class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="profile-location"
                  class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
                >
                  Location
                </label>
                <input
                  type="text"
                  id="profile-location"
                  name="location"
                  value={profile?.location}
                  placeholder="e.g. Kuala Lumpur, MY"
                  class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="profile-website"
                  class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
                >
                  Website
                </label>
                <input
                  type="url"
                  id="profile-website"
                  name="website"
                  value={profile?.website}
                  placeholder="https://"
                  class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="profile-avatar-url"
                  class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
                >
                  Avatar URL
                </label>
                <input
                  type="text"
                  id="profile-avatar-url"
                  name="avatarUrl"
                  value={profile?.avatarUrl}
                  placeholder="https://"
                  class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label
                for="profile-bio"
                class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
              >
                Bio
              </label>
              <textarea
                id="profile-bio"
                name="bio"
                rows="4"
                class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5 resize-none"
                >{profile?.bio}</textarea
              >
            </div>

            <fieldset class="space-y-2">
              <legend
                class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
              >
                Social Links
              </legend>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="relative">
                  <label for="profile-linkedin-url" class="sr-only">
                    LinkedIn URL
                  </label>
                  <span
                    class="absolute left-3 top-2.5 text-gray-500 dark:text-gray-400 pointer-events-none"
                  >
                    <Linkedin className="w-5 h-5" />
                  </span>
                  <input
                    type="url"
                    id="profile-linkedin-url"
                    name="linkedinUrl"
                    value={profile?.linkedinUrl}
                    placeholder="LinkedIn URL"
                    class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg pl-10 pr-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                  />
                </div>
                <div class="relative">
                  <label for="profile-github-url" class="sr-only">
                    GitHub URL
                  </label>
                  <span
                    class="absolute left-3 top-2.5 text-gray-500 dark:text-gray-400 pointer-events-none"
                  >
                    <Github className="w-5 h-5" />
                  </span>
                  <input
                    type="url"
                    id="profile-github-url"
                    name="githubUrl"
                    value={profile?.githubUrl}
                    placeholder="GitHub URL"
                    class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg pl-10 pr-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                  />
                </div>
                <div class="relative">
                  <label for="profile-twitter-url" class="sr-only">
                    X (Twitter) URL
                  </label>
                  <span
                    class="absolute left-3 top-2.5 text-gray-500 dark:text-gray-400 pointer-events-none"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                      ></path>
                    </svg>
                  </span>
                  <input
                    type="url"
                    id="profile-twitter-url"
                    name="twitterUrl"
                    value={profile?.twitterUrl}
                    placeholder="X (Twitter) URL"
                    class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg pl-10 pr-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
                  />
                </div>
              </div>
            </fieldset>

            <div class="admin-form-actions">
              <button
                type="submit"
                id="save-profile-btn-bottom"
                class="admin-btn admin-btn-primary"
              >
                <Save className="w-4 h-4" />
                Save changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Telegram: one bot, the linked chat id is what makes a chat "the owner" -->
    <div
      class="rounded-xl border border-gray-950/5 dark:border-white/10 bg-white dark:bg-white/[0.03] p-4 md:p-5"
    >
      <h3
        class="text-lg font-bold text-gray-950 dark:text-white mb-6 border-b border-gray-950/5 dark:border-white/10 pb-4"
      >
        Telegram
      </h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
        Message the bot once - it replies with your chat id - then paste the
        number here. The linked chat is treated as the owner.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:items-end">
        <div class="space-y-2 flex-1">
          <label
            for="telegram-chat-id"
            class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-widest"
          >
            Chat ID
          </label>
          <input
            type="text"
            id="telegram-chat-id"
            inputmode="numeric"
            autocomplete="off"
            placeholder="e.g. 123456789"
            class="w-full border border-gray-950/10 dark:border-white/10 rounded-lg px-4 py-2 text-gray-950 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none transition-all bg-white dark:bg-white/5"
          />
        </div>
        <div class="flex gap-2">
          <button type="button" id="telegram-link-btn" class="admin-btn admin-btn-primary">
            Link
          </button>
          <button
            type="button"
            id="telegram-unlink-btn"
            class="admin-btn admin-btn-secondary"
            disabled
          >
            Unlink
          </button>
        </div>
      </div>
      <p id="telegram-status" class="text-sm mt-3 text-gray-500 dark:text-gray-400">
        Loading…
      </p>
    </div>
  </div>

  <script>
    import { profileService } from "../../lib/profile";
    import { uploadImage } from "../../lib/upload";
    import { ApiClient } from "../../lib/api-client";
    import { API_BASE_URL } from "../../lib/config";

    const saveBtnBottom = document.getElementById(
      "save-profile-btn-bottom",
    ) as HTMLButtonElement | null;
    const form = document.getElementById(
      "profile-form",
    ) as HTMLFormElement | null;
    const avatarInput = document.querySelector(
      'input[name="avatarUrl"]',
    ) as HTMLInputElement | null;
    const avatarUpload = document.getElementById(
      "avatar-upload",
    ) as HTMLInputElement | null;
    const avatarImg = document.querySelector(
      "#avatar-preview",
    ) as HTMLImageElement | null;

    function parseDate(value?: string | null): Date | null {
      if (!value) return null;
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? null : date;
    }

    // Load profile data on mount
    async function loadProfile() {
      try {
        const profile = await profileService.getOwnerProfile();
        if (profile) {
          // Update images
          if (profile.avatarUrl && avatarImg) avatarImg.src = profile.avatarUrl;

          // Update text
          const nameDisplay = document.querySelector("h2");
          if (nameDisplay) nameDisplay.textContent = profile.name;

          const emailDisplay = document.querySelector("p.text-sky-400");
          if (emailDisplay) emailDisplay.textContent = profile.email;

          const dateDisplay = document.querySelector("p.text-gray-400");
          if (dateDisplay) {
            const date = parseDate(profile.createdAt);
            dateDisplay.textContent = `Member since ${date ? date.toLocaleDateString() : "-"}`;
          }

          // Update inputs
          const inputs = {
            id: profile.id,
            name: profile.name,
            email: profile.email,
            location: profile.location,
            website: profile.website,
            avatarUrl: profile.avatarUrl,
            bio: profile.bio,
            linkedinUrl: profile.linkedinUrl,
            githubUrl: profile.githubUrl,
            twitterUrl: profile.twitterUrl,
          };

          Object.entries(inputs).forEach(([key, value]) => {
            const input = document.querySelector(`[name="${key}"]`) as
              | HTMLInputElement
              | HTMLTextAreaElement;
            if (input && value) input.value = String(value);
          });

          // Telegram link state comes from the same profile payload.
          const telegramProfile = profile as any;
          renderTelegramStatus(telegramProfile.telegramChatId, telegramProfile.telegramLinkedAt);
        }
      } catch (error) {
        console.error("Failed to load profile", error);
      }
    }

    // Initial load
    loadProfile();

    // Handle URL input change
    if (avatarInput && avatarImg) {
      avatarInput.addEventListener("input", (e) => {
        const url = (e.target as HTMLInputElement).value;
        if (url) {
          try {
            const parsed = new URL(url);
            if (parsed.protocol === "http:" || parsed.protocol === "https:") {
              avatarImg.src = url;
            }
          } catch {
            // Invalid URL - skip preview update
          }
        }
      });
    }

    // Handle File Upload
    if (avatarUpload && avatarImg) {
      avatarUpload.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        avatarUpload.disabled = true;
        try {
          const url = await uploadImage(file);
          avatarImg.src = url;
          if (avatarInput) avatarInput.value = url;
        } catch (error) {
          const message =
            error instanceof Error ? error.message : "Upload failed";
          alert(`Upload failed: ${message}`);
        } finally {
          avatarUpload.disabled = false;
        }
      });
    }

    async function handleSave(e: Event) {
      e.preventDefault();
      if (!form) return;

      const formData = new FormData(form);
      const id = formData.get("id");
      const data: any = {};

      formData.forEach((value, key) => {
        if (key !== "id") {
          data[key] = value;
        }
      });

      if (saveBtnBottom) {
        saveBtnBottom.dataset.originalContent = saveBtnBottom.innerHTML;
        saveBtnBottom.innerHTML = `SAVING...`;
        saveBtnBottom.disabled = true;
      }

      try {
        if (id) {
          await profileService.updateProfile(Number(id), data);
          alert("Profile updated successfully!");
        }
      } catch (error) {
        console.error(error);
        alert("Failed to update profile.");
      } finally {
        if (saveBtnBottom && saveBtnBottom.dataset.originalContent) {
          saveBtnBottom.innerHTML = saveBtnBottom.dataset.originalContent;
          saveBtnBottom.disabled = false;
        }
      }
    }

    form?.addEventListener("submit", handleSave);

    // --- Telegram ---
    // ApiClient is instantiated here directly: the profile service has no Telegram
    // methods yet (src/lib is outside this change).
    const telegramApi = new ApiClient(API_BASE_URL);
    const telegramInput = document.getElementById(
      "telegram-chat-id",
    ) as HTMLInputElement | null;
    const telegramLinkBtn = document.getElementById(
      "telegram-link-btn",
    ) as HTMLButtonElement | null;
    const telegramUnlinkBtn = document.getElementById(
      "telegram-unlink-btn",
    ) as HTMLButtonElement | null;
    const telegramStatus = document.getElementById(
      "telegram-status",
    ) as HTMLParagraphElement | null;

    function renderTelegramStatus(chatId?: string | null, linkedAt?: string | null) {
      if (telegramInput) telegramInput.value = chatId ? String(chatId) : "";
      if (telegramUnlinkBtn) telegramUnlinkBtn.disabled = !chatId;
      if (!telegramStatus) return;
      const linked = parseDate(linkedAt);
      telegramStatus.textContent = chatId
        ? `Linked to chat ${chatId}${linked ? ` since ${linked.toLocaleString()}` : ""}.`
        : "Not linked yet - message the bot to get your chat id.";
    }

    telegramLinkBtn?.addEventListener("click", async () => {
      const chatId = telegramInput?.value.trim();
      if (!chatId) {
        alert("Paste your Telegram chat id first.");
        return;
      }

      telegramLinkBtn.disabled = true;
      try {
        await telegramApi.put("/owner/profile/telegram", { chatId });
        await loadProfile();
      } catch (error) {
        alert(
          `Link failed: ${error instanceof Error ? error.message : "unknown error"}`,
        );
      } finally {
        telegramLinkBtn.disabled = false;
      }
    });

    telegramUnlinkBtn?.addEventListener("click", async () => {
      telegramUnlinkBtn.disabled = true;
      try {
        await telegramApi.delete("/owner/profile/telegram");
        await loadProfile();
      } catch (error) {
        alert(
          `Unlink failed: ${error instanceof Error ? error.message : "unknown error"}`,
        );
      } finally {
        telegramUnlinkBtn.disabled = false;
      }
    });
  </script>
</PrivateLayout>
