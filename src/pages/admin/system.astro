---
import PrivateLayout from "../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
---

<PrivateLayout title="System Logs">
  <div class="space-y-6">
    <AdminPageHeader
      title="System Logs"
      description="Owner action audit trail - every create, update, publish and delete"
    >
      <button
        slot="actions"
        onclick="window.location.reload()"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 transition-colors hover:border-slate-400 dark:hover:border-slate-500 hover:text-slate-700 dark:hover:text-slate-300"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          ></path>
        </svg>
        Refresh
      </button>
    </AdminPageHeader>

    <!-- Error banner -->
    <div
      id="logs-error"
      class="hidden rounded-lg border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 text-sm px-4 py-3"
    >
      Couldn’t load system logs. Please refresh to try again.
    </div>

    <div
      class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 overflow-hidden"
    >
      <div class="overflow-x-auto">
        <table
          class="w-full text-left text-sm text-slate-500 dark:text-slate-400"
        >
          <thead class="bg-slate-50 dark:bg-slate-900/50">
            <tr>
              <th
                scope="col"
                class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >Timestamp</th
              >
              <th
                scope="col"
                class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >Action</th
              >
              <th
                scope="col"
                class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >Entity</th
              >
              <th
                scope="col"
                class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >IP</th
              >
            </tr>
          </thead>
          <tbody id="logs-body">
            <tr>
              <td
                colspan="4"
                class="px-6 py-8 text-center text-slate-400 dark:text-slate-500"
                >Loading…</td
              >
            </tr>
          </tbody>
        </table>
      </div>
      <p
        id="logs-empty"
        class="hidden p-8 text-center text-slate-500 dark:text-slate-400"
      >
        No logs found.
      </p>
    </div>
  </div>
</PrivateLayout>

<script>
  import { systemService, type AuditLog } from "../../lib/system";

  // Fetched client-side on purpose: the SSR Worker cannot forward the httpOnly
  // API cookie, so the old frontmatter fetch always 401'd and this page was
  // permanently empty. Every other admin page fetches client-side too.

  const badgeClass = (action: string): string =>
    ["delete", "archive", "unpublish"].includes(action)
      ? "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400"
      : ["create", "publish", "attach"].includes(action)
        ? "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400"
        : "bg-slate-100 dark:bg-slate-700/40 text-slate-600 dark:text-slate-300";

  // Guarded: an unparseable timestamp renders as-is instead of throwing and
  // blanking the table.
  const formatTimestamp = (value: string): string => {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? value : date.toLocaleString();
  };

  // textContent only - entity/ip values come from request data the caller
  // controls, so never use innerHTML here.
  const renderLogs = (logs: AuditLog[]): void => {
    const body = document.getElementById("logs-body");
    if (!body) return;
    body.replaceChildren();

    for (const log of logs) {
      const row = document.createElement("tr");
      row.className =
        "border-b border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors";

      const time = document.createElement("td");
      time.className = "px-6 py-4 text-xs text-slate-500 dark:text-slate-400";
      time.textContent = formatTimestamp(log.createdAt);

      const actionCell = document.createElement("td");
      actionCell.className = "px-6 py-4";
      const badge = document.createElement("span");
      badge.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${badgeClass(log.action)}`;
      badge.textContent = log.action.toUpperCase();
      actionCell.appendChild(badge);

      const entity = document.createElement("td");
      entity.className = "px-6 py-4 text-slate-900 dark:text-slate-100";
      entity.textContent = log.entityId
        ? `${log.entityType} #${log.entityId}`
        : log.entityType;

      const ip = document.createElement("td");
      ip.className = "px-6 py-4 text-slate-500 dark:text-slate-400";
      ip.textContent = log.ipAddress ?? "-";

      row.append(time, actionCell, entity, ip);
      body.appendChild(row);
    }
  };

  const loadLogs = async (): Promise<void> => {
    const body = document.getElementById("logs-body");
    if (!body) return;
    const errorEl = document.getElementById("logs-error");
    const emptyEl = document.getElementById("logs-empty");
    errorEl?.classList.add("hidden");

    try {
      const logs = await systemService.getLogs();
      renderLogs(logs);
      emptyEl?.classList.toggle("hidden", logs.length > 0);
    } catch (error) {
      console.error("System logs load failed:", error);
      body.replaceChildren();
      errorEl?.classList.remove("hidden");
    }
  };

  loadLogs();
  document.addEventListener("astro:page-load", loadLogs);
</script>
