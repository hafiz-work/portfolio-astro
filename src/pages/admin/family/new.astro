---
import { ArrowLeft } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { FamilyTreeBuilder } from "../../../components/admin/family/FamilyTreeBuilder";
---

<PrivateLayout title="New Family Tree">
  <div class="space-y-6">
    <AdminPageHeader
      title="New Family Tree"
      description="Add a new family member"
    >
      <a
        slot="actions"
        href="/admin/family"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>

    <FamilyTreeBuilder client:load mode="new" />
  </div>
</PrivateLayout>
