---
import { Plus } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { RolesTable } from "../../../components/admin/access/RolesTable";
---

<PrivateLayout title="Roles">
  <div class="space-y-6">
    <AdminPageHeader
      title="Roles"
      description="What each role may do, per module and action. Owner only."
    >
      <a
        slot="actions"
        href="/admin/roles/new"
        class="admin-btn admin-btn-primary"
      >
        <Plus className="w-4 h-4" />
        New Role
      </a>
    </AdminPageHeader>
    <RolesTable client:load />
  </div>
</PrivateLayout>
