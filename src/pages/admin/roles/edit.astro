---
import { ArrowLeft } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { RoleForm } from "../../../components/admin/access/RoleForm";
---

<PrivateLayout title="Edit Role">
  <div class="space-y-6">
    <AdminPageHeader
      title="Edit Role"
      description="Change the role's name, description and permissions."
    >
      <a
        slot="actions"
        href="/admin/roles"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>
    <RoleForm client:load mode="edit" />
  </div>
</PrivateLayout>
