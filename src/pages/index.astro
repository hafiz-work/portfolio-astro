---
import PublicLayout from "../layouts/PublicLayout.astro";
import { Image } from "astro:assets";
import JsonLd from "../components/seo/JsonLd.astro";
import Hero from "../components/home/Hero.astro";
import ContactSection from "../components/home/ContactSection.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import MapSection from "../components/home/MapSection.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import {
	getPublicProjects,
	getPublicExperiences,
} from "../lib/public-content";

// Server-side data with curated fallback - this page never shows loading
// spinners, error banners, or empty states.
const [projects, experiences] = await Promise.all([
	getPublicProjects(),
	getPublicExperiences(),
]);

const FIRST_DEV_ROLE_YEAR = 2020; // Jom Dapur, Sep 2020
const yearsExperience = Math.max(
	1,
	new Date().getFullYear() - FIRST_DEV_ROLE_YEAR,
);

type SkillLevel = "advanced" | "proficient" | "familiar";
interface Skill {
	name: string;
	level: SkillLevel;
}

// Ordered backend-first to match positioning.
const skills: { category: string; items: Skill[] }[] = [
	{
		category: "Backend",
		items: [
			{ name: "Node.js", level: "advanced" },
			{ name: "Bun", level: "advanced" },
			{ name: "Java", level: "familiar" },
		],
	},
	{
		category: "Framework",
		items: [
			{ name: "Flutter", level: "advanced" },
			{ name: "Next.js", level: "familiar" },
			{ name: "React Native", level: "proficient" },
			{ name: "Laravel", level: "familiar" },
			{ name: "CodeIgniter 3", level: "proficient" },
			{ name: "CodeIgniter 4", level: "familiar" },
			{ name: "Hono", level: "advanced" },
			{ name: "Express.js", level: "advanced" },
		],
	},
	{
		category: "Mobile",
		items: [
			{ name: "Kotlin (Android)", level: "familiar" },
			{ name: "Java (Android)", level: "familiar" },
		],
	},
	{
		category: "Databases",
		items: [
			{ name: "MongoDB", level: "advanced" },
			{ name: "PostgreSQL", level: "proficient" },
			{ name: "SQLite / D1", level: "proficient" },
			{ name: "Redis", level: "familiar" },
		],
	},
	{
		category: "Languages",
		items: [
			{ name: "TypeScript", level: "proficient" },
			{ name: "JavaScript", level: "proficient" },
			{ name: "Dart", level: "proficient" },
			{ name: "PHP", level: "proficient" },
			{ name: "Kotlin", level: "familiar" },
			{ name: "Java", level: "familiar" },
		],
	},
	{
		category: "Web",
		items: [
			{ name: "React", level: "familiar" },
			{ name: "Astro", level: "familiar" },
			{ name: "Tailwind CSS", level: "proficient" },
		],
	},
	{
		category: "Artificial Intelligence (AI)",
		items: [
			{ name: "Claude", level: "proficient" },
			{ name: "Codex", level: "proficient" },
			{ name: "Ollama", level: "proficient" },
			{ name: "OpenCode", level: "proficient" },
			{ name: "CommandCode", level: "proficient" },
		],
	},
	{
		category: "Infrastructure",
		items: [
			{ name: "Cloudflare Workers", level: "proficient" },
			{ name: "Linux", level: "proficient" },
			{ name: "Caddy", level: "proficient" },
			{ name: "nginx", level: "proficient" },
			{ name: "Git", level: "proficient" },
			{ name: "Docker", level: "familiar" },
		],
	},
	{
		category: "Tooling",
		items: [
			{ name: "GitHub Actions", level: "proficient" },
			{ name: "Wrangler", level: "proficient" },
			{ name: "Vite", level: "proficient" },
			{ name: "VS Code", level: "proficient" },
		],
	},
];

const levelStyle: Record<SkillLevel, string> = {
	advanced:
		"bg-sky-500/10 text-sky-700 ring-sky-500/25 dark:bg-sky-400/10 dark:text-sky-300 dark:ring-sky-400/25",
	proficient:
		"bg-gray-950/[0.03] text-gray-950 ring-gray-950/10 dark:bg-white/5 dark:text-white dark:ring-white/15",
	familiar:
		"text-gray-500 ring-gray-950/5 dark:text-gray-500 dark:ring-white/10",
};

const legend: { level: SkillLevel; label: string; dot: string }[] = [
	{ level: "advanced", label: "Advanced", dot: "bg-sky-500 dark:bg-sky-400" },
	{ level: "proficient", label: "Proficient", dot: "bg-gray-950 dark:bg-white" },
	{ level: "familiar", label: "Familiar", dot: "bg-gray-300 dark:bg-gray-600" },
];

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Hafiz Bahtiar",
	jobTitle: "Backend & Flutter Developer",
	description:
		"Backend & Flutter developer building reliable APIs and production Flutter apps.",
	url: "https://hafizbahtiar.com",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Kuala Lumpur",
		addressCountry: "MY",
	},
	sameAs: [
		"https://github.com/hafizbahtiar",
		"https://www.linkedin.com/in/hafizbahtiar/",
	],
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Hafiz Bahtiar",
	url: "https://hafizbahtiar.com",
};
---

<PublicLayout>
	<JsonLd schema={personSchema} />
	<JsonLd schema={websiteSchema} />
	<Hero projectCount={projects.length} yearsExperience={yearsExperience} />

	<!-- GitHub Activity -->
	<section id="github-activity" class="scroll-offset">
		<div class="section-gap"></div>
		<SectionHeader
			eyebrow="Activity"
			title="Shipping, most days."
			description="Public GitHub contributions over the last year - the boring consistency that production software is built on."
		>
			<a
				slot="action"
				href="https://github.com/hafizbahtiar"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-pill btn-pill-ghost"
			>
				View profile
			</a>
		</SectionHeader>
		<div class="h-10"></div>
		<div class="line-y p-2" data-reveal>
			<div class="frame">
				<div class="frame-inner overflow-x-auto p-3 md:p-5">
					<Image
						src="https://ghchart.rshah.org/0ea5e9/hafizbahtiar"
						alt="GitHub contribution chart for hafizbahtiar"
						id="github-chart"
						width="722"
						height="112"
						loading="lazy"
						decoding="async"
						class="block h-auto w-full min-w-[620px] transition-[filter] duration-300"
						referrerpolicy="no-referrer"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Skills Section -->
	<section id="skills" class="scroll-offset">
		<div class="section-gap"></div>
		<SectionHeader
			eyebrow="Stack"
			title="Backend first, mobile close behind."
			description="The tools I ship production software with, grouped by where they live in the system."
		/>
		<div class="line-y mt-6" data-reveal>
			<div class="container-main flex flex-wrap items-center gap-x-5 gap-y-2">
				{
					legend.map((item) => (
						<span class="inline-flex items-center gap-2 font-mono text-xs/6 text-gray-500 dark:text-gray-400">
							<span class={`h-1.5 w-1.5 rounded-full ${item.dot}`} />
							{item.label}
						</span>
					))
				}
			</div>
		</div>
		<div class="h-10"></div>
		<div class="line-t" data-reveal>
			<div class="row-grid">
				{
					skills.map((skillGroup) => (
						<div class="px-4 py-6 sm:px-6 sm:py-8">
							<h3 class="text-sm/6 font-semibold text-gray-950 dark:text-white">
								{skillGroup.category}
							</h3>
							<div class="mt-4 flex flex-wrap gap-1.5">
								{skillGroup.items.map((item) => (
									<span
										class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs/5 font-medium ring-1 ring-inset ${levelStyle[item.level]}`}
									>
										{item.name}
									</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="scroll-offset">
		<div class="section-gap"></div>
		<SectionHeader
			eyebrow="Selected work"
			title="Production systems, not side quests."
			description="Marketplaces, government platforms, logistics tooling and offline-first apps - shipped and running."
		>
			<a slot="action" href="/projects" class="btn-pill btn-pill-ghost">
				View all {projects.length}
				<span aria-hidden="true">&rarr;</span>
			</a>
		</SectionHeader>
		<div class="h-10"></div>
		<FeaturedProjects projects={projects} />
	</section>

	<MapSection experiences={experiences} />

	<ContactSection />
</PublicLayout>

<script>
	// The GitHub chart is served light-themed; invert it in dark mode.
	const applyChartFilter = () => {
		const chart = document.getElementById(
			"github-chart",
		) as HTMLImageElement | null;
		if (!chart) return;
		const isDark = document.documentElement.classList.contains("dark");
		chart.style.filter = isDark
			? "invert(1) hue-rotate(180deg) saturate(0.85) brightness(0.9)"
			: "none";
	};

	applyChartFilter();
	document.addEventListener("astro:page-load", applyChartFilter);
	document.addEventListener("astro:after-swap", applyChartFilter);

	const observer = new MutationObserver(applyChartFilter);
	observer.observe(document.documentElement, { attributeFilter: ["class"] });
</script>
