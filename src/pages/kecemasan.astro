---
export const prerender = true; // static and small: opens fast on a weak signal
import TechHeading from "../components/layout/TechHeading.astro";
import BackLink from "../components/ui/BackLink.astro";
import Alert from "../components/ui/Alert.astro";
import Disclaimer from "../components/ui/Disclaimer.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import GridFillers from "../components/ui/GridFillers.astro";
import { KECEMASAN, telHref, vcardSlug } from "../data/kecemasan";
import { isoToDmy } from "../lib/date-my";

// Every number comes from src/data/kecemasan.ts with its official source and the
// date it was checked (bun scripts/check-kecemasan.ts).
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const lastVerified = KECEMASAN.flatMap((g) =>
  g.contacts.map((c) => c.verified),
).sort()[0];
const sources = [
  ...new Map(
    KECEMASAN.flatMap((g) => g.contacts).map((c) => [host(c.source), c.source]),
  ).entries(),
]
  .slice(0, 6)
  .map(([name, href]) => ({ name, href }));
const report = `mailto:hafiz@hafizbahtiar.com?subject=${encodeURIComponent("Nombor kecemasan salah")}`;
---

<PublicLayout
  title="Nombor Kecemasan Malaysia - 999, Lebuh Raya, Scam | Hafiz Bahtiar"
  description="Himpunan nombor kecemasan Malaysia: 999, talian lebuh raya (PLUS, LLM), NSRC 997 untuk scam, sokongan emosi dan APM. Setiap nombor dengan sumber rasmi."
>
  <div class="relative mx-auto mt-8 max-lg:max-w-2xl sm:mt-24">
    <BackLink />
    <div class="line-y">
      <h1
        class="mx-2 text-4xl tracking-tighter text-balance sm:text-7xl lg:text-8xl"
      >
        <TechHeading
          text="Nombor Kecemasan"
          fontSize={96}
          fontWeight={400}
          box="-my-12 h-48"
        />
      </h1>
    </div>
    <div class="line-y mt-10">
      <p class="mx-2 text-lg">
        Nombor penting bila berlaku kecemasan, kereta rosak di lebuh raya atau
        ditipu scam.
      </p>
    </div>

    <div class="line-y mt-6">
      <Alert
        variant="danger"
        title="Nyawa dalam bahaya? Hubungi 999 sekarang."
        class="mx-2"
      >
        <p>
          Polis, Bomba, ambulans, Pertahanan Awam dan Maritim - semuanya melalui
          999.
        </p>
        <p>
          <a
            href="tel:999"
            class="mt-1 inline-flex! items-center gap-2 rounded-full bg-red-600 px-5 py-2.5 text-base font-semibold text-white! no-underline! hover:bg-red-700"
          >
            Call 999
          </a>
        </p>
      </Alert>
    </div>

    <div class="line-y mt-6">
      <div class="mx-2 flex flex-wrap items-center gap-x-4 gap-y-2">
        <label for="kecemasan-cari" class="sr-only">Cari nombor</label>
        <input
          id="kecemasan-cari"
          type="search"
          placeholder="Cari: lebuh raya, scam, banjir, Selangor…"
          autocomplete="off"
          class="field h-10 max-w-md"
          hidden
        />
        <p class="text-sm/6 text-gray-500 dark:text-gray-400">
          Tekan kad atau nombor untuk terus call. Semua nombor disemak dengan
          laman rasmi agensi pada {isoToDmy(lastVerified)}.{" "}
          <a
            href={report}
            class="font-medium text-sky-600 hover:underline dark:text-sky-400"
            >Lapor nombor salah</a
          >
        </p>
      </div>
      <!-- Filter chips: hidden until the script runs (no JS = everything shows). -->
      <div
        id="kecemasan-tapis"
        role="group"
        aria-label="Tapis kategori"
        class="mx-2 mt-4 flex flex-wrap gap-2"
        hidden
      >
        {
          [{ id: "", short: "Semua" }, ...KECEMASAN].map((g) => (
            <button
              type="button"
              data-chip={g.id}
              aria-pressed={g.id === "" ? "true" : "false"}
              class="rounded-full px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-gray-950/10 hover:bg-gray-950/5 aria-pressed:bg-gray-950 aria-pressed:text-white aria-pressed:ring-gray-950 dark:text-gray-300 dark:ring-white/15 dark:hover:bg-white/5 dark:aria-pressed:bg-white dark:aria-pressed:text-gray-950 dark:aria-pressed:ring-white"
            >
              {g.short}
            </button>
          ))
        }
      </div>
    </div>

    {
      KECEMASAN.map((g) => (
        <section id={g.id} data-group class="scroll-offset">
          <div class="line-y mt-10">
            <h2 class="eyebrow mx-2">{g.title}</h2>
          </div>
          {g.intro && (
            <div class="line-y mt-3">
              <p class="mx-2 max-w-3xl text-sm/6 text-gray-600 dark:text-gray-400">
                {g.intro}
              </p>
            </div>
          )}
          <div class="line-y mt-4">
            <ul class="grid grid-cols-1 gap-px bg-gray-950/5 sm:grid-cols-2 lg:grid-cols-3 dark:bg-white/10">
              {g.contacts.map((c, i) => (
                <li
                  data-contact
                  data-text={[g.title, g.intro, c.name, c.number, c.note]
                    .filter(Boolean)
                    .join(" ")
                    .toLowerCase()}
                  class="relative flex flex-col gap-3 bg-white px-4 py-5 transition-colors has-data-call:hover:bg-sky-50/60 sm:px-6 dark:bg-gray-950 dark:has-data-call:hover:bg-white/5"
                >
                  <div>
                    <p class="font-medium text-gray-950 dark:text-white">
                      {c.name}
                    </p>
                    {c.hours && (
                      <p class="text-xs/5 text-gray-500 dark:text-gray-400">
                        {c.hours}
                      </p>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {c.number && (
                      <a
                        href={telHref(c.number)}
                        data-call
                        aria-label={`Call ${c.name}: ${c.number}`}
                        class="inline-flex items-center gap-2 rounded-full bg-sky-600 px-4 py-2 text-lg font-semibold text-white tabular-nums after:absolute after:inset-0 after:content-[''] hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                      >
                        <svg
                          class="size-4"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.513 2.31a1.5 1.5 0 0 1-1.206 1.81l-.97.162a.75.75 0 0 0-.585.892 9.97 9.97 0 0 0 6.79 6.79.75.75 0 0 0 .892-.585l.162-.97a1.5 1.5 0 0 1 1.81-1.206l2.31.513A1.5 1.5 0 0 1 18 14.352V15.5a1.5 1.5 0 0 1-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5Z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {c.number}
                      </a>
                    )}
                    {c.number && (
                      <button
                        type="button"
                        data-copy={c.number}
                        class="relative z-10 inline-flex items-center rounded-full px-3 py-2 text-sm font-medium text-gray-600 ring-1 ring-gray-950/10 hover:bg-gray-950/5 dark:text-gray-300 dark:ring-white/15 dark:hover:bg-white/5"
                      >
                        Salin
                      </button>
                    )}
                    {c.number && (
                      <a
                        href={`/kecemasan/${vcardSlug(g, i)}.vcf`}
                        download={`${c.name.slice(0, 40)}.vcf`}
                        data-astro-reload
                        aria-label={`Simpan ${c.name} ke kenalan`}
                        class="relative z-10 inline-flex items-center rounded-full px-3 py-2 text-sm font-medium text-gray-600 ring-1 ring-gray-950/10 hover:bg-gray-950/5 dark:text-gray-300 dark:ring-white/15 dark:hover:bg-white/5"
                      >
                        Simpan
                      </a>
                    )}
                    {c.href && (
                      <a
                        href={c.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="relative z-10 inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-sky-700 ring-1 ring-sky-600/30 hover:bg-sky-500/10 dark:text-sky-400 dark:ring-sky-400/30"
                      >
                        {c.hrefLabel ?? c.href}
                      </a>
                    )}
                  </div>
                  {c.note && (
                    <p class="text-sm/6 text-gray-600 dark:text-gray-400">
                      {c.note}
                    </p>
                  )}
                  <p class="mt-auto text-xs/5 text-gray-500 dark:text-gray-400">
                    Sumber:{" "}
                    <a
                      href={c.source}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="relative z-10 hover:text-sky-600 hover:underline dark:hover:text-sky-400"
                    >
                      {host(c.source)}
                    </a>{" "}
                    · disemak {isoToDmy(c.verified)}
                  </p>
                </li>
              ))}
              <GridFillers count={g.contacts.length} />
            </ul>
          </div>
        </section>
      ))
    }
    <div class="line-y mt-10 hidden" id="kecemasan-kosong">
      <p class="mx-2 text-sm/6 text-gray-600 dark:text-gray-400">
        Tiada padanan. Dalam kecemasan, hubungi 999.
      </p>
    </div>

    <div class="line-y mt-10">
      <Alert variant="info" title="Kereta rosak di lebuh raya" class="mx-2">
        <ul>
          <li>
            Berhenti di lorong kecemasan sejauh mungkin ke kiri, hidupkan lampu
            kecemasan.
          </li>
          <li>
            Keluar ikut pintu kiri dan tunggu di belakang penghadang jalan,
            bukan di dalam atau di depan kereta.
          </li>
          <li>
            Catat nama lebuh raya, arah perjalanan dan penanda kilometer (KM)
            terdekat - operator akan bertanya.
          </li>
          <li>
            Hubungi operator lebuh raya di atas. Jika ada kecederaan, kebakaran
            atau bahaya, hubungi 999.
          </li>
        </ul>
      </Alert>
    </div>

    <div class="line-y mt-6">
      <Disclaimer class="mx-2" sources={sources}>
        Nombor boleh berubah tanpa notis. Setiap nombor disalin daripada laman
        rasmi agensi dan disemak pada tarikh yang dinyatakan; jika ragu, rujuk
        laman rasmi tersebut. Dalam kecemasan yang mengancam nyawa, <strong
          >hubungi 999</strong
        >.
      </Disclaimer>
    </div>
    <div class="mb-16 sm:mb-46"></div>
  </div>
</PublicLayout>

<script>
  // Search + category chips: a contact shows when it matches the words AND sits in the
  // picked category ("" = Semua); empty groups hide. #<group id> picks a chip on load.
  const init = () => {
    const input = document.getElementById(
      "kecemasan-cari",
    ) as HTMLInputElement | null;
    const chipRow = document.getElementById("kecemasan-tapis");
    if (!input || !chipRow || input.dataset.bound === "1") return;
    input.dataset.bound = "1";
    input.hidden = false;
    chipRow.hidden = false;
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const chips = [
      ...chipRow.querySelectorAll<HTMLButtonElement>("[data-chip]"),
    ];
    const empty = document.getElementById("kecemasan-kosong")!;
    const fromHash = location.hash.slice(1);
    let active = groups.some((g) => g.id === fromHash) ? fromHash : "";

    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const g of groups) {
        let inGroup = 0;
        const inCategory = !active || g.id === active;
        for (const c of g.querySelectorAll<HTMLElement>("[data-contact]")) {
          const hit =
            inCategory && words.every((w) => c.dataset.text!.includes(w));
          c.hidden = !hit;
          if (hit) inGroup++;
        }
        g.hidden = inGroup === 0;
        shown += inGroup;
      }
      // Fillers are sized for a full group; hide them while the words filter cuts it.
      document
        .querySelectorAll<HTMLElement>("[data-group] li.pattern")
        .forEach((f) => (f.style.display = words.length ? "none" : ""));
      empty.classList.toggle("hidden", shown > 0);
      chips.forEach((c) =>
        c.setAttribute("aria-pressed", String(c.dataset.chip === active)),
      );
    };

    input.addEventListener("input", apply);
    chipRow.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-chip]",
      );
      if (!chip) return;
      active = chip.dataset.chip ?? "";
      // Shareable (#bank) without adding a Back step or jumping the page.
      history.replaceState(
        history.state,
        "",
        active ? `#${active}` : location.pathname + location.search,
      );
      apply();
    });
    apply();
  };
  // "Salin": for desktops, where tel: links have no phone to open.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy]",
    );
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.textContent = "Disalin";
    } catch {
      btn.textContent = btn.dataset.copy!; // clipboard blocked: show it to copy by hand
    }
    setTimeout(() => (btn.textContent = "Salin"), 2000);
  });

  init();
  document.addEventListener("astro:page-load", init);
</script>
