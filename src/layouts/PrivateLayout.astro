---
import CoreLayout from "./CoreLayout.astro";
import Background from "../components/layout/Background.astro";
import AdminSidebar from "../components/admin/AdminSidebar.astro";
import AdminNavbar from "../components/admin/AdminNavbar.astro";
import UnsavedChangesModal from "../components/ui/UnsavedChangesModal.astro";
import ConfirmModal from "../components/ui/ConfirmModal.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<CoreLayout
    title={title}
    description={description}
    class="font-inter text-gray-950 dark:text-white"
>
    <Background />
    <!-- Same shell as PublicLayout: hatched gutter | column | hatched gutter.
         Inside the column: flat hairline sidebar + content that scrolls with
         the page, so admin reads as the same site as index.astro. -->
    <div class="page-shell min-h-dvh">
        <div class="gutter gutter-left" aria-hidden="true"></div>
        <div class="page-col">
            <div class="flex flex-grow">
                <AdminSidebar />
                <div class="flex min-w-0 flex-grow flex-col">
                    <AdminNavbar />
                    <main class="container-main flex-grow pt-10 pb-20">
                        <slot />
                    </main>
                </div>
            </div>
        </div>
        <div class="gutter gutter-right" aria-hidden="true"></div>
    </div>

    <UnsavedChangesModal />
    <ConfirmModal />
</CoreLayout>

<script>
    import { authService } from "../lib/auth";

    // Attempt a silent token refresh before deciding to redirect.
    // This handles the case where _accessToken is gone (new tab / page reload)
    // but a valid refresh_token httpOnly cookie still exists on the API domain.
    const guardAuth = async () => {
        if (authService.isAuthenticated()) return;
        const refreshed = await authService.tryRefresh();
        if (!refreshed) {
            window.location.replace("/login");
        }
    };

    guardAuth();
    window.addEventListener("pageshow", () => {
        guardAuth();
    });
</script>
