---
import PublicLayout from "./PublicLayout.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, image, imageAlt, noindex } = Astro.props;
---

<PublicLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
>
  <div class="min-h-screen pb-20 sm:pb-28">
    <slot />
  </div>
</PublicLayout>
