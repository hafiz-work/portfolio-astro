---
// Account area (public sign-in/register/verify + signed-in /account/*): a
// self-contained shadcn/ui screen - no public site navbar, gutters or sky/gray
// palette. Everything here speaks shadcn tokens (see src/components/shadcn/README.md).
// Admin signs in at /admin/login (its own page), never here.
import CoreLayout from "./CoreLayout.astro";
import { AuthShell } from "../components/account/AuthShell";
import { AccountShell } from "../components/account/AccountShell";

interface Props {
  title: string;
  description?: string;
  /** "auth": split - brand panel left, form right. "app": signed-in area with nav. */
  variant?: "auth" | "app";
  /** auth only: the top-right link to the other auth page. */
  switchTo?: { href: string; label: string };
}

const { title, description, variant = "app", switchTo } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<CoreLayout
  title={`${title} | Hafiz Bahtiar`}
  description={description}
  noindex
  class="font-inter"
>
  {
    variant === "auth" ? (
      <AuthShell client:load title={title} switchTo={switchTo}>
        <slot />
      </AuthShell>
    ) : (
      <AccountShell client:load path={path}>
        <slot />
      </AccountShell>
    )
  }
</CoreLayout>
