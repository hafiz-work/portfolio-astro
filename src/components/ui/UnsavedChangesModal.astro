---
import { TriangleAlert } from "lucide-react";

---

<div
  id="unsaved-changes-modal"
  class="fixed inset-0 z-50 hidden"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div
    class="fixed inset-0 bg-gray-950/80 backdrop-blur-sm transition-opacity opacity-0"
    id="modal-backdrop"
  >
  </div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div
      class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0"
    >
      <!-- Modal Panel -->
      <div
        class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl ring-1 ring-gray-950/10 dark:bg-gray-900 dark:ring-white/10 transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        id="modal-panel"
      >
        <div class="px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div
              class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-sky-500/10 sm:mx-0 sm:h-10 sm:w-10"
            >
              <TriangleAlert className="h-6 w-6 text-sky-600 dark:text-sky-400" strokeWidth={1.5} aria-hidden="true" />
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
              <h3
                class="text-base/6 font-semibold text-gray-950 dark:text-white"
                id="modal-title"
              >
                Unsaved Changes
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500 dark:text-gray-300">
                  You have unsaved changes. Are you sure you want to leave? Your
                  changes will be lost.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="gap-2 border-t border-gray-950/5 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 dark:border-white/10"
        >
          <button
            type="button"
            id="modal-confirm-btn"
            class="admin-btn admin-btn-primary w-full sm:ml-3 sm:w-auto"
          >
            Leave Page
          </button>
          <button
            type="button"
            id="modal-cancel-btn"
            class="admin-btn admin-btn-secondary mt-3 w-full sm:mt-0 sm:w-auto"
          >
            Stay
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Simple modal logic to be controlled externally
  const modal = document.getElementById("unsaved-changes-modal");
  const backdrop = document.getElementById("modal-backdrop");
  const panel = document.getElementById("modal-panel");
  const confirmBtn = document.getElementById("modal-confirm-btn");
  const cancelBtn = document.getElementById("modal-cancel-btn");

  let resolvePromise: ((value: boolean) => void) | null = null;

  function show() {
    if (!modal || !backdrop || !panel) return Promise.resolve(false);

    modal.classList.remove("hidden");
    // Animation frame for transition
    requestAnimationFrame(() => {
      backdrop.classList.remove("opacity-0");
      panel.classList.remove(
        "opacity-0",
        "translate-y-4",
        "sm:translate-y-0",
        "sm:scale-95",
      );
    });

    return new Promise<boolean>((resolve) => {
      resolvePromise = resolve;
    });
  }

  function hide() {
    if (!modal || !backdrop || !panel) return;

    backdrop.classList.add("opacity-0");
    panel.classList.add(
      "opacity-0",
      "translate-y-4",
      "sm:translate-y-0",
      "sm:scale-95",
    );

    setTimeout(() => {
      modal.classList.add("hidden");
    }, 200); // Match transition duration
  }

  confirmBtn?.addEventListener("click", () => {
    hide();
    if (resolvePromise) resolvePromise(true);
  });

  cancelBtn?.addEventListener("click", () => {
    hide();
    if (resolvePromise) resolvePromise(false);
  });

  // Expose to window for the utility to use easily
  (window as any).unsavedChangesModal = {
    show,
    hide,
  };
</script>
