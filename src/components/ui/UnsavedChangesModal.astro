---

---

<div
  id="unsaved-changes-modal"
  class="fixed inset-0 z-50 hidden"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div
    class="fixed inset-0 bg-gray-950/80 backdrop-blur-sm transition-opacity opacity-0"
    id="modal-backdrop"
  >
  </div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div
      class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0"
    >
      <!-- Modal Panel -->
      <div
        class="relative transform overflow-hidden rounded-xl bg-white border border-gray-200 dark:bg-gray-900 dark:border-gray-700 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        id="modal-panel"
      >
        <div class="px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div
              class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-sky-500/10 sm:mx-0 sm:h-10 sm:w-10"
            >
              <svg
                class="h-6 w-6 text-sky-600 dark:text-sky-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                ></path>
              </svg>
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
              <h3
                class="text-base font-semibold leading-6 text-gray-900 dark:text-white"
                id="modal-title"
              >
                Unsaved Changes
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500 dark:text-gray-300">
                  You have unsaved changes. Are you sure you want to leave? Your
                  changes will be lost.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="border-t border-gray-200 dark:border-white/5 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2"
        >
          <button
            type="button"
            id="modal-confirm-btn"
            class="admin-btn admin-btn-primary w-full sm:ml-3 sm:w-auto"
          >
            Leave Page
          </button>
          <button
            type="button"
            id="modal-cancel-btn"
            class="admin-btn admin-btn-secondary mt-3 w-full sm:mt-0 sm:w-auto"
          >
            Stay
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Controlled externally via window.unsavedChangesModal (see lib/form-guard.ts).
  // This bundled script runs once per session, but <ClientRouter> swaps the
  // modal markup on every navigation - so look elements up on each call instead
  // of caching them, or show() would animate a detached node and never resolve.
  const el = (id: string) => document.getElementById(id);
  const HIDDEN = [
    "opacity-0",
    "translate-y-4",
    "sm:translate-y-0",
    "sm:scale-95",
  ];

  let resolvePromise: ((value: boolean) => void) | null = null;

  function show() {
    const modal = el("unsaved-changes-modal");
    const backdrop = el("modal-backdrop");
    const panel = el("modal-panel");
    if (!modal || !backdrop || !panel)
      return Promise.resolve(
        window.confirm("You have unsaved changes. Leave?"),
      );

    resolvePromise?.(false); // a second show() supersedes a pending one
    modal.classList.remove("hidden");
    requestAnimationFrame(() => {
      backdrop.classList.remove("opacity-0");
      panel.classList.remove(...HIDDEN);
    });
    return new Promise<boolean>((resolve) => {
      resolvePromise = resolve;
    });
  }

  function hide() {
    const modal = el("unsaved-changes-modal");
    el("modal-backdrop")?.classList.add("opacity-0");
    el("modal-panel")?.classList.add(...HIDDEN);
    setTimeout(() => modal?.classList.add("hidden"), 200); // match transition
  }

  function settle(value: boolean) {
    hide();
    resolvePromise?.(value);
    resolvePromise = null;
  }

  // Delegated once: survives page swaps.
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("#modal-confirm-btn")) settle(true);
    else if (t.closest("#modal-cancel-btn")) settle(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && resolvePromise) settle(false);
  });

  (window as any).unsavedChangesModal = { show, hide };
</script>
