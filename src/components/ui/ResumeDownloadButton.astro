---
import { Download } from "lucide-react";
interface Props {
  /** Override the anchor classes for the placement (defaults to the Hero style). */
  class?: string;
  /** Attribution hint sent to the tracker (e.g. "hero", "contact"). */
  source?: string;
}

const {
  class: className =
    "inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-semibold rounded-xl hover:border-gray-400 dark:hover:border-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:-translate-y-0.5 transition-all",
  source = "site",
} = Astro.props;
---

<a
  href="/docs/hafizbahtiar-resume-4-3.pdf"
  download="Hafiz-Bahtiar-Resume.pdf"
  data-resume-download
  data-source={source}
  class={className}
>
  <Download className="w-4 h-4" aria-hidden="true" />
  Download Resume
</a>
