---
import { Download } from "lucide-react";
interface Props {
  /** Override the anchor classes for the placement (defaults to the Hero style). */
  class?: string;
  /** Attribution hint sent to the tracker (e.g. "hero", "contact"). */
  source?: string;
}

const {
  class: className = "btn-pill btn-pill-ghost",
  source = "site",
} = Astro.props;
---

<a
  href="/docs/hafizbahtiar-resume-4-3.pdf"
  download="Hafiz-Bahtiar-Resume.pdf"
  data-resume-download
  data-source={source}
  class={className}
>
  <Download className="w-4 h-4" aria-hidden="true" />
  Download Resume
</a>
