---
// Admin wrapper: label + DatePicker (dd/mm/yyyy shown, ISO submitted).
import DatePicker from "./DatePicker.astro";

interface Props {
  label: string;
  name: string;
  value?: string;
  required?: boolean;
  class?: string;
  id?: string;
}

const {
  label,
  name,
  value = "",
  required = false,
  class: className = "",
  id: inputId = `${name}-input`,
} = Astro.props;
---

<div class={`space-y-2 ${className}`}>
  <label class="admin-label" for={`${inputId}-text`}>
    {label}
  </label>
  <DatePicker id={inputId} name={name} value={value} required={required} />
</div>
