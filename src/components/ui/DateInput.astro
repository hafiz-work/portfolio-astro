---
interface Props {
  label: string;
  name: string;
  value?: string;
  required?: boolean;
  class?: string;
  id?: string;
  placeholder?: string;
}

const {
  label,
  name,
  value = "",
  required = false,
  class: className = "",
  id: inputId = `${name}-input`,
  placeholder,
} = Astro.props;
---

<div class={`space-y-2 ${className}`}>
  <label
    class="admin-label"
    for={inputId}
  >
    {label}
  </label>
  <input
    id={inputId}
    type="date"
    name={name}
    value={value}
    required={required}
    placeholder={placeholder}
    class="field"
  />
</div>
