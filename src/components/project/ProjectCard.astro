---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  title: string;
  description: string;
  imageUrl?: string | ImageMetadata;
  imageVariant?: "banner" | "logo" | "width-banner";
  imageLoading?: "lazy" | "eager";
  imageFetchPriority?: "high" | "low" | "auto";
  tags: string[];
  link?: string;
  year?: number;
  projectType?: "personal" | "business" | "work";
  featured?: boolean;
}

const {
  title,
  description,
  imageUrl,
  imageVariant = "banner",
  imageLoading = "lazy",
  imageFetchPriority = "low",
  tags,
  link = "#",
  year,
  projectType,
  featured = false,
} = Astro.props;

const isStringImage = typeof imageUrl === "string";
// <Image> types local (ImageMetadata) and remote (string) src as separate
// prop shapes, so the two branches below narrow `imageUrl` for each.
const imageProps = {
  alt: title,
  width: 640,
  height: 192,
  loading: imageLoading,
  decoding: "async",
  fetchpriority: imageFetchPriority,
  class: `w-full h-full group-hover:scale-[1.03] transition-transform duration-500 ${imageVariant === "width-banner" ? "object-contain p-4" : "object-cover"}`,
} as const;
const slug = link.split("/").pop() || title.toLowerCase().replace(/\s+/g, "-");

// Logo assets never work as banners - render a composed device-frame
// preview instead of stretching them. Real screenshots/lockups pass through.
const useComposedPreview = imageVariant === "logo";

// Width-banner assets are brand lockups designed for light backgrounds -
// keep them on a white surface even in dark mode.
const imageSurface =
  imageVariant === "width-banner"
    ? "bg-white"
    : "bg-gray-50 dark:bg-white/5";

const typeLabel: Record<string, string> = {
  personal: "Personal project",
  business: "Product",
  work: "Client work",
};
const eyebrow = [year, projectType ? typeLabel[projectType] : null]
  .filter(Boolean)
  .join(" · ");
---

<div
  class="frame-inner group relative flex h-full flex-col transition-colors hover:outline-gray-950/15 dark:hover:outline-white/20"
>
  <!-- Image Area -->
  <div
    transition:name={`project-image-${slug}`}
    class={`relative h-40 sm:h-52 ${imageSurface} overflow-hidden border-b border-gray-950/5 dark:border-white/10`}
  >
    {
      useComposedPreview ? (
        <ProjectPreview
          slug={slug}
          title={title}
          imageUrl={isStringImage ? imageUrl : undefined}
          tags={tags}
        />
      ) : imageUrl ? (
        <div class="absolute inset-0">
          {isStringImage ? (
            <Image src={imageUrl} {...imageProps} />
          ) : (
            <Image src={imageUrl} {...imageProps} />
          )}
        </div>
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <svg
            class="w-10 h-10 text-gray-300 dark:text-gray-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </div>
      )
    }
    {
      featured && (
        <span class="absolute top-3 right-3 rounded-full bg-gray-950/80 px-2.5 py-0.5 font-mono text-[10px] font-semibold tracking-widest text-sky-300 uppercase backdrop-blur-sm">
          Featured
        </span>
      )
    }
  </div>

  <!-- Content -->
  <div class="flex flex-grow flex-col p-4 sm:p-5">
    {
      eyebrow && (
        <p class="mb-1 font-mono text-[11px]/5 text-gray-500">
          {eyebrow}
        </p>
      )
    }
    <div class="flex items-start justify-between gap-2 mb-2">
      <h3
        transition:name={`project-title-${slug}`}
        class="text-base/6 font-semibold tracking-tight text-gray-950 dark:text-white"
      >
        {title}
      </h3>
      <svg
        class="mt-1 h-4 w-4 shrink-0 text-gray-400 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-sky-500 dark:text-gray-500 dark:group-hover:text-sky-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M7 17L17 7M17 7H7M17 7v10"></path>
      </svg>
    </div>

    <!-- No flex-grow here: stretching a line-clamped box re-exposes the
         clipped lines in Chromium's standard line-clamp implementation.
         The tags row's mt-auto handles bottom alignment instead. -->
    <p
      class="mb-4 line-clamp-2 text-sm/6 text-gray-600 sm:line-clamp-3 dark:text-gray-400"
    >
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5 mt-auto">
      {
        tags
          .slice(0, 4)
          .map((tag) => (
            <span class="tag">
              {tag}
            </span>
          ))
      }
      {
        tags.length > 4 && (
          <span class="tag text-gray-400 dark:text-gray-500">
            +{tags.length - 4}
          </span>
        )
      }
    </div>

    <a
      href={link}
      class="absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"
      aria-label={`View ${title}`}></a>
  </div>
</div>
