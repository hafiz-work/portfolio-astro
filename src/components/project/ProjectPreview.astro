---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Composed preview for projects that only have a logo, not a screenshot.
 * Renders an abstract device frame (browser for web, phone for mobile) with
 * the logo as a small contained chip - honest about not being a screenshot,
 * but reads as shipped product instead of a stretched logo.
 */
interface Props {
  slug: string;
  title: string;
  imageUrl?: string | ImageMetadata;
  tags?: string[];
  /** Chosen on the Cover media in admin; unset = guess from the tech tags. */
  frame?: "phone" | "web";
  /** "eager" for cards in the first screen (see ProjectCard). */
  loading?: "lazy" | "eager";
}

const { slug, title, imageUrl, tags = [], frame, loading = "lazy" } = Astro.props;

const isMobile =
  frame === "phone" ||
  (!frame &&
    tags.some((t) =>
      /flutter|react.?native|mobile|android|ios|swift/i.test(t),
    ));

// Accent = the logo's own colours: a blurred, zoomed copy of the logo tints the
// glow and the hero block. Same <Image> size as the logo chip, so the same URL -
// no extra download. Sky when there's no image.
// ponytail: zoomed centre of the logo, not a true dominant-colour pick - a mostly
// white logo gives a pale tint; compute a colour at upload if that bites.
const logoSrc = typeof imageUrl === "string" ? imageUrl : imageUrl?.src;
---

<div class="absolute inset-0 bg-gray-50 dark:bg-white/3 overflow-hidden">
  <!-- Dot grid + accent glow backdrop -->
  <div class="absolute inset-0 pattern"></div>
  <div
    class={`pointer-events-none absolute -top-10 -right-10 h-36 w-36 overflow-hidden rounded-full blur-3xl ${logoSrc ? "opacity-40" : "bg-sky-500/15"}`}
  >
    {
      logoSrc && (
        <Image
          src={logoSrc}
          alt=""
          width={40}
          height={40}
          aria-hidden="true"
          {loading}
          decoding="async"
          class="h-full w-full scale-150 object-cover saturate-200"
        />
      )
    }
  </div>

  {
    isMobile ? (
      <div class="relative mx-auto mt-5 sm:mt-7 w-25 sm:w-29 h-full rounded-t-2xl border border-gray-200 dark:border-gray-600/80 bg-white dark:bg-gray-900 shadow-xl shadow-gray-300/40 dark:shadow-black/40 overflow-hidden transform-gpu transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
        <div class="mx-auto mt-1.5 h-1 w-8 rounded-full bg-gray-200 dark:bg-gray-600" />
        <div class="p-2 space-y-1.5">
          <div class="flex items-center gap-1.5">
            {logoSrc && (
              <Image
                src={logoSrc}
                alt={`${title} logo`}
                width={40}
                height={40}
                {loading}
                decoding="async"
                class="w-5 h-5 rounded bg-white object-contain shrink-0"
              />
            )}
            <div class="h-1.5 w-10 rounded-full bg-gray-200 dark:bg-gray-600" />
          </div>
          <div
            class={`h-7 relative overflow-hidden rounded-md ${logoSrc ? "opacity-60" : "bg-sky-500/15 ring-1 ring-sky-500/25 ring-inset"}`}
          >
            {logoSrc && (
              <Image
                src={logoSrc}
                alt=""
                width={40}
                height={40}
                aria-hidden="true"
                {loading}
                decoding="async"
                class="absolute inset-0 h-full w-full scale-[3] object-cover blur-md saturate-200"
              />
            )}
          </div>
          <div class="h-1.5 w-full rounded-full bg-gray-100 dark:bg-gray-700" />
          <div class="h-1.5 w-4/5 rounded-full bg-gray-100 dark:bg-gray-700" />
          <div class="h-1.5 w-3/5 rounded-full bg-gray-100 dark:bg-gray-700" />
          <div class="h-4 w-3/4 mx-auto rounded-full bg-gray-100 dark:bg-gray-700" />
        </div>
      </div>
    ) : (
      <div class="relative mx-auto mt-6 sm:mt-8 w-[80%] h-full rounded-t-xl border border-gray-200 dark:border-gray-600/80 bg-white dark:bg-gray-900 shadow-xl shadow-gray-300/40 dark:shadow-black/40 overflow-hidden transform-gpu transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600" />
          <span class="w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600" />
          <span class="w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600" />
          <span class="ml-1 flex-1 max-w-[60%] truncate rounded bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 font-mono text-[8px] leading-none text-gray-400 dark:text-gray-500">
            {slug}
          </span>
        </div>
        <div class="flex h-full">
          <div class="w-1/4 border-r border-gray-100 dark:border-gray-700 p-1.5 space-y-1.5">
            <div class="h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-600" />
            <div class="h-1.5 w-full rounded-full bg-gray-100 dark:bg-gray-700" />
            <div class="h-1.5 w-3/4 rounded-full bg-gray-100 dark:bg-gray-700" />
          </div>
          <div class="flex-1 p-2 space-y-1.5">
            <div class="flex items-center gap-1.5">
              {logoSrc && (
                <Image
                  src={logoSrc}
                  alt={`${title} logo`}
                  width={40}
                  height={40}
                  {loading}
                  decoding="async"
                  class="w-5 h-5 rounded bg-white object-contain shrink-0"
                />
              )}
              <div class="h-1.5 w-1/3 rounded-full bg-gray-200 dark:bg-gray-600" />
            </div>
            <div class="flex gap-1.5">
              <div
                class={`h-6 flex-1 relative overflow-hidden rounded-md ${logoSrc ? "opacity-60" : "bg-sky-500/15 ring-1 ring-sky-500/25 ring-inset"}`}
              >
                {logoSrc && (
                  <Image
                    src={logoSrc}
                    alt=""
                    width={40}
                    height={40}
                    aria-hidden="true"
                    {loading}
                    decoding="async"
                    class="absolute inset-0 h-full w-full scale-[3] object-cover blur-md saturate-200"
                  />
                )}
              </div>
              <div class="h-6 flex-1 rounded-md bg-gray-100 dark:bg-gray-700" />
            </div>
            <div class="h-1.5 w-full rounded-full bg-gray-100 dark:bg-gray-700" />
            <div class="h-1.5 w-2/3 rounded-full bg-gray-100 dark:bg-gray-700" />
          </div>
        </div>
      </div>
    )
  }

  <!-- Honest label: composed preview, not a screenshot -->
  <span
    class="absolute bottom-2 left-3 z-10 rounded-full bg-white/90 px-2 py-0.5 font-mono text-[10px]/4 uppercase tracking-wider text-gray-500 ring-1 ring-gray-950/5 ring-inset dark:bg-gray-950/80 dark:text-gray-400 dark:ring-white/10"
  >
    {isMobile ? "mobile app" : "web app"}
  </span>
</div>
