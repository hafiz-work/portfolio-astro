---
import { Image } from "astro:assets";
const links = [
  {
    text: "Dashboard",
    href: "/admin",
    icon: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  },
  {
    text: "Projects",
    href: "/admin/projects",
    icon: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  },
  {
    text: "Experiences",
    href: "/admin/experiences",
    icon: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  },
  {
    text: "Family",
    href: "/admin/family",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    text: "Blog",
    href: "/admin/blog",
    icon: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>',
  },
  {
    text: "Policies",
    href: "/admin/policies",
    icon: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  },
  {
    text: "Contacts",
    href: "/admin/contact",
    icon: '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  },
  {
    text: "System Logs",
    href: "/admin/system",
    icon: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  },
  {
    text: "Settings",
    href: "/admin/settings",
    icon: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    text: "Profile",
    href: "/admin/profile",
    icon: '<path d="M18 20a6 6 0 0 0-12 0"/><circle cx="12" cy="10" r="4"/><circle cx="12" cy="12" r="10"/>',
  },
];

const groups = [
  { label: "Overview", items: links.slice(0, 1) },
  { label: "Content", items: links.slice(1, 6) },
  { label: "Inbox", items: links.slice(6, 7) },
  { label: "System", items: links.slice(7) },
];

const currentPath = Astro.url.pathname;
---

<aside
  id="admin-sidebar"
  class="fixed top-3 bottom-3 left-3 z-40 w-64 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-[10px] shadow-lg overflow-hidden transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-in-out is-open"
>
  <div class="sidebar-content h-full flex flex-col">
    <!-- Header -->
    <div
      class="sidebar-header p-6 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between"
    >
      <h1
        class="sidebar-title font-mono text-base font-semibold text-slate-900 dark:text-slate-100 tracking-tight"
        aria-label="Admin dashboard"
      >
        <span class="inline-flex items-center gap-2">
          <Image src="/brand/logo.svg" alt="" width={24} height={24} class="h-6 w-6" />
          hafizbahtiar<span class="text-slate-400 dark:text-slate-500">/admin</span>
        </span>
      </h1>
      <span
        class="sidebar-mark font-mono text-xl font-semibold text-slate-900 dark:text-slate-100 tracking-tight"
        aria-hidden="true"
        ><Image src="/brand/logo.svg" alt="" width={28} height={28} class="h-7 w-7" /></span
      >
      <button
        id="close-sidebar"
        class="md:hidden p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 rounded-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-grow px-3 py-4 overflow-y-auto">
      {
        groups.map((group) => (
          <div class="mb-4 last:mb-0">
            <p class="nav-group-label px-3 mb-1.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">
              {group.label}
            </p>
            <div class="space-y-0.5">
              {group.items.map((link) => {
                const isActive =
                  currentPath === link.href ||
                  (link.href !== "/admin" && currentPath.startsWith(link.href));
                return (
                  <a
                    href={link.href}
                    aria-label={link.text}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "nav-item relative flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors duration-150 group",
                      isActive
                        ? "bg-blue-50 text-blue-700 font-medium dark:bg-slate-800 dark:text-slate-100"
                        : "text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800/70",
                    ]}
                  >
                    {isActive && (
                      <span class="absolute left-0 top-1/2 -translate-y-1/2 h-5 w-0.5 rounded-full bg-blue-500 dark:bg-cyan-400" />
                    )}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class:list={[
                        "nav-icon h-[18px] w-[18px]",
                        isActive
                          ? "text-blue-600 dark:text-cyan-400"
                          : "text-slate-400 group-hover:text-slate-700 dark:text-slate-500 dark:group-hover:text-slate-300",
                      ]}
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <Fragment set:html={link.icon} />
                    </svg>
                    <span class="nav-label">{link.text}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </nav>

    <!-- User Profile Footer -->
    <div
      class="p-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/50"
    >
      <div class="space-y-3">
        <div class="flex items-center space-x-3 px-2">
          <div class="relative">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-bold text-sm"
            >
              HB
            </div>
            <div
              class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white dark:border-slate-900"
            >
            </div>
          </div>
          <div class="user-meta flex-grow min-w-0">
            <div
              class="text-slate-900 dark:text-slate-100 font-medium truncate"
            >
              Hafiz Bahtiar
            </div>
            <div class="text-slate-500 dark:text-slate-500 text-xs truncate">
              Super Admin
            </div>
          </div>
        </div>
        <button
          id="logout-btn"
          class="logout-btn w-full inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 11-6 0v-1m6 0H9"></path>
          </svg>
          <span class="logout-label">Logout</span>
        </button>
      </div>
    </div>
  </div>
</aside>
<style>
  #admin-sidebar {
    transition:
      width 300ms ease,
      transform 300ms ease;
  }
  #admin-sidebar .sidebar-content {
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }
  #admin-sidebar .nav-item {
    transition:
      padding 300ms ease,
      gap 300ms ease,
      justify-content 300ms ease;
  }
  #admin-sidebar .nav-label,
  #admin-sidebar .sidebar-title,
  #admin-sidebar .sidebar-mark,
  #admin-sidebar .user-meta,
  #admin-sidebar .logout-label {
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      max-width 200ms ease,
      max-height 200ms ease;
  }
  #admin-sidebar .nav-label,
  #admin-sidebar .logout-label,
  #admin-sidebar .sidebar-title {
    white-space: nowrap;
    overflow: hidden;
  }
  #admin-sidebar .sidebar-mark {
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
    max-width: 0;
    transform: translateX(6px);
    pointer-events: none;
  }
  #admin-sidebar .nav-icon {
    flex-shrink: 0;
  }
  #admin-sidebar .user-meta {
    overflow: hidden;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar {
    width: 5rem;
  }
  :root[data-admin-sidebar="closed"] #admin-sidebar {
    transform: translateX(-100%);
  }
  :root[data-admin-sidebar="closed"] #admin-sidebar .sidebar-content {
    opacity: 0;
    transform: translateX(-12px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-group-label {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
    overflow: hidden;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-label,
  :root[data-admin-sidebar="minimized"] #admin-sidebar .logout-label,
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-title {
    opacity: 0;
    max-width: 0;
    transform: translateX(-6px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-mark {
    opacity: 1;
    max-width: 4rem;
    transform: none;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-header {
    justify-content: center;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .user-meta {
    opacity: 0;
    max-height: 0;
    transform: translateY(-4px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-item {
    gap: 0;
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-icon {
    margin: 0;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .logout-btn {
    justify-content: center;
  }
</style>

<!-- Overlay for mobile -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden opacity-0 transition-opacity duration-300 md:hidden"
>
</div>

<div
  id="logout-modal"
  class="fixed inset-0 z-50 hidden"
  aria-labelledby="logout-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div
    class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm transition-opacity opacity-0"
    id="logout-backdrop"
  >
  </div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div
      class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0"
    >
      <div
        class="relative transform overflow-hidden rounded-lg bg-slate-800 border border-red-500/30 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        id="logout-panel"
      >
        <div class="bg-slate-800/50 px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div
              class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-900/30 sm:mx-0 sm:h-10 sm:w-10"
            >
              <svg
                class="h-5 w-5 text-red-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v3.75m0 3.75h.007v.008H12v-.008z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M6 6.75V5.25a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 5.25v1.5"
                ></path>
              </svg>
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
              <h3
                class="text-base font-semibold leading-6 text-slate-100"
                id="logout-modal-title"
              >
                Log out
              </h3>
              <div class="mt-2">
                <p class="text-sm text-slate-400">
                  Are you sure you want to log out? You'll need to sign in again
                  to access the admin panel.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="bg-slate-900/50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2"
        >
          <button
            type="button"
            id="logout-confirm-btn"
            class="inline-flex w-full justify-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto transition-colors"
          >
            Log out
          </button>
          <button
            type="button"
            id="logout-cancel-btn"
            class="mt-3 inline-flex w-full justify-center rounded-lg bg-transparent border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-400 shadow-sm hover:bg-slate-700 sm:mt-0 sm:w-auto transition-colors"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      toggleAdminSidebar: () => void;
      minimizeAdminSidebar: () => void;
    }
  }

  import { authService } from "../../lib/auth";

  function bindLogoutModal() {
    const logoutBtn = document.getElementById("logout-btn");
    const logoutModal = document.getElementById("logout-modal");
    const logoutBackdrop = document.getElementById("logout-backdrop");
    const logoutPanel = document.getElementById("logout-panel");
    const logoutConfirmBtn = document.getElementById("logout-confirm-btn");
    const logoutCancelBtn = document.getElementById("logout-cancel-btn");

    if (!logoutBtn || !logoutModal || !logoutBackdrop || !logoutPanel) return;
    if (logoutBtn.dataset.bound === "true") return;
    const modal = logoutModal;
    const backdrop = logoutBackdrop;
    const panel = logoutPanel;

    function showLogoutModal() {
      modal.classList.remove("hidden");
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        panel.classList.remove(
          "opacity-0",
          "translate-y-4",
          "sm:translate-y-0",
          "sm:scale-95",
        );
      });
    }

    function hideLogoutModal() {
      backdrop.classList.add("opacity-0");
      panel.classList.add(
        "opacity-0",
        "translate-y-4",
        "sm:translate-y-0",
        "sm:scale-95",
      );
      setTimeout(() => {
        modal.classList.add("hidden");
      }, 200);
    }

    async function performLogout() {
      try {
        logoutConfirmBtn?.setAttribute("disabled", "true");
        logoutCancelBtn?.setAttribute("disabled", "true");
        await authService.logout();
        window.location.replace("/login");
      } catch (error) {
        console.error("Logout failed", error);
        authService.clearAuthState();
        window.location.replace("/login");
      } finally {
        logoutConfirmBtn?.removeAttribute("disabled");
        logoutCancelBtn?.removeAttribute("disabled");
      }
    }

    logoutBtn.addEventListener("click", () => {
      showLogoutModal();
    });

    logoutCancelBtn?.addEventListener("click", () => {
      hideLogoutModal();
    });

    logoutBackdrop.addEventListener("click", () => {
      hideLogoutModal();
    });

    logoutConfirmBtn?.addEventListener("click", async () => {
      hideLogoutModal();
      await performLogout();
    });

    logoutBtn.dataset.bound = "true";
  }

  bindLogoutModal();
  document.addEventListener("astro:page-load", bindLogoutModal);
  document.addEventListener("astro:after-swap", bindLogoutModal);

  const STORAGE_KEY = "admin-sidebar-state";

  function setSidebarState(state: "open" | "closed" | "minimized") {
    const sidebar = document.getElementById("admin-sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    if (!sidebar || !overlay) return;

    const isMobile = window.matchMedia("(max-width: 767px)").matches;

    document.documentElement.dataset.adminSidebar = state;
    localStorage.setItem(STORAGE_KEY, state);

    if (state === "closed") {
      overlay.classList.add("opacity-0");
      setTimeout(() => {
        overlay.classList.add("hidden");
      }, 300);
      return;
    }

    if (state === "minimized") {
      overlay.classList.add("hidden", "opacity-0");
      return;
    }

    // Open
    if (isMobile) {
      overlay.classList.remove("hidden");
      overlay.offsetHeight;
      overlay.classList.remove("opacity-0");
    } else {
      overlay.classList.add("hidden", "opacity-0");
    }
  }

  function closeSidebar() {
    setSidebarState("closed");
  }

  function applyStoredSidebarState() {
    const isMobileView = window.matchMedia("(max-width: 767px)").matches;
    const storedState = localStorage.getItem(STORAGE_KEY) as
      | "open"
      | "closed"
      | "minimized"
      | null;

    if (isMobileView) {
      setSidebarState("closed");
      return;
    }

    if (storedState) {
      setSidebarState(storedState);
    } else {
      setSidebarState("open");
    }
  }

  function setupSidebar() {
    const closeBtn = document.getElementById("close-sidebar");
    const overlay = document.getElementById("sidebar-overlay");

    closeBtn?.addEventListener("click", closeSidebar);
    overlay?.addEventListener("click", closeSidebar);

    // Ensure state is applied correctly on page load
    applyStoredSidebarState();
  }

  setupSidebar();
  document.addEventListener("astro:page-load", setupSidebar);
  document.addEventListener("astro:after-swap", setupSidebar);

  window.toggleAdminSidebar = function () {
    const currentState =
      document.documentElement.dataset.adminSidebar || "open";
    if (currentState === "closed") {
      setSidebarState("open");
    } else {
      setSidebarState("closed");
    }
  };

  window.minimizeAdminSidebar = function () {
    const currentState =
      document.documentElement.dataset.adminSidebar || "open";
    if (currentState === "minimized") {
      setSidebarState("open");
    } else {
      setSidebarState("minimized");
    }
  };
</script>
