---
import {
  Briefcase,
  CircleUser,
  Folder,
  Inbox,
  LayoutDashboard,
  LogOut,
  Newspaper,
  Scale,
  Settings,
  Terminal,
  TriangleAlert,
  Users,
  X,
} from "lucide-react";
import { Image } from "astro:assets";
const links = [
  {
    text: "Dashboard",
    href: "/admin",
    icon: LayoutDashboard,
  },
  {
    text: "Projects",
    href: "/admin/projects",
    icon: Folder,
  },
  {
    text: "Experiences",
    href: "/admin/experiences",
    icon: Briefcase,
  },
  {
    text: "Family",
    href: "/admin/family",
    icon: Users,
  },
  {
    text: "Blog",
    href: "/admin/blog",
    icon: Newspaper,
  },
  {
    text: "Policies",
    href: "/admin/policies",
    icon: Scale,
  },
  {
    text: "Contacts",
    href: "/admin/contact",
    icon: Inbox,
  },
  {
    text: "System Logs",
    href: "/admin/system",
    icon: Terminal,
  },
  {
    text: "Settings",
    href: "/admin/settings",
    icon: Settings,
  },
  {
    text: "Profile",
    href: "/admin/profile",
    icon: CircleUser,
  },
];

const groups = [
  { label: "Overview", items: links.slice(0, 1) },
  { label: "Content", items: links.slice(1, 6) },
  { label: "Inbox", items: links.slice(6, 7) },
  { label: "System", items: links.slice(7) },
];

const currentPath = Astro.url.pathname;
---

<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-40 w-72 shrink-0 md:w-64 overflow-hidden border-r border-gray-950/5 bg-canvas dark:border-white/10 dark:bg-pub-dark md:sticky md:top-0 md:z-30 md:h-dvh"
>
  <div class="sidebar-content h-full flex flex-col">
    <!-- Header -->
    <div
      class="sidebar-header flex h-14 shrink-0 items-center justify-between border-b border-gray-950/5 px-4 dark:border-white/10"
    >
      <h1
        class="sidebar-title font-mono text-base font-semibold text-gray-950 dark:text-white tracking-tight"
        aria-label="Admin dashboard"
      >
        <span class="inline-flex items-center gap-2">
          <Image
            src="/brand/logo.svg"
            alt=""
            width={24}
            height={24}
            class="h-6 w-6"
          />
          hafizbahtiar<span class="text-gray-500 dark:text-gray-400"
            >/admin</span
          >
        </span>
      </h1>
      <span
        class="sidebar-mark font-mono text-xl font-semibold text-gray-950 dark:text-white tracking-tight"
        aria-hidden="true"
        ><Image
          src="/brand/logo.svg"
          alt=""
          width={28}
          height={28}
          class="h-7 w-7"
        /></span
      >
      <button
        id="close-sidebar"
        aria-label="Close sidebar"
        class="md:hidden p-2 text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 rounded-lg"
      >
        <X className="h-5 w-5" />
      </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-grow px-3 py-4 overflow-y-auto">
      {
        groups.map((group) => (
          <div class="mb-4 last:mb-0">
            <p class="nav-group-label px-3 mb-1.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
              {group.label}
            </p>
            <div class="space-y-0.5">
              {group.items.map((link) => {
                const isActive =
                  currentPath === link.href ||
                  (link.href !== "/admin" && currentPath.startsWith(link.href));
                return (
                  <a
                    href={link.href}
                    aria-label={link.text}
                    title={link.text}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "nav-item relative flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors duration-150 group",
                      isActive
                        ? "bg-sky-500/10 text-sky-700 font-medium dark:bg-white/[0.03] dark:text-white"
                        : "text-gray-500 hover:text-gray-950 hover:bg-gray-950/[0.025] dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-white/5",
                    ]}
                  >
                    {isActive && (
                      <span class="absolute left-0 top-1/2 -translate-y-1/2 h-5 w-0.5 rounded-full bg-sky-500 dark:bg-sky-400" />
                    )}
                    <link.icon
                      className={`nav-icon h-[18px] w-[18px] ${
                        isActive
                          ? "text-sky-600 dark:text-sky-400"
                          : "text-gray-400 group-hover:text-gray-700 dark:text-gray-500 dark:group-hover:text-gray-300"
                      }`}
                    />
                    <span class="nav-label">{link.text}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </nav>

    <!-- User Profile Footer -->
    <div class="p-4 border-t border-gray-950/5 dark:border-white/10">
      <div class="space-y-3">
        <div class="flex items-center space-x-3 px-2">
          <div class="relative">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-br from-sky-500 to-sky-600 flex items-center justify-center text-white font-bold text-sm"
            >
              HB
            </div>
            <div
              class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white dark:border-pub-dark"
            >
            </div>
          </div>
          <div class="user-meta flex-grow min-w-0">
            <div class="text-gray-950 dark:text-white font-medium truncate">
              Hafiz Bahtiar
            </div>
            <div class="text-gray-500 dark:text-gray-500 text-xs truncate">
              Super Admin
            </div>
          </div>
        </div>
        <button
          id="logout-btn"
          class="logout-btn admin-btn admin-btn-secondary w-full"
          type="button"
        >
          <LogOut className="h-4 w-4" />
          <span class="logout-label">Logout</span>
        </button>
      </div>
    </div>
  </div>
</aside>
<style>
  #admin-sidebar {
    transform: translateX(-100%);
    transition:
      width 300ms ease,
      transform 300ms ease;
  }
  :root[data-admin-sidebar="open"] #admin-sidebar {
    transform: none;
  }
  @media (min-width: 768px) {
    #admin-sidebar {
      transform: none;
    }
    :root[data-admin-sidebar="closed"] #admin-sidebar {
      width: 0;
      border-right-width: 0;
    }
  }
  #admin-sidebar .sidebar-content {
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }
  #admin-sidebar .nav-item {
    transition:
      padding 300ms ease,
      gap 300ms ease,
      justify-content 300ms ease;
  }
  #admin-sidebar .nav-label,
  #admin-sidebar .sidebar-title,
  #admin-sidebar .sidebar-mark,
  #admin-sidebar .user-meta,
  #admin-sidebar .logout-label {
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      max-width 200ms ease,
      max-height 200ms ease;
  }
  #admin-sidebar .nav-label,
  #admin-sidebar .logout-label,
  #admin-sidebar .sidebar-title {
    white-space: nowrap;
    overflow: hidden;
  }
  #admin-sidebar .sidebar-mark {
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
    max-width: 0;
    transform: translateX(6px);
    pointer-events: none;
  }
  #admin-sidebar .nav-icon,
  #admin-sidebar .logout-btn svg {
    flex-shrink: 0;
  }
  #admin-sidebar .user-meta {
    overflow: hidden;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar {
    width: 5rem;
  }
  :root[data-admin-sidebar="closed"] #admin-sidebar .sidebar-content {
    opacity: 0;
    transform: translateX(-12px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-group-label {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
    overflow: hidden;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-label,
  :root[data-admin-sidebar="minimized"] #admin-sidebar .logout-label,
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-title {
    opacity: 0;
    max-width: 0;
    transform: translateX(-6px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-mark {
    opacity: 1;
    max-width: 4rem;
    transform: none;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .sidebar-header {
    justify-content: center;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .user-meta {
    opacity: 0;
    max-height: 0;
    transform: translateY(-4px);
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-item {
    gap: 0;
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  :root[data-admin-sidebar="minimized"] #admin-sidebar .nav-icon {
    margin: 0;
  }
  /* Collapsed: the pill's padding + label gap would squeeze the icon to ~7px. */
  :root[data-admin-sidebar="minimized"] #admin-sidebar .logout-btn {
    justify-content: center;
    gap: 0;
    padding-left: 0;
    padding-right: 0;
  }
</style>

<!-- Overlay for mobile -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden opacity-0 transition-opacity duration-300 md:hidden"
>
</div>

<div
  id="logout-modal"
  class="fixed inset-0 z-50 hidden"
  aria-labelledby="logout-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div
    class="fixed inset-0 bg-gray-950/80 backdrop-blur-sm transition-opacity opacity-0"
    id="logout-backdrop"
  >
  </div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div
      class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0"
    >
      <div
        class="relative transform overflow-hidden rounded-xl bg-white dark:bg-gray-950 ring-1 ring-gray-950/5 dark:ring-white/10 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        id="logout-panel"
      >
        <div
          class="bg-white dark:bg-white/[0.03] px-4 pb-4 pt-5 sm:p-6 sm:pb-4"
        >
          <div class="sm:flex sm:items-start">
            <div
              class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-500/10 sm:mx-0 sm:h-10 sm:w-10"
            >
              <TriangleAlert className="h-5 w-5 text-red-600 dark:text-red-400" strokeWidth={1.5} aria-hidden="true" />
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
              <h3
                class="text-base/6 font-semibold text-gray-950 dark:text-white"
                id="logout-modal-title"
              >
                Log out
              </h3>
              <div class="mt-2">
                <p class="text-sm/6 text-gray-500 dark:text-gray-400">
                  Are you sure you want to log out? You'll need to sign in again
                  to access the admin panel.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="bg-gray-950/[0.03] dark:bg-white/5 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2"
        >
          <button
            type="button"
            id="logout-confirm-btn"
            class="admin-btn w-full bg-red-600 text-white hover:bg-red-500 sm:ml-3 sm:w-auto"
          >
            Log out
          </button>
          <button
            type="button"
            id="logout-cancel-btn"
            class="admin-btn admin-btn-secondary mt-3 w-full sm:mt-0 sm:w-auto"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      toggleAdminSidebar: () => void;
      minimizeAdminSidebar: () => void;
    }
  }

  import { authService } from "../../lib/auth";

  function bindLogoutModal() {
    const logoutBtn = document.getElementById("logout-btn");
    const logoutModal = document.getElementById("logout-modal");
    const logoutBackdrop = document.getElementById("logout-backdrop");
    const logoutPanel = document.getElementById("logout-panel");
    const logoutConfirmBtn = document.getElementById("logout-confirm-btn");
    const logoutCancelBtn = document.getElementById("logout-cancel-btn");

    if (!logoutBtn || !logoutModal || !logoutBackdrop || !logoutPanel) return;
    if (logoutBtn.dataset.bound === "true") return;
    const modal = logoutModal;
    const backdrop = logoutBackdrop;
    const panel = logoutPanel;

    function showLogoutModal() {
      modal.classList.remove("hidden");
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        panel.classList.remove(
          "opacity-0",
          "translate-y-4",
          "sm:translate-y-0",
          "sm:scale-95",
        );
      });
    }

    function hideLogoutModal() {
      backdrop.classList.add("opacity-0");
      panel.classList.add(
        "opacity-0",
        "translate-y-4",
        "sm:translate-y-0",
        "sm:scale-95",
      );
      setTimeout(() => {
        modal.classList.add("hidden");
      }, 200);
    }

    async function performLogout() {
      try {
        logoutConfirmBtn?.setAttribute("disabled", "true");
        logoutCancelBtn?.setAttribute("disabled", "true");
        await authService.logout();
        window.location.replace("/login");
      } catch (error) {
        console.error("Logout failed", error);
        authService.clearAuthState();
        window.location.replace("/login");
      } finally {
        logoutConfirmBtn?.removeAttribute("disabled");
        logoutCancelBtn?.removeAttribute("disabled");
      }
    }

    logoutBtn.addEventListener("click", () => {
      showLogoutModal();
    });

    logoutCancelBtn?.addEventListener("click", () => {
      hideLogoutModal();
    });

    logoutBackdrop.addEventListener("click", () => {
      hideLogoutModal();
    });

    logoutConfirmBtn?.addEventListener("click", async () => {
      hideLogoutModal();
      await performLogout();
    });

    logoutBtn.dataset.bound = "true";
  }

  bindLogoutModal();
  document.addEventListener("astro:page-load", bindLogoutModal);
  document.addEventListener("astro:after-swap", bindLogoutModal);

  const STORAGE_KEY = "admin-sidebar-state";

  function setSidebarState(state: "open" | "closed" | "minimized") {
    const sidebar = document.getElementById("admin-sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    if (!sidebar || !overlay) return;

    const isMobile = window.matchMedia("(max-width: 767px)").matches;

    document.documentElement.dataset.adminSidebar = state;
    // Hidden sidebar must not take keyboard focus.
    sidebar.inert = state === "closed";
    // Mobile always boots closed - don't let it overwrite the desktop choice.
    if (!isMobile) localStorage.setItem(STORAGE_KEY, state);

    if (state === "closed") {
      overlay.classList.add("opacity-0");
      setTimeout(() => {
        overlay.classList.add("hidden");
      }, 300);
      return;
    }

    if (state === "minimized") {
      overlay.classList.add("hidden", "opacity-0");
      return;
    }

    // Open
    if (isMobile) {
      overlay.classList.remove("hidden");
      overlay.offsetHeight;
      overlay.classList.remove("opacity-0");
    } else {
      overlay.classList.add("hidden", "opacity-0");
    }
  }

  function closeSidebar() {
    setSidebarState("closed");
  }

  function applyStoredSidebarState() {
    const isMobileView = window.matchMedia("(max-width: 767px)").matches;
    const storedState = localStorage.getItem(STORAGE_KEY) as
      | "open"
      | "closed"
      | "minimized"
      | null;

    if (isMobileView) {
      setSidebarState("closed");
      return;
    }

    if (storedState) {
      setSidebarState(storedState);
    } else {
      setSidebarState("open");
    }
  }

  function setupSidebar() {
    const closeBtn = document.getElementById("close-sidebar");
    const overlay = document.getElementById("sidebar-overlay");

    closeBtn?.addEventListener("click", closeSidebar);
    overlay?.addEventListener("click", closeSidebar);

    // Ensure state is applied correctly on page load
    applyStoredSidebarState();
  }

  setupSidebar();
  document.addEventListener("astro:page-load", setupSidebar);
  document.addEventListener("astro:after-swap", setupSidebar);

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      document.documentElement.dataset.adminSidebar === "open" &&
      window.matchMedia("(max-width: 767px)").matches
    ) {
      closeSidebar();
    }
  });

  window.toggleAdminSidebar = function () {
    const currentState =
      document.documentElement.dataset.adminSidebar || "open";
    if (currentState === "closed") {
      setSidebarState("open");
    } else {
      setSidebarState("closed");
    }
  };

  window.minimizeAdminSidebar = function () {
    const currentState =
      document.documentElement.dataset.adminSidebar || "open";
    if (currentState === "minimized") {
      setSidebarState("open");
    } else {
      setSidebarState("minimized");
    }
  };
</script>
