---
import { Menu, Moon, Settings, Sun } from "lucide-react";
const currentPath = Astro.url.pathname;
const paths = currentPath.split("/").filter(Boolean);

const breadcrumbs = paths.map((path, index) => {
    const href = `/${paths.slice(0, index + 1).join("/")}`;
    let label = path
        .replace(/-/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase());

    if (path === "admin") label = "Admin";
    if (path === "contact") label = "Contacts";

    return {
        label,
        href,
        isLast: index === paths.length - 1,
    };
});

if (paths.length === 1 && paths[0] === "admin") {
    breadcrumbs[0].isLast = false;
    breadcrumbs.push({ label: "Dashboard", href: "", isLast: true });
}
---

<header
    class="line-b sticky top-0 z-20 flex h-14 items-center justify-between gap-4 bg-canvas/95 px-4 backdrop-blur-sm sm:px-6 dark:bg-pub-dark/95"
>
    <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
            <button
                id="toggle-sidebar"
                class="md:hidden text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 p-2 rounded-lg hover:bg-gray-950/2.5 dark:hover:bg-white/5 transition-colors"
                aria-label="Toggle sidebar"
                type="button"
            >
                <Menu className="h-5 w-5" />
            </button>
            <button
                id="minimize-sidebar"
                class="hidden md:inline-flex text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 p-2 rounded-lg hover:bg-gray-950/2.5 dark:hover:bg-white/5 transition-colors"
                aria-label="Minimize sidebar"
                type="button"
            >
                <Menu className="h-5 w-5" />
            </button>
        </div>
        <div
            class="hidden sm:flex items-center text-sm text-gray-500 dark:text-gray-400 gap-2"
        >
            {
                breadcrumbs.map((crumb, index) => (
                    <>
                        {index > 0 && (
                            <span class="text-gray-300 dark:text-gray-600">
                                /
                            </span>
                        )}
                        {crumb.isLast ? (
                            <span class="text-gray-950 dark:text-gray-200">
                                {crumb.label}
                            </span>
                        ) : (
                            <a
                                href={crumb.href}
                                class="text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 transition-colors"
                            >
                                {crumb.label}
                            </a>
                        )}
                    </>
                ))
            }
        </div>
    </div>

    <div class="flex items-center gap-2 ml-auto">
        <!-- Theme Toggle -->
        <button
            id="admin-theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="admin-theme-toggle-btn p-2 text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 rounded-lg hover:bg-gray-950/2.5 dark:hover:bg-white/5 transition-colors"
        >
            <Sun id="admin-theme-sun" className="hidden h-5 w-5" />
            <Moon id="admin-theme-moon" className="block h-5 w-5" />
        </button>

        <!-- Settings Quick Link -->
        <a
            href="/admin/settings"
            class="p-2 text-gray-500 dark:text-gray-400 hover:text-gray-950 dark:hover:text-gray-200 rounded-lg hover:bg-gray-950/2.5 dark:hover:bg-white/5 transition-colors"
            aria-label="Settings"
        >
            <Settings className="h-5 w-5" />
        </a>
    </div>
</header>
<style>
    .admin-theme-toggle-btn {
        transform-origin: center;
        transition:
            transform 0.15s ease,
            background-color 0.2s,
            color 0.2s;
    }
    .admin-theme-toggle-btn:active {
        transform: scale(0.8);
    }
    #admin-theme-sun,
    #admin-theme-moon {
        transform-origin: center;
    }
    @keyframes admin-icon-into-dark {
        0% {
            transform: rotate(-60deg) scale(0.3);
            opacity: 0;
        }
        70% {
            transform: rotate(8deg) scale(1.15);
            opacity: 1;
        }
        100% {
            transform: rotate(0deg) scale(1);
            opacity: 1;
        }
    }
    @keyframes admin-icon-into-light {
        0% {
            transform: rotate(60deg) scale(0.3);
            opacity: 0;
        }
        70% {
            transform: rotate(-8deg) scale(1.15);
            opacity: 1;
        }
        100% {
            transform: rotate(0deg) scale(1);
            opacity: 1;
        }
    }
    .admin-icon-anim-sun {
        animation: admin-icon-into-dark 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)
            both;
    }
    .admin-icon-anim-moon {
        animation: admin-icon-into-light 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)
            both;
    }
    #minimize-sidebar svg {
        transition: transform 200ms ease;
    }
    :root[data-admin-sidebar="minimized"] #minimize-sidebar svg {
        transform: rotate(180deg);
    }
</style>

<script>
    declare global {
        interface Window {
            toggleAdminSidebar: () => void;
            minimizeAdminSidebar: () => void;
        }
    }

    function setupNavbar() {
        const themeToggle = document.getElementById("admin-theme-toggle");
        const sunIcon = document.getElementById("admin-theme-sun");
        const moonIcon = document.getElementById("admin-theme-moon");

        const syncThemeIcon = (animate = false) => {
            const isDark = document.documentElement.classList.contains("dark");
            if (!sunIcon || !moonIcon) return;

            if (isDark) {
                moonIcon.classList.add("hidden");
                moonIcon.classList.remove("block", "admin-icon-anim-moon");
                sunIcon.classList.remove("hidden");
                sunIcon.classList.add("block");
                if (animate) {
                    sunIcon.classList.remove("admin-icon-anim-sun");
                    void (sunIcon as HTMLElement).offsetWidth;
                    sunIcon.classList.add("admin-icon-anim-sun");
                }
            } else {
                sunIcon.classList.add("hidden");
                sunIcon.classList.remove("block", "admin-icon-anim-sun");
                moonIcon.classList.remove("hidden");
                moonIcon.classList.add("block");
                if (animate) {
                    moonIcon.classList.remove("admin-icon-anim-moon");
                    void (moonIcon as HTMLElement).offsetWidth;
                    moonIcon.classList.add("admin-icon-anim-moon");
                }
            }
        };

        syncThemeIcon();

        if (themeToggle && themeToggle.dataset.bound !== "true") {
            themeToggle.addEventListener("click", () => {
                const willBeDark =
                    !document.documentElement.classList.contains("dark");
                const rect = themeToggle.getBoundingClientRect();
                const x = rect.left + rect.width / 2;
                const y = rect.top + rect.height / 2;
                const radius = Math.hypot(
                    Math.max(x, window.innerWidth - x),
                    Math.max(y, window.innerHeight - y),
                );

                const applyTheme = () => {
                    document.documentElement.classList.toggle(
                        "dark",
                        willBeDark,
                    );
                    localStorage.setItem(
                        "theme",
                        willBeDark ? "dark" : "light",
                    );
                    syncThemeIcon(true);
                };

                const reducedMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;

                if (
                    typeof document.startViewTransition !== "function" ||
                    reducedMotion
                ) {
                    applyTheme();
                    return;
                }

                document.documentElement.setAttribute(
                    "data-theme-switching",
                    "",
                );
                const vt = document.startViewTransition(applyTheme);
                vt.ready
                    .then(() => {
                        document.documentElement.animate(
                            {
                                clipPath: [
                                    `circle(0px at ${x}px ${y}px)`,
                                    `circle(${radius}px at ${x}px ${y}px)`,
                                ],
                            },
                            {
                                duration: window.innerWidth < 768 ? 350 : 500,
                                easing: "cubic-bezier(0.4, 0, 0.2, 1)",
                                pseudoElement: "::view-transition-new(root)",
                            },
                        );
                    })
                    .catch(() => undefined);
                vt.finished.finally(() => {
                    document.documentElement.removeAttribute(
                        "data-theme-switching",
                    );
                });
            });
            themeToggle.dataset.bound = "true";
        }

        // Delegated: survives first-load module races and DOM swaps - the
        // listener works no matter when (or in what order) modules loaded.
        // The bound flag lives on `window`: <ClientRouter> rewrites <html>'s
        // attributes on every navigation, so a data-* flag there was lost and
        // each visit stacked another listener - two toggles cancel out.
        const w = window as Window & { __sidebarTogglesBound?: boolean };
        if (!w.__sidebarTogglesBound) {
            w.__sidebarTogglesBound = true;
            document.addEventListener("click", (event) => {
                const target = event.target as HTMLElement;
                if (target.closest("#toggle-sidebar")) {
                    window.toggleAdminSidebar?.();
                } else if (target.closest("#minimize-sidebar")) {
                    window.minimizeAdminSidebar?.();
                }
            });
        }
    }

    setupNavbar();
    document.addEventListener("astro:page-load", setupNavbar);
</script>
