---
import type { Project } from "../../types/project";
import ProjectCard from "../project/ProjectCard.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// 5 cards on a 3-col grid: the featured one spans two columns, so rows are
// [featured, 1] + [2, 3, 4] - no holes. (2-col: featured full row, then 2×2.)
const visible = projects.slice(0, 5);
---

<div class="line-y grid grid-cols-1 gap-2 p-2 sm:grid-cols-2 lg:grid-cols-3">
  {
    visible.map((project, index) => (
      <div
        class:list={["frame", index === 0 && "sm:col-span-2"]}
        data-reveal
        style={`--reveal-delay: ${(index % 2) * 80}ms`}
      >
        <ProjectCard
          title={project.title}
          description={project.description}
          imageUrl={project.imageUrl}
          imageVariant={project.imageVariant}
          imageLoading={index === 0 ? "eager" : "lazy"}
          imageFetchPriority={index === 0 ? "high" : "auto"}
          tags={
            project.technologies?.length
              ? project.technologies
              : (project.tags ?? [])
          }
          link={`/projects/${project.slug}`}
          year={project.year}
          projectType={project.projectType}
          featured={index === 0 && project.featured}
        />
      </div>
    ))
  }
</div>