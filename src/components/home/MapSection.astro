---
import MapCanvas from "./MapCanvas";
import SectionHeader from "../layout/SectionHeader.astro";
import type { Experience } from "../../types/experiences";
import { formatDateRange } from "../../lib/public-content";
import { KL_CENTER } from "../../lib/constants";

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;

const toCoordinate = (value: unknown): number | null => {
  const coordinate = Number(value);
  return Number.isFinite(coordinate) ? coordinate : null;
};

const markers = experiences.flatMap((exp) => {
  const latitude = toCoordinate(exp.latitude);
  const longitude = toCoordinate(exp.longitude);
  if (latitude === null || longitude === null) return [];
  return [
    {
      id: exp.id,
      company: exp.companyName,
      role: exp.role,
      date: formatDateRange(exp),
      latitude,
      longitude,
    },
  ];
});

const mapCenter: [number, number] =
  markers.length > 0
    ? [
        markers.reduce((sum, m) => sum + m.longitude, 0) / markers.length,
        markers.reduce((sum, m) => sum + m.latitude, 0) / markers.length,
      ]
    : KL_CENTER;
---

<section id="experience" class="scroll-offset">
  <div class="section-gap"></div>
  <SectionHeader
    eyebrow="Experience"
    title="Where I've shipped."
    description="Five years of production work across Kuala Lumpur - every pin is a place I've built software for."
  />
  <div class="h-10"></div>

  <div class="line-y grid grid-cols-1 lg:grid-cols-5">
    <!-- Timeline -->
    <ol class="divide-y divide-gray-950/5 lg:col-span-3 dark:divide-white/10" data-reveal>
      {
        experiences.map((exp, index) => (
          <li>
            <button
              type="button"
              class="exp-entry group relative flex w-full gap-4 px-4 py-5 text-left transition-colors hover:bg-gray-950/[0.025] sm:px-6 dark:hover:bg-white/[0.03]"
              data-marker-id={exp.id}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span
                class={`exp-dot mt-2 h-2 w-2 shrink-0 rounded-full ring-4 transition-colors ${
                  exp.isCurrent
                    ? "bg-emerald-500 ring-emerald-500/15"
                    : "bg-gray-300 ring-gray-300/20 dark:bg-gray-600 dark:ring-gray-600/20"
                }`}
              />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h3 class="text-base/7 font-semibold tracking-tight text-gray-950 dark:text-white">
                    {exp.companyName}
                  </h3>
                  <span class="shrink-0 font-mono text-[11px] text-gray-500">
                    {formatDateRange(exp)}
                  </span>
                </div>
                <p class="text-sm/6 font-medium text-sky-600 dark:text-sky-400">
                  {exp.role}
                  {exp.isCurrent && (
                    <span class="ml-2 font-mono text-[10px] tracking-widest text-emerald-600 uppercase dark:text-emerald-400">
                      current
                    </span>
                  )}
                </p>
                {exp.description && (
                  <p class="mt-1.5 text-sm/6 text-gray-600 dark:text-gray-400">
                    {exp.description}
                  </p>
                )}
              </div>
            </button>
          </li>
        ))
      }
    </ol>

    <!-- Map -->
    <div
      class="pattern border-t border-gray-950/5 p-2 lg:col-span-2 lg:border-t-0 lg:border-l dark:border-white/10"
      data-reveal
      style="--reveal-delay: 100ms"
    >
      <div class="frame lg:sticky lg:top-20">
        <div class="frame-inner h-[280px] w-full lg:h-[440px]">
          <MapCanvas client:only="react" markers={markers} center={mapCenter} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-entry[aria-pressed="true"] {
    background-color: rgb(3 7 18 / 0.035);
  }
  :global(html.dark) .exp-entry[aria-pressed="true"] {
    background-color: rgb(255 255 255 / 0.05);
  }
</style>

<script>
  // Clicking a timeline entry focuses its marker on the map.
  const initExperienceTimeline = () => {
    const entries = document.querySelectorAll<HTMLButtonElement>(".exp-entry");
    if (!entries.length) return;
    entries.forEach((entry) => {
      entry.addEventListener("click", () => {
        entries.forEach((e) => e.setAttribute("aria-pressed", "false"));
        entry.setAttribute("aria-pressed", "true");
        const markerId = Number(entry.dataset.markerId);
        if (!Number.isNaN(markerId)) {
          window.dispatchEvent(
            new CustomEvent("map-focus-marker", { detail: { markerId } }),
          );
        }
      });
    });
  };

  initExperienceTimeline();
  document.addEventListener("astro:page-load", initExperienceTimeline);
</script>
