---
import ResumeDownloadButton from "../ui/ResumeDownloadButton.astro";
import Annot from "../layout/Annot.astro";

interface Props {
    projectCount: number;
    yearsExperience: number;
}
const { projectCount, yearsExperience } = Astro.props;

// JSON "response" shown in the code window, one entry per rendered line so
// the gutter can number them like tailwindcss.com's editor panels.
type Tok = { t: string; c?: "key" | "str" | "num" | "punct" };
// `k` links a JSON line to the matching field in the rendered card, so
// hovering either side highlights both (tailwind's code ↔ preview pairing).
const stack = ["Node.js", "Hono", "Flutter", "Workers"];
const lines: { k?: string; toks: Tok[] }[] = [
    { toks: [{ t: "{", c: "punct" }] },
    { k: "name", toks: [{ t: '  "name"', c: "key" }, { t: ": " }, { t: '"Hafiz Bahtiar"', c: "str" }, { t: "," }] },
    { k: "role", toks: [{ t: '  "role"', c: "key" }, { t: ": " }, { t: '"Backend & Flutter developer"', c: "str" }, { t: "," }] },
    { k: "based_in", toks: [{ t: '  "based_in"', c: "key" }, { t: ": " }, { t: '"Kuala Lumpur, MY"', c: "str" }, { t: "," }] },
    {
        k: "stack",
        toks: [
            { t: '  "stack"', c: "key" },
            { t: ": [" },
            ...stack.flatMap((name, i) => [
                { t: `"${name}"`, c: "str" as const },
                { t: i < stack.length - 1 ? ", " : "" },
            ]),
            { t: "]," },
        ],
    },
    { k: "years_exp", toks: [{ t: '  "years_exp"', c: "key" }, { t: ": " }, { t: String(yearsExperience), c: "num" }, { t: "," }] },
    { k: "projects_shipped", toks: [{ t: '  "projects_shipped"', c: "key" }, { t: ": " }, { t: String(projectCount), c: "num" }, { t: "," }] },
    { k: "status", toks: [{ t: '  "status"', c: "key" }, { t: ": " }, { t: '"available_for_work"', c: "str" }] },
    { toks: [{ t: "}", c: "punct" }] },
];
const tokClass: Record<string, string> = {
    key: "text-pink-400",
    str: "text-sky-300",
    num: "text-amber-300",
    punct: "text-gray-500",
};
---

<section id="about" class="scroll-offset">
    <div class="h-16 sm:h-24 lg:h-32"></div>

    <Annot preset="display" class="hero-stagger" style="--stagger-i: 0" />
    <div class="line-y hero-stagger" style="--stagger-i: 1">
        <h1 class="display container-main">
            I build the systems behind the screens.
        </h1>
    </div>

    <Annot preset="hero-lead" class="mt-4 hero-stagger" style="--stagger-i: 2" />
    <div class="line-y hero-stagger" style="--stagger-i: 2">
        <p
            class="container-main max-w-4xl text-lg/8 font-medium text-gray-950 dark:text-white"
        >
            Backend &amp; Flutter developer in Kuala Lumpur with {yearsExperience}+
            years shipping production software - reliable APIs on
            <code class="token">Node.js</code>, <code class="token">Hono</code>
            and <code class="token">Workers</code>, mobile apps in
            <code class="token">Flutter</code>, and everything between idea and
            release.
        </p>
    </div>

    <div class="h-8 sm:h-12"></div>

    <div class="line-y hero-stagger" style="--stagger-i: 3">
        <div class="container-main flex flex-wrap items-center gap-3 py-0">
            <a href="#projects" class="btn-pill btn-pill-primary">View projects</a>
            <!-- tailwind's "Quick search" pill → copy-email pill -->
            <button
                type="button"
                id="hero-copy-email"
                data-email="hafiz@hafizbahtiar.com"
                class="group inline-flex w-full max-w-sm items-center gap-2 rounded-full px-4 py-2 text-left text-sm/6 text-gray-600 ring-1 ring-gray-950/10 ring-inset transition-colors hover:ring-gray-950/20 sm:w-80 dark:text-gray-400 dark:ring-white/15 dark:hover:ring-white/25"
            >
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
                </svg>
                <span class="flex-1 truncate">hafiz@hafizbahtiar.com</span>
                <kbd
                    data-copy-label
                    class="font-sans text-xs/4 text-gray-500 dark:text-gray-400"
                    >Copy</kbd
                >
            </button>
            <ResumeDownloadButton
                source="hero"
                class="btn-pill btn-pill-ghost"
            />
        </div>
    </div>

    <div class="h-16 sm:h-24"></div>

    <!-- Hero demo: JSON response (left) + the card it renders (right),
         overlapping like tailwindcss.com's code ↔ preview pair. -->
    <div class="line-y hero-stagger" style="--stagger-i: 4">
        <div
            id="hero-demo"
            class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]"
        >
            <div class="p-2">
                <div
                    class="h-full rounded-2xl bg-gray-950 p-1.5 ring-1 ring-gray-950/10 dark:bg-white/[0.04] dark:ring-white/10"
                >
                    <div class="flex items-center gap-2 px-2.5 py-2.5">
                        <span class="size-3 rounded-full bg-white/15"></span>
                        <span class="size-3 rounded-full bg-white/15"></span>
                        <span class="size-3 rounded-full bg-white/15"></span>
                        <span
                            class="ml-3 rounded-md bg-white/10 px-2 py-0.5 font-mono text-[11px] text-gray-300"
                            >GET /v1/profile</span
                        >
                        <span class="ml-auto font-mono text-[11px] text-emerald-400">200 OK</span>
                    </div>
                    <div
                        class="overflow-x-auto rounded-xl bg-white/[0.04] py-4 ring-1 ring-white/5"
                    >
                        <pre
                            class="font-mono text-[12.5px]/6 text-gray-200 sm:text-sm/7"><code>{lines.map((line, i) => (
<span class="demo-line flex" data-k={line.k}><span class="w-10 shrink-0 pr-4 text-right text-gray-600 select-none">{i + 1}</span><span class="pr-6">{line.toks.map((tok) => <span class={tok.c ? tokClass[tok.c] : ""}>{tok.t}</span>)}</span></span>))}</code></pre>
                    </div>
                </div>
            </div>

            <!-- Rendered output, in a bezel, pulled left over the editor -->
            <div
                class="pattern flex items-center justify-center border-t border-gray-950/5 p-6 sm:p-10 lg:border-t-0 lg:py-12 lg:pr-10 lg:pl-0 dark:border-white/10"
            >
                <div
                    class="relative z-10 w-full max-w-md rounded-[2rem] bg-gray-950/5 p-2 ring-1 ring-gray-950/10 ring-inset lg:-ml-36 dark:bg-white/10 dark:ring-white/10"
                >
                    <div
                        class="rounded-3xl bg-white p-6 shadow-xl shadow-gray-950/5 ring-1 ring-gray-950/5 sm:p-7 dark:bg-gray-950 dark:shadow-none dark:ring-white/10"
                    >
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span
                                    class="flex size-12 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-sky-400 to-indigo-500 text-base font-semibold text-white"
                                    aria-hidden="true">HB</span
                                >
                                <div class="min-w-0">
                                    <p data-f="name" class="demo-field text-lg/7 font-semibold tracking-tight text-gray-950 dark:text-white">
                                        Hafiz Bahtiar
                                    </p>
                                    <p data-f="role" class="demo-field text-sm/6 font-medium text-sky-600 dark:text-sky-400">
                                        Backend &amp; Flutter developer
                                    </p>
                                </div>
                            </div>
                            <span
                                data-f="status"
                                class="demo-field inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs/5 font-medium text-emerald-700 dark:text-emerald-400"
                            >
                                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
                                Available
                            </span>
                        </div>

                        <p data-f="based_in" class="demo-field mt-4 inline-flex items-center gap-1.5 text-sm/6 text-gray-600 dark:text-gray-400">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
                            </svg>
                            Kuala Lumpur, MY
                        </p>

                        <div data-f="stack" class="demo-field mt-4 flex flex-wrap gap-1.5">
                            {stack.map((name) => <span class="tag">{name}</span>)}
                        </div>

                        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-gray-950/5 ring-1 ring-gray-950/5 dark:bg-white/10 dark:ring-white/10">
                            <div data-f="years_exp" class="demo-field bg-white px-4 py-3 dark:bg-gray-950">
                                <dt class="font-mono text-[11px] tracking-widest text-gray-500 uppercase">Years</dt>
                                <dd class="mt-1 text-3xl font-medium tracking-tighter text-gray-950 dark:text-white">{yearsExperience}+</dd>
                            </div>
                            <div data-f="projects_shipped" class="demo-field bg-white px-4 py-3 dark:bg-gray-950">
                                <dt class="font-mono text-[11px] tracking-widest text-gray-500 uppercase">Shipped</dt>
                                <dd class="mt-1 text-3xl font-medium tracking-tighter text-gray-950 dark:text-white">{projectCount}</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .demo-line.is-hl {
        background-color: rgb(255 255 255 / 0.07);
        box-shadow: inset 2px 0 0 var(--color-sky-400);
    }
    .demo-field {
        border-radius: 0.375rem;
        transition: outline-color 150ms;
        outline: 1px dashed transparent;
        outline-offset: 3px;
    }
    .demo-field.is-hl {
        outline-color: var(--color-sky-500);
    }
</style>

<script>
    // Hovering a JSON line highlights the card field it renders, and back.
    const initHeroDemo = () => {
        const demo = document.getElementById("hero-demo");
        if (!demo || demo.dataset.bound === "1") return;
        demo.dataset.bound = "1";
        const set = (key: string | undefined, on: boolean) => {
            if (!key) return;
            demo
                .querySelectorAll(`[data-k="${key}"], [data-f="${key}"]`)
                .forEach((el) => el.classList.toggle("is-hl", on));
        };
        demo.querySelectorAll<HTMLElement>("[data-k], [data-f]").forEach((el) => {
            const key = el.dataset.k ?? el.dataset.f;
            el.addEventListener("mouseenter", () => set(key, true));
            el.addEventListener("mouseleave", () => set(key, false));
        });
    };
    initHeroDemo();
    document.addEventListener("astro:page-load", initHeroDemo);

    const initCopyEmail = () => {
        const btn = document.getElementById("hero-copy-email");
        if (!btn || btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        btn.addEventListener("click", async () => {
            const email = btn.dataset.email ?? "";
            try {
                await navigator.clipboard.writeText(email);
                if (label) label.textContent = "Copied";
            } catch {
                window.location.href = `mailto:${email}`;
                return;
            }
            window.setTimeout(() => {
                if (label) label.textContent = "Copy";
            }, 1600);
        });
    };
    initCopyEmail();
    document.addEventListener("astro:page-load", initCopyEmail);
</script>
