---
import { ArrowRight, Check, Github, Linkedin, LoaderCircle } from "lucide-react";
import ResumeDownloadButton from "../ui/ResumeDownloadButton.astro";
import SectionHeader from "../layout/SectionHeader.astro";

// Cloudflare Turnstile (invisible until a challenge is needed). This site key is
// public; keep it as a fallback so production contact submissions still work
// when build-time env is absent.
const DEFAULT_TURNSTILE_SITE_KEY = "0x4AAAAAAFD-PSk_u7NHAF-5";
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || DEFAULT_TURNSTILE_SITE_KEY;
---

<section id="contact" class="scroll-offset">
  <div class="section-gap"></div>
  <SectionHeader
    eyebrow="Contact"
    title="Let's build something reliable."
    description="Have a role, a project, or a system that needs to scale? I usually reply within a day."
  />
  <div class="h-10"></div>

  <div class="line-y" data-reveal>
    <div class="divided-grid grid-cols-1 md:grid-cols-5">
      <!-- Direct channels -->
      <div
        class="flex flex-col justify-between gap-10 px-4 py-8 sm:px-6 md:col-span-2"
      >
        <div>
          <p class="eyebrow">Direct</p>
          <a
            href="mailto:hafiz@hafizbahtiar.com"
            class="mt-3 block text-lg/7 font-medium tracking-tight break-all text-gray-950 transition-colors hover:text-sky-600 dark:text-white dark:hover:text-sky-400"
          >
            hafiz@hafizbahtiar.com
          </a>
          <p class="mt-1 text-sm/6 text-gray-500">
            Kuala Lumpur, Malaysia (GMT+8)
          </p>
          <ResumeDownloadButton
            source="contact"
            class="btn-pill btn-pill-ghost mt-6"
          />
        </div>

        <div class="flex gap-4">
          <a
            href="https://github.com/hafizbahtiar"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 transition-colors hover:text-gray-950 dark:text-gray-500 dark:hover:text-white"
            aria-label="GitHub"
          >
            <Github className="h-5 w-5" aria-hidden="true" />
          </a>
          <a
            href="https://www.linkedin.com/in/hafizbahtiar/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 transition-colors hover:text-gray-950 dark:text-gray-500 dark:hover:text-white"
            aria-label="LinkedIn"
          >
            <Linkedin className="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Form -->
      <div class="px-4 py-8 sm:px-6 md:col-span-3">
        <!-- Success view -->
        <div
          id="contact-success"
          class="hidden flex-col items-center justify-center text-center gap-4 py-10"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/10 ring-1 ring-emerald-500/25 ring-inset"
          >
            <Check className="w-6 h-6 text-emerald-600 dark:text-emerald-400" />
          </div>
          <div>
            <h3
              class="text-lg font-semibold tracking-tight text-gray-950 dark:text-white"
            >
              Message sent
            </h3>
            <p
              class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400"
              id="contact-success-message"
            >
              Thanks - I'll get back to you soon.
            </p>
          </div>
          <button
            id="contact-send-another"
            type="button"
            class="btn-pill btn-pill-ghost"
          >
            Send another
          </button>
        </div>

        <form
          id="contact-form"
          class="space-y-4"
          novalidate
          data-turnstile-site-key={turnstileSiteKey || undefined}
        >
          <div
            id="contact-status"
            class="hidden rounded-lg bg-red-500/10 p-3 text-sm/6 text-red-700 ring-1 ring-red-500/20 ring-inset dark:text-red-400"
            role="alert"
          >
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="contact-name"
                class="mb-1.5 block text-sm/6 font-medium text-gray-950 dark:text-white"
                >Name</label
              >
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                maxlength="200"
                autocomplete="name"
                placeholder="Your name"
                class="field"
              />
            </div>
            <div>
              <label
                for="contact-email"
                class="mb-1.5 block text-sm/6 font-medium text-gray-950 dark:text-white"
                >Email</label
              >
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                maxlength="255"
                autocomplete="email"
                placeholder="you@example.com"
                class="field"
              />
            </div>
          </div>

          <!-- Honeypot - invisible to people, irresistible to bots -->
          <div class="hidden" aria-hidden="true">
            <label for="contact-company">Company</label>
            <input
              type="text"
              id="contact-company"
              name="company"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div>
            <label
              for="contact-message"
              data-required
              class="mb-1.5 block text-sm/6 font-medium text-gray-950 dark:text-white"
              >Message</label
            >
            <div class="relative">
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                maxlength="2500"
                placeholder="Tell me about your project or role…"
                class="field resize-none pb-8"></textarea>
              <span
                id="contact-char-count"
                class="absolute right-3 bottom-2.5 font-mono text-[11px] text-gray-400 dark:text-gray-500"
                >0 / 2500</span
              >
            </div>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="btn-pill btn-pill-primary w-full sm:w-auto"
          >
            Send message
            <ArrowRight className="w-4 h-4" />
          </button>

          {
            turnstileSiteKey && (
              <div id="turnstile-contact" class="flex justify-center" />
            )
          }

          {
            turnstileSiteKey && (
              <p class="text-[11px]/5 text-gray-500">
                Protected by Cloudflare Turnstile - the Cloudflare{" "}
                <a
                  href="https://www.cloudflare.com/privacypolicy/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-gray-950 dark:hover:text-white"
                >
                  Privacy Policy
                </a>{" "}
                applies.
              </p>
            )
          }
        <template id="icon-spinner"><LoaderCircle className="h-4 w-4 animate-spin" /></template>
</form>
      </div>
    </div>
  </div>
</section>

{
  // Turnstile: explicit rendering, so the page keeps the widget id and can
  // reset it between attempts (tokens are single-use).
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}

<script>
  import { submitContactForm } from "../../lib/contact";

  // Turnstile state lives at module scope so it survives the section's
  // re-inits (astro:page-load) and one submit -> reset cycle.
  let turnstileWidgetId: string | null = null;
  let pendingTurnstile: ((token: string) => void) | null = null;
  // The widget can finish before the visitor submits, so the token is kept
  // rather than only handed to a pending submit.
  let turnstileToken = "";

  // A challenge that never calls back must not leave the button spinning.
  const TURNSTILE_TIMEOUT_MS = 15_000;

  const settleTurnstile = (token: string) => {
    const resolve = pendingTurnstile;
    pendingTurnstile = null;
    resolve?.(token);
  };

  const resetTurnstile = () => {
    pendingTurnstile = null;
    turnstileToken = "";
    const turnstile = (window as any).turnstile;
    if (turnstileWidgetId && turnstile?.reset) {
      turnstile.reset(turnstileWidgetId);
    }
  };

  const initContactSection = () => {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    const submitBtn = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;
    const statusEl = document.getElementById("contact-status");
    const successEl = document.getElementById("contact-success");
    const successMessageEl = document.getElementById("contact-success-message");
    const sendAnotherBtn = document.getElementById("contact-send-another");
    const messageInput = document.getElementById(
      "contact-message",
    ) as HTMLTextAreaElement | null;
    const charCount = document.getElementById("contact-char-count");
    if (!form || !submitBtn) return;

    const turnstileSiteKey = form.dataset.turnstileSiteKey || "";
    const turnstileContainer = document.getElementById("turnstile-contact");

    // A View Transition replaces the container, which drops the old widget.
    if (turnstileContainer && !turnstileContainer.querySelector("iframe")) {
      turnstileWidgetId = null;
    }

    // Explicit render: the page keeps the widget id so each attempt can
    // execute, then reset (tokens are single-use). The challenge is only
    // visible when Cloudflare asks for interaction.
    const renderTurnstile = () => {
      const turnstile = (window as any).turnstile;
      if (!turnstileContainer || !turnstileSiteKey || turnstileWidgetId) return;
      if (!turnstile?.render) return;
      turnstileWidgetId = turnstile.render(turnstileContainer, {
        sitekey: turnstileSiteKey,
        action: "contact",
        execution: "execute",
        appearance: "interaction-only",
        callback: (token: string) => {
          turnstileToken = token || "";
          settleTurnstile(turnstileToken);
        },
        "error-callback": () => settleTurnstile(""),
      });
    };

    // The loader is async and can land after this script, so poll briefly
    // rather than depend on a global onload callback.
    if (turnstileSiteKey && !turnstileWidgetId) {
      if ((window as any).turnstile?.render) {
        renderTurnstile();
      } else {
        let tries = 0;
        const timer = setInterval(() => {
          if ((window as any).turnstile?.render) {
            clearInterval(timer);
            renderTurnstile();
          } else if (++tries > 100) {
            clearInterval(timer);
          }
        }, 100);
      }
    }

    // One token per attempt. Resolves to "" when the challenge cannot run.
    const executeTurnstile = (): Promise<string> =>
      new Promise((resolve) => {
        const turnstile = (window as any).turnstile;
        if (!turnstileSiteKey || !turnstileWidgetId || !turnstile?.execute) {
          resolve("");
          return;
        }

        // A token that arrived before this submit is still valid and single-use:
        // consume it instead of executing again (executing on a finished widget
        // never calls back).
        if (turnstileToken) {
          const token = turnstileToken;
          turnstileToken = "";
          resolve(token);
          return;
        }

        const existing = turnstile.getResponse?.(turnstileWidgetId);
        if (existing) {
          resolve(existing);
          return;
        }

        let settled = false;
        const finish = (token: string) => {
          if (settled) return;
          settled = true;
          clearTimeout(timer);
          resolve(token);
        };
        const timer = setTimeout(() => finish(""), TURNSTILE_TIMEOUT_MS);

        pendingTurnstile = finish;
        try {
          turnstile.execute(turnstileWidgetId);
        } catch {
          settleTurnstile("");
        }
      });

    const existingController = (window as any).__contactController;
    if (existingController) existingController.abort();
    const controller = new AbortController();
    (window as any).__contactController = controller;
    const { signal } = controller;

    const showError = (message: string) => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.remove("hidden");
    };

    messageInput?.addEventListener(
      "input",
      () => {
        if (charCount)
          charCount.textContent = `${messageInput.value.length} / 2500`;
      },
      { signal },
    );

    sendAnotherBtn?.addEventListener(
      "click",
      () => {
        successEl?.classList.add("hidden");
        successEl?.classList.remove("flex");
        form.classList.remove("hidden");
        form.reset();
        if (charCount) charCount.textContent = "0 / 2500";
      },
      { signal },
    );

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();
        statusEl?.classList.add("hidden");

        const formData = new FormData(form);
        const honeypot = ((formData.get("company") as string) || "").trim();
        const data: {
          name: string;
          email: string;
          message: string;
          source: string;
          captchaToken?: string;
        } = {
          name: ((formData.get("name") as string) || "").trim(),
          email: ((formData.get("email") as string) || "").trim(),
          message: ((formData.get("message") as string) || "").trim(),
          source: "FORM",
        };

        if (!data.name || !data.email || !data.message) {
          showError("Please fill in your name, email, and message.");
          return;
        }

        // Bots that fill the hidden field get a quiet success - nothing sent.
        if (honeypot) {
          form.classList.add("hidden");
          successEl?.classList.remove("hidden");
          successEl?.classList.add("flex");
          return;
        }

        const originalContent = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          ${document.getElementById("icon-spinner")?.innerHTML ?? ""}
          Sending…`;

        try {
          if (turnstileSiteKey) {
            const token = await executeTurnstile();
            if (!token) {
              showError(
                "Couldn't run the spam check. Please reload and try again, or email me directly.",
              );
              return;
            }
            data.captchaToken = token;
          }

          const result = await submitContactForm(data);
          if (result.success) {
            form.classList.add("hidden");
            successEl?.classList.remove("hidden");
            successEl?.classList.add("flex");
            if (successMessageEl && result.message) {
              successMessageEl.textContent = result.message;
            }
          } else {
            showError(
              result.error || "Something went wrong. Please try again.",
            );
          }
        } catch {
          showError("Something went wrong. Please email me directly instead.");
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalContent;
          resetTurnstile();
        }
      },
      { signal },
    );
  };

  initContactSection();
  document.addEventListener("astro:page-load", initContactSection);
</script>
