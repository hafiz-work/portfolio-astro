---
/**
 * ⌘K / Ctrl+K quick search (tailwindcss.com's navbar search pill).
 * Static index of pages, homepage sections and actions - no API calls, so
 * it works on prerendered pages too. Opened by any [data-cmdk-open] button.
 */
type Item = {
  group: "Pages" | "Sections" | "Actions";
  label: string;
  hint: string;
  href?: string;
  action?: "copy-email";
  external?: boolean;
  keywords?: string;
};

const items: Item[] = [
  { group: "Pages", label: "Home", hint: "/", href: "/" },
  { group: "Pages", label: "Projects", hint: "/projects", href: "/projects", keywords: "work portfolio case study" },
  { group: "Pages", label: "Blog", hint: "/blog", href: "/blog", keywords: "notes writing posts" },
  { group: "Sections", label: "About", hint: "/#about", href: "/#about", keywords: "hero intro" },
  { group: "Sections", label: "GitHub activity", hint: "/#github-activity", href: "/#github-activity", keywords: "contributions" },
  { group: "Sections", label: "Stack", hint: "/#skills", href: "/#skills", keywords: "skills tech tools backend mobile" },
  { group: "Sections", label: "Experience", hint: "/#experience", href: "/#experience", keywords: "jobs career map timeline" },
  { group: "Sections", label: "Contact", hint: "/#contact", href: "/#contact", keywords: "hire email message form" },
  { group: "Actions", label: "Copy email address", hint: "hafiz@hafizbahtiar.com", action: "copy-email", keywords: "mail" },
  { group: "Actions", label: "Download resume", hint: "PDF", href: "/docs/hafizbahtiar-resume-4-3.pdf", keywords: "cv" },
  { group: "Actions", label: "GitHub", hint: "github.com/hafizbahtiar", href: "https://github.com/hafizbahtiar", external: true, keywords: "code" },
  { group: "Actions", label: "LinkedIn", hint: "linkedin.com/in/hafizbahtiar", href: "https://www.linkedin.com/in/hafizbahtiar/", external: true },
];
const groups = ["Pages", "Sections", "Actions"] as const;
---

<dialog
  id="cmdk"
  aria-label="Quick search"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-gray-950/25 backdrop:backdrop-blur-[2px] dark:backdrop:bg-black/50"
>
  <div class="flex h-full items-start justify-center px-4 pt-[12vh]" data-cmdk-backdrop>
    <div
      class="w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-gray-950/10 dark:bg-gray-900 dark:ring-white/10"
    >
      <div class="flex items-center gap-3 border-b border-gray-950/5 px-4 dark:border-white/10">
        <svg class="h-5 w-5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"></path>
        </svg>
        <input
          id="cmdk-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search pages, sections, actions…"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmdk-list"
          class="h-14 flex-1 bg-transparent text-base/6 text-gray-950 outline-none placeholder:text-gray-400 dark:text-white"
        />
        <kbd class="rounded-md px-1.5 font-sans text-xs/5 text-gray-500 ring-1 ring-gray-950/10 dark:text-gray-400 dark:ring-white/15">Esc</kbd>
      </div>

      <ul id="cmdk-list" role="listbox" class="max-h-[min(60vh,26rem)] overflow-y-auto p-2">
        {
          groups.map((group) => (
            <li role="presentation" data-cmdk-group={group}>
              <p class="px-3 pt-3 pb-1 font-mono text-[11px] font-semibold tracking-widest text-gray-500 uppercase">
                {group}
              </p>
              <ul role="presentation">
                {items
                  .filter((item) => item.group === group)
                  .map((item) => (
                    <li
                      role="option"
                      aria-selected="false"
                      data-cmdk-item
                      data-group={group}
                      data-href={item.href}
                      data-action={item.action}
                      data-external={item.external ? "1" : undefined}
                      data-search={`${item.label} ${item.hint} ${item.keywords ?? ""}`.toLowerCase()}
                      class="flex cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-2 text-sm/6 text-gray-950 aria-selected:bg-gray-950/5 dark:text-white dark:aria-selected:bg-white/10"
                    >
                      <span data-cmdk-label>{item.label}</span>
                      <span class="truncate font-mono text-xs text-gray-500">{item.hint}</span>
                    </li>
                  ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p id="cmdk-empty" class="hidden px-4 py-10 text-center text-sm text-gray-500">No results.</p>
    </div>
  </div>
</dialog>

<script>
  const initCommandPalette = () => {
    const dialog = document.getElementById("cmdk") as HTMLDialogElement | null;
    const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
    const empty = document.getElementById("cmdk-empty");
    if (!dialog || !input) return;

    const existing = (window as any).__cmdkController;
    if (existing) existing.abort();
    const controller = new AbortController();
    (window as any).__cmdkController = controller;
    const { signal } = controller;

    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll("[data-cmdk-kbd]").forEach((k) => {
      k.textContent = isMac ? "⌘K" : "Ctrl K";
    });

    const allItems = Array.from(dialog.querySelectorAll<HTMLElement>("[data-cmdk-item]"));
    let visible: HTMLElement[] = allItems;
    let active = 0;

    const highlight = (index: number) => {
      active = Math.max(0, Math.min(index, visible.length - 1));
      allItems.forEach((el) => el.setAttribute("aria-selected", "false"));
      const el = visible[active];
      if (el) {
        el.setAttribute("aria-selected", "true");
        el.scrollIntoView({ block: "nearest" });
      }
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      visible = allItems.filter((el) => {
        const match = !q || q.split(/\s+/).every((w) => el.dataset.search!.includes(w));
        el.hidden = !match;
        return match;
      });
      dialog.querySelectorAll<HTMLElement>("[data-cmdk-group]").forEach((g) => {
        g.hidden = !g.querySelector("[data-cmdk-item]:not([hidden])");
      });
      empty?.classList.toggle("hidden", visible.length > 0);
      highlight(0);
    };

    const open = () => {
      if (dialog.open) return;
      input.value = "";
      filter();
      dialog.showModal();
      input.focus();
    };
    const close = () => dialog.open && dialog.close();

    const run = async (el: HTMLElement | undefined) => {
      if (!el) return;
      const { href, action, external } = el.dataset;
      close();
      if (action === "copy-email") {
        try {
          await navigator.clipboard.writeText("hafiz@hafizbahtiar.com");
        } catch {
          window.location.href = "mailto:hafiz@hafizbahtiar.com";
        }
        return;
      }
      if (!href) return;
      if (external) {
        window.open(href, "_blank", "noopener,noreferrer");
      } else if (href.startsWith("/#") && window.location.pathname === "/") {
        document.querySelector(href.slice(1))?.scrollIntoView({ behavior: "smooth" });
      } else {
        window.location.href = href;
      }
    };

    document.querySelectorAll("[data-cmdk-open]").forEach((btn) =>
      btn.addEventListener("click", open, { signal }),
    );

    document.addEventListener(
      "keydown",
      (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          dialog.open ? close() : open();
        }
      },
      { signal },
    );

    input.addEventListener("input", filter, { signal });
    input.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          highlight(active + 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          highlight(active - 1);
        } else if (e.key === "Enter") {
          e.preventDefault();
          run(visible[active]);
        }
      },
      { signal },
    );

    allItems.forEach((el) => {
      el.addEventListener("mousemove", () => highlight(visible.indexOf(el)), { signal });
      el.addEventListener("click", () => run(el), { signal });
    });

    // Click outside the panel closes it.
    dialog.addEventListener(
      "click",
      (e) => {
        if ((e.target as HTMLElement).hasAttribute("data-cmdk-backdrop") || e.target === dialog) close();
      },
      { signal },
    );
  };

  initCommandPalette();
  document.addEventListener("astro:page-load", initCommandPalette);
</script>
