---
import { Image } from "astro:assets";
import CommandPalette from "./CommandPalette.astro";

const links = [
    { text: "Projects", href: "/projects", reload: false, spy: "projects" },
    { text: "Stack", href: "/#skills", reload: true, spy: "skills" },
    { text: "Experience", href: "/#experience", reload: true, spy: "experience" },
    { text: "Blog", href: "/blog", reload: false, spy: "blog" },
];

// tailwind's "Plus" link: dashed box with a tiny "+" on each corner.
const corners = [
    "-top-[3px] -left-[3px]",
    "-top-[3px] -right-[3px]",
    "-bottom-[3px] -left-[3px]",
    "-bottom-[3px] -right-[3px]",
];
---

<!-- tailwindcss.com line: flat, full-width, hairline bottom, sticky. -->
<nav
    id="main-nav"
    class="sticky top-0 z-50 w-full [overflow-x:clip] bg-canvas/95 backdrop-blur-sm dark:bg-pub-dark/95"
>
    <div
        class="line-b flex h-14 items-center justify-between gap-4 px-4 sm:px-6"
    >
        <div class="flex items-center gap-3">
            <a
                href="/"
                data-astro-reload
                class="inline-flex items-center"
                aria-label="Hafiz Bahtiar - home"
            >
                <Image
                    src="/brand/wordmark.svg"
                    alt="hafizbahtiar"
                    width={383}
                    height={120}
                    loading="eager"
                    class="h-11 w-auto"
                />
            </a>
            <!-- tailwind's "v4.3" pill → availability -->
            <span
                class="hidden items-center gap-1.5 rounded-full bg-gray-950/5 px-2.5 py-0.5 text-xs/5 font-medium text-gray-700 sm:inline-flex dark:bg-white/10 dark:text-gray-300"
            >
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Available
            </span>
        </div>

        <div class="flex items-center gap-1 md:gap-6">
            <!-- ⌘K search pill (desktop) / icon (mobile) -->
            <button
                type="button"
                data-cmdk-open
                class="hidden items-center gap-1.5 rounded-full bg-gray-950/[0.03] px-2.5 py-1 text-gray-500 ring-1 ring-gray-950/5 ring-inset transition-colors hover:text-gray-950 md:inline-flex dark:bg-white/5 dark:text-gray-400 dark:ring-white/10 dark:hover:text-white"
                aria-label="Search (⌘K)"
            >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"></path>
                </svg>
                <kbd class="font-sans text-xs/5" data-cmdk-kbd>⌘K</kbd>
            </button>
            <button
                type="button"
                data-cmdk-open
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-gray-950 hover:bg-gray-950/5 md:hidden dark:text-white dark:hover:bg-white/10"
                aria-label="Search"
            >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"></path>
                </svg>
            </button>

            <div class="hidden items-center gap-6 md:flex" id="navbar-default">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            data-astro-reload={link.reload ? true : undefined}
                            data-spy={link.spy}
                            class="nav-link text-sm/6 text-gray-600 transition-colors hover:text-gray-950 dark:text-gray-300 dark:hover:text-white"
                        >
                            {link.text}
                        </a>
                    ))
                }
                <a
                    href="/#contact"
                    data-astro-reload
                    data-spy="contact"
                    class="relative inline-flex items-center bg-sky-400/10 px-2 text-sm/6 font-medium text-sky-700 transition-colors hover:bg-sky-400/20 dark:text-sky-300"
                >
                    Contact
                    <span
                        class="pointer-events-none absolute inset-0 border border-dashed border-sky-500/50 dark:border-sky-300/40"
                        aria-hidden="true"></span>
                    {
                        corners.map((pos) => (
                            <svg
                                class={`pointer-events-none absolute size-[5px] text-sky-600 dark:text-sky-300 ${pos}`}
                                viewBox="0 0 5 5"
                                aria-hidden="true"
                            >
                                <path d="M2.5 0v5M0 2.5h5" stroke="currentColor" stroke-width="1" />
                            </svg>
                        ))
                    }
                </a>
                <a
                    href="https://github.com/hafizbahtiar"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                    class="text-gray-950 transition-colors hover:text-gray-600 dark:text-white dark:hover:text-gray-300"
                >
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            fill-rule="evenodd"
                            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                            clip-rule="evenodd"></path>
                    </svg>
                </a>
            </div>

            <!-- Hamburger (mobile) -->
            <button
                id="navbar-toggle"
                type="button"
                class="-mr-1.5 inline-flex h-9 w-9 items-center justify-center rounded-full text-gray-950 hover:bg-gray-950/5 md:hidden dark:text-white dark:hover:bg-white/10"
                aria-controls="mobile-menu"
                aria-expanded="false"
            >
                <span class="sr-only">Open main menu</span>
                <svg id="nav-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
                </svg>
                <svg id="nav-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile menu: full-width sheet under the bar, hairline rows -->
    <div
        id="mobile-menu"
        class="line-b grid grid-rows-[0fr] bg-canvas transition-[grid-template-rows] duration-300 ease-out md:hidden dark:bg-pub-dark"
    >
        <div class="min-h-0 overflow-hidden">
            <div class="flex flex-col py-2">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            data-astro-reload={link.reload ? true : undefined}
                            class="px-4 py-2.5 text-base/7 font-medium text-gray-950 hover:bg-gray-950/[0.025] sm:px-6 dark:text-white dark:hover:bg-white/5"
                        >
                            {link.text}
                        </a>
                    ))
                }
                <a
                    href="/#contact"
                    data-astro-reload
                    class="px-4 py-2.5 text-base/7 font-medium text-sky-700 hover:bg-gray-950/[0.025] sm:px-6 dark:text-sky-300 dark:hover:bg-white/5"
                >
                    Contact
                </a>
                <a
                    href="https://github.com/hafizbahtiar"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2.5 text-base/7 font-medium text-gray-950 hover:bg-gray-950/[0.025] sm:px-6 dark:text-white dark:hover:bg-white/5"
                >
                    GitHub
                </a>
            </div>
        </div>
    </div>
</nav>

<CommandPalette />

<style>
    /* Active link (scroll-spy / current page) */
    .nav-link[aria-current] {
        color: var(--color-gray-950);
        font-weight: 500;
    }
    :global(html.dark) .nav-link[aria-current] {
        color: var(--color-white);
    }

    /* Mobile menu open state */
    #mobile-menu:not(.is-open)::after {
        display: none;
    }
    #mobile-menu.is-open {
        grid-template-rows: 1fr;
    }

    @media (prefers-reduced-motion: reduce) {
        #mobile-menu {
            transition: none;
        }
    }
</style>

<script>
    const initNavbar = () => {
        const nav = document.getElementById("main-nav");
        const toggleBtn = document.getElementById("navbar-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const iconOpen = document.getElementById("nav-icon-open");
        const iconClose = document.getElementById("nav-icon-close");

        if (!nav || !toggleBtn || !mobileMenu) return;

        const existingController = (window as any).__navbarController;
        if (existingController) existingController.abort();

        const controller = new AbortController();
        (window as any).__navbarController = controller;
        const { signal } = controller;

        // ── Mobile menu ──────────────────────────────────────────────
        const setMenu = (open: boolean) => {
            mobileMenu.classList.toggle("is-open", open);
            toggleBtn.setAttribute("aria-expanded", String(open));
            iconOpen?.classList.toggle("hidden", open);
            iconClose?.classList.toggle("hidden", !open);
        };

        toggleBtn.addEventListener(
            "click",
            () => setMenu(!mobileMenu.classList.contains("is-open")),
            { signal },
        );

        document.addEventListener(
            "click",
            (e) => {
                if (!nav.contains(e.target as Node)) setMenu(false);
            },
            { signal },
        );

        document.addEventListener(
            "keydown",
            (e) => {
                if (e.key === "Escape") setMenu(false);
            },
            { signal },
        );

        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => setMenu(false), { signal });
        });

        // ── Active link: current page + homepage scroll-spy ──────────
        const spyLinks =
            document.querySelectorAll<HTMLAnchorElement>("[data-spy]");
        const setActive = (key: string | null) => {
            spyLinks.forEach((a) => {
                if (a.dataset.spy === key) {
                    a.setAttribute("aria-current", "true");
                } else {
                    a.removeAttribute("aria-current");
                }
            });
        };

        if (window.location.pathname.startsWith("/projects")) {
            setActive("projects");
        } else if (window.location.pathname.startsWith("/blog")) {
            setActive("blog");
        } else if (window.location.pathname === "/") {
            const sections = ["projects", "skills", "experience", "contact"]
                .map((id) => document.getElementById(id))
                .filter((el): el is HTMLElement => el !== null);

            const spyObserver = new IntersectionObserver(
                (entries) => {
                    // Pick the most visible intersecting section.
                    const visible = entries
                        .filter((e) => e.isIntersecting)
                        .sort(
                            (a, b) =>
                                b.intersectionRatio - a.intersectionRatio,
                        )[0];
                    if (visible) {
                        setActive(visible.target.id);
                    } else if (window.scrollY < 200) {
                        setActive(null);
                    }
                },
                { rootMargin: "-25% 0px -55% 0px", threshold: [0, 0.2, 0.5] },
            );
            sections.forEach((s) => spyObserver.observe(s));
            signal.addEventListener("abort", () => spyObserver.disconnect());
        }

        // Smooth-scroll hash anchors when already on home page
        document
            .querySelectorAll<HTMLAnchorElement>('a[href^="/#"]')
            .forEach((anchor) => {
                anchor.addEventListener(
                    "click",
                    (e) => {
                        if (window.location.pathname === "/") {
                            e.preventDefault();
                            const hash = anchor.getAttribute("href")!.slice(1);
                            document
                                .querySelector(hash)
                                ?.scrollIntoView({ behavior: "smooth" });
                        }
                    },
                    { signal },
                );
            });
    };

    initNavbar();
    document.addEventListener("astro:page-load", initNavbar);
    document.addEventListener("astro:after-swap", initNavbar);
    window.addEventListener("pageshow", (e) => {
        if (e.persisted) initNavbar();
    });
</script>
