---
const currentYear = new Date().getFullYear();

// tailwindcss.com footer: three link columns split by thin gutter strips.
const columns = [
    {
        title: "Hafiz Bahtiar",
        links: [
            { text: "About", href: "/#about" },
            { text: "Projects", href: "/projects" },
            { text: "Experience", href: "/#experience" },
            { text: "Contact", href: "/#contact" },
        ],
    },
    {
        title: "Writing",
        links: [
            { text: "Blog", href: "/blog" },
            { text: "Resume (PDF)", href: "/docs/hafizbahtiar-resume-4-3.pdf" },
        ],
    },
    {
        title: "Elsewhere",
        links: [
            { text: "GitHub", href: "https://github.com/hafizbahtiar", external: true },
            { text: "LinkedIn", href: "https://www.linkedin.com/in/hafizbahtiar/", external: true },
            { text: "Email", href: "mailto:hafiz@hafizbahtiar.com" },
        ],
    },
];
---

<footer class="line-t">
    <div class="section-gap"></div>
    <div
        class="line-y grid grid-cols-1 sm:grid-cols-[1fr_var(--gutter-width)_1fr_var(--gutter-width)_1fr]"
    >
        {
            columns.map((column, index) => (
                <>
                    {index > 0 && (
                        <div
                            class="hidden border-x border-(--pattern-fg) sm:block"
                            aria-hidden="true"
                        />
                    )}
                    <div class="px-4 py-8 sm:px-6 sm:py-12">
                        <h3 class="text-sm/6 font-semibold text-gray-950 dark:text-white">
                            {column.title}
                        </h3>
                        <ul class="mt-4 flex flex-col gap-3 sm:mt-6 sm:gap-4">
                            {column.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target={link.external ? "_blank" : undefined}
                                        rel={link.external ? "noopener noreferrer" : undefined}
                                        class="text-sm/6 text-gray-700 transition-colors hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
                                    >
                                        {link.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </>
            ))
        }
    </div>

    <div
        class="flex flex-col-reverse items-start justify-between gap-6 px-4 py-10 sm:flex-row sm:items-center sm:px-6 sm:py-14"
    >
        <!-- Theme switcher: system / light / dark -->
        <div
            id="theme-switcher"
            role="radiogroup"
            aria-label="Theme"
            class="relative z-0 inline-grid grid-cols-3 gap-0.5 rounded-full bg-gray-950/5 p-0.75 text-gray-950 dark:bg-white/10 dark:text-white"
        >
            <!-- Sliding thumb (Flutter-style segmented control) -->
            <span class="theme-thumb" aria-hidden="true"></span>
            <button
                type="button"
                role="radio"
                data-theme-value="system"
                aria-label="System theme"
                class="theme-opt rounded-full p-1.5 *:size-4.5 sm:p-0"
            >
                <svg viewBox="0 0 28 28" fill="none"><path d="M7.5 8.5C7.5 7.94772 7.94772 7.5 8.5 7.5H19.5C20.0523 7.5 20.5 7.94772 20.5 8.5V16.5C20.5 17.0523 20.0523 17.5 19.5 17.5H8.5C7.94772 17.5 7.5 17.0523 7.5 16.5V8.5Z" stroke="currentColor"></path><path d="M7.5 8.5C7.5 7.94772 7.94772 7.5 8.5 7.5H19.5C20.0523 7.5 20.5 7.94772 20.5 8.5V14.5C20.5 15.0523 20.0523 15.5 19.5 15.5H8.5C7.94772 15.5 7.5 15.0523 7.5 14.5V8.5Z" stroke="currentColor"></path><path d="M16.5 20.5V17.5H11.5V20.5M16.5 20.5L11.5 20.5M16.5 20.5H17.5M11.5 20.5H10.5" stroke="currentColor" stroke-linecap="round"></path></svg>
            </button>
            <button
                type="button"
                role="radio"
                data-theme-value="light"
                aria-label="Light theme"
                class="theme-opt rounded-full p-1.5 *:size-4.5 sm:p-0"
            >
                <svg viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="3.5" stroke="currentColor"></circle><path d="M14 8.5V6.5" stroke="currentColor" stroke-linecap="round"></path><path d="M17.889 10.1115L19.3032 8.69727" stroke="currentColor" stroke-linecap="round"></path><path d="M19.5 14L21.5 14" stroke="currentColor" stroke-linecap="round"></path><path d="M17.889 17.8885L19.3032 19.3027" stroke="currentColor" stroke-linecap="round"></path><path d="M14 21.5V19.5" stroke="currentColor" stroke-linecap="round"></path><path d="M8.69663 19.3029L10.1108 17.8887" stroke="currentColor" stroke-linecap="round"></path><path d="M6.5 14L8.5 14" stroke="currentColor" stroke-linecap="round"></path><path d="M8.69663 8.69711L10.1108 10.1113" stroke="currentColor" stroke-linecap="round"></path></svg>
            </button>
            <button
                type="button"
                role="radio"
                data-theme-value="dark"
                aria-label="Dark theme"
                class="theme-opt rounded-full p-1.5 *:size-4.5 sm:p-0"
            >
                <svg viewBox="0 0 28 28" fill="none"><path d="M10.5 9.99914C10.5 14.1413 13.8579 17.4991 18 17.4991C19.0332 17.4991 20.0176 17.2902 20.9132 16.9123C19.7761 19.6075 17.109 21.4991 14 21.4991C9.85786 21.4991 6.5 18.1413 6.5 13.9991C6.5 10.8902 8.39167 8.22304 11.0868 7.08594C10.7089 7.98159 10.5 8.96597 10.5 9.99914Z" stroke="currentColor" stroke-linejoin="round"></path><path d="M16.3561 6.50754L16.5 5.5L16.6439 6.50754C16.7068 6.94752 17.0525 7.29321 17.4925 7.35607L18.5 7.5L17.4925 7.64393C17.0525 7.70679 16.7068 8.05248 16.6439 8.49246L16.5 9.5L16.3561 8.49246C16.2932 8.05248 15.9475 7.70679 15.5075 7.64393L14.5 7.5L15.5075 7.35607C15.9475 7.29321 16.2932 6.94752 16.3561 6.50754Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M20.3561 11.5075L20.5 10.5L20.6439 11.5075C20.7068 11.9475 21.0525 12.2932 21.4925 12.3561L22.5 12.5L21.4925 12.6439C21.0525 12.7068 20.7068 13.0525 20.6439 13.4925L20.5 14.5L20.3561 13.4925C20.2932 13.0525 19.9475 12.7068 19.5075 12.6439L18.5 12.5L19.5075 12.3561C19.9475 12.2932 20.2932 11.9475 20.3561 11.5075Z" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
        </div>

        <p class="text-sm/6 text-gray-600 dark:text-gray-400">
            Copyright &copy; {currentYear} Hafiz Bahtiar
            <span class="mx-1.5 text-gray-400 dark:text-gray-600">&middot;</span>
            Built with Astro + Cloudflare
        </p>
    </div>
</footer>

<style>
    @reference "../../styles/index.css";

    .theme-opt {
        @apply relative z-10 size-7 sm:size-6.5 inline-flex items-center justify-center text-gray-600 transition-colors duration-300 hover:text-gray-950 dark:text-gray-400 dark:hover:text-white;
    }
    .theme-opt[aria-checked="true"] {
        @apply text-gray-950 dark:text-white;
    }

    /* One thumb behind the icons; its slot index comes from whichever
       option is aria-checked, so it glides instead of jumping. Step =
       thumb width + gap-0.5. */
    .theme-thumb {
        @apply absolute top-0.75 left-0.75 size-7 sm:size-6.5 rounded-full bg-white shadow-sm ring-1 ring-gray-950/10 dark:bg-gray-700 dark:ring-transparent;
        --i: 0;
        transform: translateX(calc(var(--i) * (100% + 0.125rem)));
        transition: transform 380ms cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    #theme-switcher:has([data-theme-value="light"][aria-checked="true"]) .theme-thumb {
        --i: 1;
    }
    #theme-switcher:has([data-theme-value="dark"][aria-checked="true"]) .theme-thumb {
        --i: 2;
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-thumb {
            transition: none;
        }
    }
</style>

<script>
    // Theme preference: "system" = no localStorage key (CoreLayout's init
    // script then follows prefers-color-scheme), else "light" / "dark".
    type Pref = "system" | "light" | "dark";

    const readPref = (): Pref => {
        try {
            const v = localStorage.getItem("theme");
            return v === "light" || v === "dark" ? v : "system";
        } catch {
            return "system";
        }
    };

    const isDarkFor = (pref: Pref) =>
        pref === "dark" ||
        (pref === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

    const applyPref = (pref: Pref) => {
        document.documentElement.classList.toggle("dark", isDarkFor(pref));
    };

    // New theme wipes in from the bottom edge up (View Transitions API).
    // Falls back to an instant swap without VT support or with reduced motion.
    const switchTheme = (pref: Pref) => {
        const html = document.documentElement;
        const changes = html.classList.contains("dark") !== isDarkFor(pref);
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!changes || reduced || typeof document.startViewTransition !== "function") {
            applyPref(pref);
            return;
        }
        html.setAttribute("data-theme-switching", "");
        const vt = document.startViewTransition(() => applyPref(pref));
        vt.ready
            .then(() =>
                html.animate(
                    { clipPath: ["inset(100% 0 0 0)", "inset(0 0 0 0)"] },
                    {
                        duration: 650,
                        easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                        pseudoElement: "::view-transition-new(root)",
                    },
                ),
            )
            .catch(() => {});
        vt.finished.finally(() => html.removeAttribute("data-theme-switching"));
    };

    const initThemeSwitcher = () => {
        const root = document.getElementById("theme-switcher");
        if (!root) return;

        const existing = (window as any).__themeSwitcherController;
        if (existing) existing.abort();
        const controller = new AbortController();
        (window as any).__themeSwitcherController = controller;
        const { signal } = controller;

        const buttons =
            root.querySelectorAll<HTMLButtonElement>("[data-theme-value]");
        const sync = () => {
            const pref = readPref();
            buttons.forEach((b) =>
                b.setAttribute(
                    "aria-checked",
                    String(b.dataset.themeValue === pref),
                ),
            );
        };

        buttons.forEach((button) => {
            button.addEventListener(
                "click",
                () => {
                    const pref = button.dataset.themeValue as Pref;
                    try {
                        if (pref === "system") localStorage.removeItem("theme");
                        else localStorage.setItem("theme", pref);
                    } catch {
                        /* storage blocked - still apply for this page */
                    }
                    sync();
                    switchTheme(pref);
                },
                { signal },
            );
        });

        // Follow OS changes while on "system".
        window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener(
                "change",
                () => {
                    if (readPref() === "system") applyPref("system");
                },
                { signal },
            );

        sync();
    };

    initThemeSwitcher();
    document.addEventListener("astro:page-load", initThemeSwitcher);
</script>
