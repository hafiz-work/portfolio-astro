---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";
import type { BlogPostSummary } from "../../types/blog";

interface Props {
  post: BlogPostSummary;
}

const { post } = Astro.props;

const formatDate = (value?: string | null) => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
};

const eyebrow = [
  formatDate(post.publishedDate),
  post.readTimeMinutes > 0 ? `${post.readTimeMinutes} min read` : null,
  post.category,
]
  .filter(Boolean)
  .join(" · ");
---

<div
  class="frame-inner group relative flex h-full flex-col transition-colors hover:outline-gray-950/15 dark:hover:outline-white/20"
>
  <div
    class="relative h-36 overflow-hidden border-b border-gray-950/5 bg-gray-50 sm:h-44 dark:border-white/10 dark:bg-white/5"
  >
    {
      post.coverImageUrl ? (
        <Image
          src={post.coverImageUrl}
          alt=""
          width={640}
          height={352}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="pattern absolute inset-0 flex items-center justify-center">
          <span class="rounded-full bg-canvas px-3 py-1 font-mono text-xs/6 text-gray-500 ring-1 ring-gray-950/10 dark:bg-pub-dark dark:ring-white/10">
            {post.category ?? "note"}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-grow flex-col p-4 sm:p-5">
    {
      eyebrow && (
        <p class="mb-1 font-mono text-[11px]/5 text-gray-500">{eyebrow}</p>
      )
    }
    <div class="mb-2 flex items-start justify-between gap-2">
      <h3
        class="text-base/6 font-semibold tracking-tight text-gray-950 dark:text-white"
      >
        {post.title}
      </h3>
      <ArrowUpRight className="mt-1 h-4 w-4 shrink-0 text-gray-400 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-sky-500 dark:text-gray-500 dark:group-hover:text-sky-400" />
    </div>

    <p
      class="mb-4 line-clamp-2 text-sm/6 text-gray-600 sm:line-clamp-3 dark:text-gray-400"
    >
      {post.excerpt}
    </p>

    <div class="mt-auto flex flex-wrap gap-1.5">
      {post.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
      {
        post.tags.length > 4 && (
          <span class="tag text-gray-400 dark:text-gray-500">
            +{post.tags.length - 4}
          </span>
        )
      }
    </div>

    <a
      href={`/blog/${post.slug}`}
      class="absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"
      aria-label={`Read ${post.title}`}></a>
  </div>
</div>
