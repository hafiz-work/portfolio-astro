---
import type { SolatZone } from "../../data/solat-zones";
/**
 * JAKIM zone picker in the site's select style (.field / .field-trigger / .menu /
 * .menu-item, same as ui/Dropdown) plus what 60 zones need: negeri groups and a
 * search box. Progressive: the native <select name="zone"> is the form value and
 * the no-JS fallback; the script hides it, shows the custom picker, and submits
 * the GET form on pick.
 */
interface Props {
  zones: SolatZone[];
  selected: SolatZone;
}
const { zones, selected } = Astro.props;
const states = [...new Set(zones.map((z) => z.negeri))];
---

<div data-zone-picker class="relative w-full max-w-md">
  <select id="zone" name="zone" class="field">
    {
      states.map((negeri) => (
        <optgroup label={negeri}>
          {zones
            .filter((z) => z.negeri === negeri)
            .map((z) => (
              <option value={z.code} selected={z.code === selected.code}>
                {z.code} - {z.daerah}
              </option>
            ))}
        </optgroup>
      ))
    }
  </select>

  <button
    type="button"
    id="zone-trigger"
    data-trigger
    hidden
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="zone-panel"
    class="field field-trigger"
  >
    <span class="flex min-w-0 items-center gap-2">
      <span class="font-mono text-xs text-gray-500 dark:text-gray-400">{selected.code}</span>
      <span class="truncate">{selected.daerah}</span>
    </span>
    <svg class="size-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
    </svg>
  </button>

  <div id="zone-panel" data-panel hidden class="menu w-full">
    <input
      type="search"
      data-search
      role="combobox"
      aria-label="Cari zon"
      aria-controls="zone-list"
      aria-expanded="true"
      aria-autocomplete="list"
      autocomplete="off"
      placeholder="Cari daerah, negeri atau kod…"
      class="field"
    />
    <ul id="zone-list" role="listbox" aria-label="Zon" class="mt-1 max-h-72 overflow-y-auto scrollbar-thin">
      {
        states.map((negeri) => (
          <li role="presentation" data-group>
            <p
              class="px-2.5 pt-3 pb-1 font-mono text-[11px] tracking-widest text-gray-500 uppercase"
              aria-hidden="true"
            >
              {negeri}
            </p>
            <ul role="group" aria-label={negeri}>
              {zones
                .filter((z) => z.negeri === negeri)
                .map((z) => (
                  <li
                    role="option"
                    id={`zone-opt-${z.code}`}
                    data-value={z.code}
                    data-text={`${z.code} ${z.daerah} ${z.negeri}`.toLowerCase()}
                    aria-selected={z.code === selected.code ? "true" : "false"}
                    class="menu-item cursor-pointer items-start data-active:bg-gray-950/5 data-active:text-gray-950 dark:data-active:bg-white/5 dark:data-active:text-white"
                  >
                    <span class="w-12 shrink-0 font-mono text-xs/6 text-gray-500 dark:text-gray-400">
                      {z.code}
                    </span>
                    <span>{z.daerah}</span>
                  </li>
                ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p data-empty hidden class="px-2.5 py-2 text-sm/6 text-gray-500">Tiada zon sepadan.</p>
  </div>
</div>

<script>
  type Picker = HTMLElement & { closePicker?: (focus?: boolean) => void };

  const initZonePickers = () => {
    document.querySelectorAll<Picker>("[data-zone-picker]").forEach((root) => {
      if (root.dataset.bound === "1") return;
      root.dataset.bound = "1";
      const native = root.querySelector("select")!;
      const trigger = root.querySelector<HTMLButtonElement>("[data-trigger]")!;
      const panel = root.querySelector<HTMLElement>("[data-panel]")!;
      const search = root.querySelector<HTMLInputElement>("[data-search]")!;
      const empty = root.querySelector<HTMLElement>("[data-empty]")!;
      const options = [...root.querySelectorAll<HTMLElement>('[role="option"]')];
      const groups = [...root.querySelectorAll<HTMLElement>("[data-group]")];

      // Enhance: the native select stays as the form value, out of sight.
      native.hidden = true;
      trigger.hidden = false;
      const label = document.querySelector<HTMLLabelElement>(`label[for="${native.id}"]`);
      if (label) label.htmlFor = trigger.id;

      const visible = () => options.filter((o) => !o.hidden);
      const setActive = (el: HTMLElement | undefined) => {
        options.forEach((o) => o.toggleAttribute("data-active", o === el));
        if (el) {
          search.setAttribute("aria-activedescendant", el.id);
          el.scrollIntoView({ block: "nearest" });
        } else search.removeAttribute("aria-activedescendant");
      };
      const filter = () => {
        const q = search.value.trim().toLowerCase();
        options.forEach((o) => (o.hidden = !!q && !o.dataset.text!.includes(q)));
        groups.forEach((g) => (g.hidden = !g.querySelector('[role="option"]:not([hidden])')));
        empty.hidden = visible().length > 0;
        setActive(visible()[0]);
      };
      const open = () => {
        panel.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        search.value = "";
        filter();
        setActive(options.find((o) => o.getAttribute("aria-selected") === "true"));
        search.focus();
      };
      const close = (focus = true) => {
        if (panel.hidden) return;
        panel.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        if (focus) trigger.focus();
      };
      const pick = (o: HTMLElement | undefined) => {
        if (!o) return;
        close();
        if (native.value === o.dataset.value) return;
        native.value = o.dataset.value!;
        native.form?.requestSubmit();
      };
      root.closePicker = close;

      trigger.addEventListener("click", () => (panel.hidden ? open() : close()));
      trigger.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          open();
        }
      });
      search.addEventListener("input", filter);
      search.addEventListener("keydown", (e) => {
        const v = visible();
        const i = v.findIndex((o) => o.hasAttribute("data-active"));
        if (e.key === "ArrowDown") {
          e.preventDefault();
          setActive(v[Math.min(v.length - 1, i + 1)]);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          setActive(v[Math.max(0, i - 1)]);
        } else if (e.key === "Enter") {
          e.preventDefault();
          pick(v[i]);
        } else if (e.key === "Escape") {
          e.preventDefault();
          close();
        } else if (e.key === "Tab") close(false);
      });
      options.forEach((o) => {
        o.addEventListener("click", () => pick(o));
        o.addEventListener("pointermove", () => setActive(o));
      });
    });
  };

  // One outside-click listener for every picker on the page.
  document.addEventListener("pointerdown", (e) => {
    document.querySelectorAll<Picker>("[data-zone-picker]").forEach((root) => {
      if (!root.contains(e.target as Node)) root.closePicker?.(false);
    });
  });

  initZonePickers();
  document.addEventListener("astro:page-load", initZonePickers);
</script>
