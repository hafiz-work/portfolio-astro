# Copy to .env.development (gitignored) and fill in.

# Local API (hono-workers dev server)
PUBLIC_API_URL=http://localhost:8787/api/v1

# Cloudflare Turnstile SITE key (public value, browser-safe).
# The widget must list localhost as an allowed domain in the Turnstile
# dashboard for local dev. Leave unset to disable the captcha locally - the
# backend skips verification when TURNSTILE_SECRET is not configured either.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# MARC backend (separate repo, marc_go) - used ONLY server-side by
# src/pages/verify-email.astro (email verification landing page).
# Sengaja bukan PUBLIC_ - tak pernah masuk browser bundle.
MARC_API_URL=https://marc-go-staging.up.railway.app
