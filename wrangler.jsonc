{
  // SSR → API calls go Worker-to-Worker through this binding (src/lib/public-content.ts).
  // The target Worker must be deployed in the same Cloudflare account.
  "services": [
    {
      "binding": "API",
      "service": "hono-workers"
    }
  ],
  // Cost: log 10% of requests (every request was an event - Workers Logs moves to
  // Observability pricing on 2026-12-01). Traces off. Raise temporarily to debug.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}